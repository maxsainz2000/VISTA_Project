<!-- 
    VISTA Design Tokens — Centralised Formatting Standards (Theme-agnostic)
    Contains format strings and value converters.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:conv="clr-namespace:MerchSys.App.Converters">

    <!-- Formatting Strings (for use in StringFormat binding syntax) -->
    <sys:String x:Key="FormatCurrency">₱{0:N2}</sys:String>
    <sys:String x:Key="FormatCurrencyNoDecimal">₱{0:N0}</sys:String>
    <sys:String x:Key="FormatCurrencySignedPositive">+₱{0:N2}</sys:String>
    <sys:String x:Key="FormatQuantity">{0:N2}</sys:String>
    <sys:String x:Key="FormatQuantityInt">{0:N0}</sys:String>
    <sys:String x:Key="FormatDate">MM/dd/yyyy</sys:String>
    <sys:String x:Key="FormatDateShort">MM/dd/yy</sys:String>
    <sys:String x:Key="FormatDateTime">MM/dd/yyyy HH:mm</sys:String>
    <sys:String x:Key="FormatDateTimeShort">MM/dd/yy HH:mm</sys:String>
    <sys:String x:Key="FormatPercent">{}{0:N1}%</sys:String>
    <sys:String x:Key="FormatPercentSigned">{}{0:+0.0;-0.0;0.0}%</sys:String>

    <!-- Value Converter Instances -->
    <conv:PesoConverter x:Key="PesoConverter"/>
    <conv:PesoNoDecimalConverter x:Key="PesoNoDecimalConverter"/>
    <conv:SignedPesoConverter x:Key="SignedPesoConverter"/>
    <conv:DateFormatter x:Key="DateFormatter"/>
    <conv:DateTimeFormatter x:Key="DateTimeFormatter"/>
    <conv:QuantityConverter x:Key="QuantityConverter"/>

</ResourceDictionary>
