<UserControl x:Class="Views.DeveloperTools.DesignGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:MerchSys.App.Views.Shell"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SwatchLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="68"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GallerySectionGroupStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSubhead}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,40">

            <!-- ══ Header ══════════════════════════════════════════════════════════ -->
            <TextBlock Text="Design System Gallery" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource SubtitleStyle}"
                       Text="Live catalogue of every token, component, and icon. Developer role only."/>
            <TextBlock Margin="0,4,0,24" Style="{StaticResource CaptionLabelStyle}"
                       Text="Toggle Light ↔ Dark (Ctrl+T) to verify theme realization. All swatches pull from live dictionaries — no inline hex."/>

            <!-- separator -->
            <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,32"/>

            <!-- ══ A. Token Catalogue ════════════════════════════════════════════ -->
            <TextBlock Text="A   Token Catalogue" Style="{StaticResource GallerySectionGroupStyle}"/>

            <!-- A1. Color Tokens ─────────────────────────────────────────────── -->
            <TextBlock Text="Color Tokens" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>
            <WrapPanel Margin="0,0,0,28">

                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40" Background="{DynamicResource WindowBackgroundBrush}"
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}"/>
                    <TextBlock Text="WindowBackground&#xA;Brush" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}"/>
                    <TextBlock Text="SurfaceBrush" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40" Background="{DynamicResource SidebarBackgroundBrush}"
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}"/>
                    <TextBlock Text="SidebarBackground&#xA;Brush" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40" Background="{DynamicResource ControlBackgroundBrush}"
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}"/>
                    <TextBlock Text="ControlBackground&#xA;Brush" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40" Background="{DynamicResource TextPrimaryBrush}"
                            CornerRadius="{DynamicResource RadiusSmall}"/>
                    <TextBlock Text="TextPrimaryBrush" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40" Background="{DynamicResource TextSecondaryBrush}"
                            CornerRadius="{DynamicResource RadiusSmall}"/>
                    <TextBlock Text="TextSecondary&#xA;Brush" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40" Background="{DynamicResource TextOnAccentBrush}"
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}"/>
                    <TextBlock Text="TextOnAccentBrush" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40" Background="{DynamicResource AccentBrush}"
                            CornerRadius="{DynamicResource RadiusSmall}"/>
                    <TextBlock Text="AccentBrush" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40" Background="{DynamicResource AccentHoverBrush}"
                            CornerRadius="{DynamicResource RadiusSmall}"/>
                    <TextBlock Text="AccentHoverBrush" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40" Background="{DynamicResource SeparatorBrush}"
                            CornerRadius="{DynamicResource RadiusSmall}"/>
                    <TextBlock Text="SeparatorBrush" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40" Background="{DynamicResource HoverBackgroundBrush}"
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}"/>
                    <TextBlock Text="HoverBackground&#xA;Brush (low α)" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40" Background="{DynamicResource SelectionBackgroundBrush}"
                            CornerRadius="{DynamicResource RadiusSmall}"/>
                    <TextBlock Text="SelectionBackground&#xA;Brush" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40" Background="{DynamicResource SelectionForegroundBrush}"
                            CornerRadius="{DynamicResource RadiusSmall}"/>
                    <TextBlock Text="SelectionForeground&#xA;Brush" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40" Background="{DynamicResource DangerBrush}"
                            CornerRadius="{DynamicResource RadiusSmall}"/>
                    <TextBlock Text="DangerBrush" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40" Background="{DynamicResource WarningBrush}"
                            CornerRadius="{DynamicResource RadiusSmall}"/>
                    <TextBlock Text="WarningBrush" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40" Background="{DynamicResource SuccessBrush}"
                            CornerRadius="{DynamicResource RadiusSmall}"/>
                    <TextBlock Text="SuccessBrush" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40" Background="{DynamicResource SkeletonBaseBrush}"
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}"/>
                    <TextBlock Text="SkeletonBaseBrush" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

                <!-- Raw Color tokens (consumed by effects/animations, not exposed as brushes).
                     Wrapped in a live SolidColorBrush so the swatch recolors with the theme — no inline hex. -->
                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40"
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource ShadowColor}"/>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="ShadowColor&#xA;(Color · CardShadow)" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,12" HorizontalAlignment="Center">
                    <Border Width="68" Height="40"
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource SkeletonShimmerHighlightColor}"/>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="SkeletonShimmer&#xA;HighlightColor (Color)" Style="{StaticResource SwatchLabelStyle}"/>
                </StackPanel>

            </WrapPanel>

            <!-- A2. Type Scale ───────────────────────────────────────────────── -->
            <TextBlock Text="Type Scale" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource CardStyle}" Padding="{DynamicResource SpacingXL}" Margin="0,0,0,28">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Bottom">
                        <TextBlock Text="LargeTitle" Width="90" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Bottom"/>
                        <TextBlock FontSize="{DynamicResource FontSizeLargeTitle}"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Villon Farm Supply — 28 px"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Bottom">
                        <TextBlock Text="Title" Width="90" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Bottom"/>
                        <TextBlock FontSize="{DynamicResource FontSizeTitle}"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Villon Farm Supply — 20 px"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Bottom">
                        <TextBlock Text="Subhead" Width="90" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Bottom"/>
                        <TextBlock FontSize="{DynamicResource FontSizeSubhead}"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Villon Farm Supply — 15 px"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Bottom">
                        <TextBlock Text="Body" Width="90" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Bottom"/>
                        <TextBlock FontSize="{DynamicResource FontSizeBody}"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="Villon Farm Supply — 13 px"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="Caption" Width="90" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Bottom"/>
                        <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Villon Farm Supply — 11 px"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- A3. Spacing ──────────────────────────────────────────────────── -->
            <TextBlock Text="Spacing" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource CardStyle}" Padding="{DynamicResource SpacingXL}" HorizontalAlignment="Left" Margin="0,0,0,28">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                        <TextBlock Text="SpacingXS  4 px" Width="160" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Center"/>
                        <Border Width="4" Height="14" Background="{DynamicResource AccentBrush}" CornerRadius="1"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                        <TextBlock Text="SpacingS   8 px" Width="160" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Center"/>
                        <Border Width="8" Height="14" Background="{DynamicResource AccentBrush}" CornerRadius="1"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                        <TextBlock Text="SpacingM  12 px" Width="160" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Center"/>
                        <Border Width="12" Height="14" Background="{DynamicResource AccentBrush}" CornerRadius="1"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                        <TextBlock Text="SpacingL  16 px" Width="160" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Center"/>
                        <Border Width="16" Height="14" Background="{DynamicResource AccentBrush}" CornerRadius="1"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SpacingXL  24 px" Width="160" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Center"/>
                        <Border Width="24" Height="14" Background="{DynamicResource AccentBrush}" CornerRadius="1"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- A4. Corner Radii ─────────────────────────────────────────────── -->
            <TextBlock Text="Corner Radii" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>
            <WrapPanel Margin="0,0,0,28">
                <StackPanel Margin="0,0,20,0" HorizontalAlignment="Center">
                    <Border Width="80" Height="44" Background="{DynamicResource AccentBrush}"
                            CornerRadius="{DynamicResource RadiusSmall}"/>
                    <TextBlock Text="RadiusSmall (6)" Style="{StaticResource SwatchLabelStyle}" MaxWidth="100"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,0" HorizontalAlignment="Center">
                    <Border Width="80" Height="44" Background="{DynamicResource AccentBrush}"
                            CornerRadius="{DynamicResource RadiusMedium}"/>
                    <TextBlock Text="RadiusMedium (10)" Style="{StaticResource SwatchLabelStyle}" MaxWidth="100"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="80" Height="44" Background="{DynamicResource AccentBrush}"
                            CornerRadius="{DynamicResource RadiusLarge}"/>
                    <TextBlock Text="RadiusLarge (14)" Style="{StaticResource SwatchLabelStyle}" MaxWidth="100"/>
                </StackPanel>
            </WrapPanel>

            <!-- A5. Motion Tokens ────────────────────────────────────────────── -->
            <TextBlock Text="Motion Tokens" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource CardStyle}" Padding="{DynamicResource SpacingL}" HorizontalAlignment="Left" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}"
                               Text="MotionEnabled — Boolean · gates all Storyboards; auto-disabled when OS reduces motion"/>
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,4,0,0"
                               Text="MotionDurationFast — 150 ms (hover, button press)"/>
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,4,0,0"
                               Text="MotionDurationStd — 220 ms (view fade/slide)"/>
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,4,0,0"
                               Text="MotionEasing — CubicEase EaseOut"/>
                </StackPanel>
            </Border>

            <!-- separator -->
            <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,32,0,32"/>

            <!-- ══ B. Component Catalogue ════════════════════════════════════════ -->
            <TextBlock Text="B   Component Catalogue" Style="{StaticResource GallerySectionGroupStyle}"/>
            <TextBlock Margin="0,0,0,24" Style="{StaticResource CaptionLabelStyle}"
                       Text="Each shared component shown in its states. All previews are display-only — no real commands fire."/>

            <!-- B1. Button Variants ──────────────────────────────────────────── -->
            <TextBlock Text="Buttons  ·  Components.xaml" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>
            <WrapPanel Margin="0,0,0,28">
                <Button Content="Primary"   Style="{StaticResource PrimaryButtonStyle}"   Margin="0,0,8,8"/>
                <Button Content="Danger"    Style="{StaticResource DangerButtonStyle}"    Margin="0,0,8,8"/>
                <Button Content="Warning"   Style="{StaticResource WarningButtonStyle}"   Margin="0,0,8,8"/>
                <Button Content="Success"   Style="{StaticResource SuccessButtonStyle}"   Margin="0,0,8,8"/>
                <Button Content="Secondary" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
                <Button Content="Subtle"    Style="{StaticResource SubtleButtonStyle}"    Margin="0,0,8,8"/>
                <Button Content="Disabled"  IsEnabled="False"                             Margin="0,0,8,8"/>
            </WrapPanel>

            <!-- B2. BusyOverlay ─────────────────────────────────────────────── -->
            <TextBlock Text="BusyOverlay  ·  Views/Shell/BusyOverlay.xaml" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>
            <TextBlock Margin="0,0,0,8" Style="{StaticResource CaptionLabelStyle}"
                       Text="IsBusy=True; Visibility overridden to Visible via local value so the control renders in the gallery."/>
            <Border Width="240" Height="88" HorizontalAlignment="Left"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}" ClipToBounds="True"
                    Background="{DynamicResource SurfaceBrush}" Margin="0,0,0,28">
                <shell:BusyOverlay Visibility="Visible" IsBusy="True" Message="Loading products…"/>
            </Border>

            <!-- B3. EmptyStatePanel ─────────────────────────────────────────── -->
            <TextBlock Text="EmptyStatePanel  ·  Views/Shell/EmptyStatePanel.xaml" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>
            <Border HorizontalAlignment="Left" Width="360"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}" Margin="0,0,0,28">
                <shell:EmptyStatePanel Title="No Products Found"
                                       Description="Add your first product to begin tracking inventory and stock levels."/>
            </Border>

            <!-- B4. ErrorStatePanel ─────────────────────────────────────────── -->
            <TextBlock Text="ErrorStatePanel  ·  Views/Shell/ErrorStatePanel.xaml" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>
            <Border HorizontalAlignment="Left" Width="360"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}" Margin="0,0,0,28">
                <shell:ErrorStatePanel Title="Connection Lost"
                                       Message="Cannot reach the database. Check your network connection and try again."/>
            </Border>

            <!-- B5. DeltaIndicator States ───────────────────────────────────── -->
            <TextBlock Text="DeltaIndicator  ·  Views/Shell/DeltaIndicator.xaml" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>
            <TextBlock Margin="0,0,0,12" Style="{StaticResource CaptionLabelStyle}"
                       Text="Direction auto-derived from Percent: positive → Up (SuccessBrush), negative → Down (DangerBrush), zero → Flat (TextSecondaryBrush)."/>
            <WrapPanel Margin="0,0,0,28">
                <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Up  (Percent = +12.5)" Style="{StaticResource CaptionLabelStyle}" Margin="0,0,0,6"/>
                        <shell:DeltaIndicator Percent="12.5"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Down  (Percent = −8.3)" Style="{StaticResource CaptionLabelStyle}" Margin="0,0,0,6"/>
                        <shell:DeltaIndicator Percent="-8.3"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Flat  (Percent = 0)" Style="{StaticResource CaptionLabelStyle}" Margin="0,0,0,6"/>
                        <shell:DeltaIndicator Percent="0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- B6. Sparkline ───────────────────────────────────────────────── -->
            <TextBlock Text="Sparkline  ·  Views/Shell/Sparkline.xaml" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource CardStyle}" Padding="16,12" HorizontalAlignment="Left" Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock Text="Revenue trend — 7 sample points" Style="{StaticResource CaptionLabelStyle}" Margin="0,0,0,8"/>
                    <shell:Sparkline Height="48" Width="120">
                        <shell:Sparkline.Points>
                            <x:Array Type="{x:Type sys:Double}">
                                <sys:Double>10</sys:Double>
                                <sys:Double>25</sys:Double>
                                <sys:Double>18</sys:Double>
                                <sys:Double>42</sys:Double>
                                <sys:Double>30</sys:Double>
                                <sys:Double>55</sys:Double>
                                <sys:Double>38</sys:Double>
                            </x:Array>
                        </shell:Sparkline.Points>
                    </shell:Sparkline>
                </StackPanel>
            </Border>

            <!-- B7. Card styles ─────────────────────────────────────────────── -->
            <TextBlock Text="Card Styles  ·  Components.xaml" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>
            <WrapPanel Margin="0,0,0,28">
                <Border Style="{StaticResource CardStyle}" Padding="{DynamicResource SpacingL}"
                        Margin="0,0,16,0" Width="210">
                    <StackPanel>
                        <TextBlock Text="CardStyle" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="SurfaceBrush bg · SeparatorBrush border 1 px · RadiusMedium · CardShadow"
                                   Style="{StaticResource CaptionLabelStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AlertCardStyle}" Width="210">
                    <StackPanel>
                        <TextBlock Text="AlertCardStyle" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="SidebarBackground bg · AccentBrush 3 px left rule · RadiusSmall"
                                   Style="{StaticResource CaptionLabelStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- B8. Segment Toggle ──────────────────────────────────────────── -->
            <TextBlock Text="Segment Toggle  ·  Components.xaml — SegmentToggleStyle" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>
            <Border Background="{DynamicResource SidebarBackgroundBrush}"
                    CornerRadius="{DynamicResource RadiusSmall}"
                    Padding="4" HorizontalAlignment="Left" Margin="0,0,0,28">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Content="Monthly"   Style="{StaticResource SegmentToggleStyle}" IsChecked="True" Margin="0,0,2,0"/>
                    <ToggleButton Content="Quarterly" Style="{StaticResource SegmentToggleStyle}" Margin="0,0,2,0"/>
                    <ToggleButton Content="Annual"    Style="{StaticResource SegmentToggleStyle}"/>
                </StackPanel>
            </Border>

            <!-- B9. Field Row ───────────────────────────────────────────────── -->
            <TextBlock Text="Field Row  ·  Components.xaml — FieldRowStyle" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource CardStyle}" Padding="{DynamicResource SpacingXL}"
                    HorizontalAlignment="Left" Width="380" Margin="0,0,0,28">
                <StackPanel>
                    <HeaderedContentControl Style="{StaticResource FieldRowStyle}" Header="Product Name">
                        <TextBox Text="Fertilizer 50 kg" IsReadOnly="True" Width="240" HorizontalAlignment="Left"/>
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource FieldRowStyle}" Header="Unit Price" Margin="0,8,0,0">
                        <TextBox Text="₱ 1,250.00" IsReadOnly="True" Width="240" HorizontalAlignment="Left"/>
                    </HeaderedContentControl>
                </StackPanel>
            </Border>

            <!-- B10. Confirmation Dialog Preview ───────────────────────────── -->
            <TextBlock Text="Confirmation Dialog  ·  Views/Shell/ConfirmationDialog.xaml — Static preview" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>
            <TextBlock Margin="0,0,0,12" Style="{StaticResource CaptionLabelStyle}"
                       Text="Layout preview only — buttons disabled. Real dialog fires through IConfirmationPresenter; it must not fire real commands."/>
            <Border Style="{StaticResource CardStyle}" Padding="{DynamicResource SpacingXL}"
                    HorizontalAlignment="Left" Width="380" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Path Style="{StaticResource IconBase}" Width="20" Height="20"
                              Data="{StaticResource IconWarningGeometry}"
                              Fill="{DynamicResource DangerBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Delete Product" FontSize="{DynamicResource FontSizeSubhead}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="This will permanently remove the product and all associated stock batches. This action cannot be undone."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" IsEnabled="False"/>
                        <Button Content="Delete"  Style="{StaticResource DangerButtonStyle}"    IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- separator -->
            <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,32,0,32"/>

            <!-- ══ C. Icon Set ════════════════════════════════════════════════ -->
            <TextBlock Text="C   Icon Set" Style="{StaticResource GallerySectionGroupStyle}"/>
            <TextBlock Text="Icons  ·  Themes/Icons.xaml — hand-drawn monoline, 24×24 viewbox" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>
            <TextBlock Margin="0,0,0,16" Style="{StaticResource CaptionLabelStyle}"
                       Text="All icons use IconBase style (16×16, Fill=TextPrimaryBrush). Toggle theme to verify DynamicResource live recolor."/>
            <WrapPanel>

                <StackPanel Margin="0,0,16,16" Width="64">
                    <Path Style="{StaticResource IconBase}" Width="24" Height="24" HorizontalAlignment="Center"
                          Data="{StaticResource IconRefreshGeometry}"/>
                    <TextBlock Text="Refresh" Style="{StaticResource SwatchLabelStyle}" MaxWidth="64"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,16" Width="64">
                    <Path Style="{StaticResource IconBase}" Width="24" Height="24" HorizontalAlignment="Center"
                          Data="{StaticResource IconBoltGeometry}"/>
                    <TextBlock Text="Bolt" Style="{StaticResource SwatchLabelStyle}" MaxWidth="64"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,16" Width="64">
