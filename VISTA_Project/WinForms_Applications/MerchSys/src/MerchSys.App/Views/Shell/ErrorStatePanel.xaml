<UserControl x:Class="Views.Shell.ErrorStatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="32">
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                Padding="32,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="360">
            <StackPanel HorizontalAlignment="Center">
                <!-- Warning icon in danger accent -->
                <Path Style="{StaticResource IconBase}" Data="{StaticResource IconWarningGeometry}"
                      Width="48" Height="48" Fill="{DynamicResource DangerBrush}"
                      HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <!-- Headline -->
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <!-- Detail message -->
                <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="280" Margin="0,0,0,20"/>
                <!-- Retry button -->
                <Button Content="Retry"
                        Command="{Binding RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
