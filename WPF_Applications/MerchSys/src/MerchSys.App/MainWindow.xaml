<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VISTA - Villon Integrated Supply and Trade Application"
        Height="768" Width="1280"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Navigation sidebar -->
            <ColumnDefinition Width="200" />
            <!-- Main content area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="VISTA" Foreground="White" FontSize="20"
                           FontWeight="Bold" HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <!-- Navigation items — populated by module plans -->
                <Button Content="Point of Sale" Height="44" Margin="8,2"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" HorizontalContentAlignment="Left"
                        Padding="16,0"/>
                <Button Content="Inventory" Height="44" Margin="8,2"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" HorizontalContentAlignment="Left"
                        Padding="16,0"/>
                <Button Content="Purchasing" Height="44" Margin="8,2"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" HorizontalContentAlignment="Left"
                        Padding="16,0"/>
                <Button Content="Accounting" Height="44" Margin="8,2"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" HorizontalContentAlignment="Left"
                        Padding="16,0"/>
            </StackPanel>
        </Border>

        <!-- Content frame — module views are loaded here by subsequent plans -->
        <Border Grid.Column="1" Background="#F5F6FA">
            <TextBlock Text="Select a module from the sidebar."
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="#95A5A6"
                       FontSize="16"/>
        </Border>
    </Grid>
</Window>
