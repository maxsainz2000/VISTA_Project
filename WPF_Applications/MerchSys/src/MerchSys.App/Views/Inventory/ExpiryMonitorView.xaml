<UserControl x:Class="Views.Inventory.ExpiryMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
        </Style>

        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WriteOffButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Row style for near-expiry tab: color by UrgencyLevel -->
        <Style x:Key="NearExpiryRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UrgencyLevel}" Value="Red">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding UrgencyLevel}" Value="Orange">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding UrgencyLevel}" Value="Yellow">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Row style for expired tab: always red -->
        <Style x:Key="ExpiredRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>

        <Style x:Key="RightAlignCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,4,0"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="10">

        <!-- ═══════════════════════════════════════════════════════════
             SUMMARY CARDS ROW
             ═══════════════════════════════════════════════════════════ -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="{Binding NearExpiryCount}" Style="{StaticResource CardValue}" Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock Text="Near-Expiry Batches" Style="{StaticResource CardLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="{Binding ExpiredCount}" Style="{StaticResource CardValue}" Foreground="{DynamicResource DangerBrush}"/>
                    <TextBlock Text="Expired Batches" Style="{StaticResource CardLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SummaryCard}" Margin="0">
                <StackPanel>
                    <TextBlock Text="{Binding TotalValueAtRisk, StringFormat='₱{0:N2}'}"
                               FontSize="20" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                    <TextBlock Text="Total Value at Risk" Style="{StaticResource CardLabel}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             TOOLBAR
             ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusSmall}" Padding="12,8" Margin="0,0,0,6"
                Effect="{DynamicResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Threshold spinner -->
                <TextBlock Grid.Column="0" Text="Near-expiry threshold:" Style="{StaticResource FilterLabel}"/>
                <Border Grid.Column="1" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,4,0">
                    <Grid Width="78">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 x:Name="ThresholdBox"
                                 Text="{Binding DaysThreshold, UpdateSourceTrigger=LostFocus}"
                                 BorderThickness="0" Padding="6,3"
                                 VerticalContentAlignment="Center"
                                 PreviewTextInput="ThresholdBox_PreviewTextInput"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Stretch">
                            <RepeatButton Content="▲" FontSize="8" BorderThickness="0"
                                          Background="Transparent" Padding="0"
                                          Height="12"
                                          Click="ThresholdUp_Click"/>
                            <RepeatButton Content="▼" FontSize="8" BorderThickness="0"
                                          Background="Transparent" Padding="0"
                                          Height="12"
                                          Click="ThresholdDown_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Grid.Column="2" Text="days" Style="{StaticResource FilterLabel}" Margin="0,0,12,0"/>

                <!-- Status message -->
                <TextBlock Grid.Column="3"
                           Text="{Binding StatusMessage}"
                           FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="4"
                           Text="{Binding LastRefreshed}"
                           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>

                <TextBlock Grid.Column="5"
                           Text="Loading…"
                           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                <Button Grid.Column="6"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ActionButton}"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             TAB CONTROL
             ═══════════════════════════════════════════════════════════ -->
        <TabControl Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" Padding="0">

            <!-- ── Near-Expiry Tab ─────────────────────────────────── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Near-Expiry (" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding NearExpiryCount}" FontWeight="SemiBold"/>
                        <TextBlock Text=")" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>

                <DockPanel Margin="8">
                    <!-- Color legend -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,6">
                        <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" Margin="0,0,3,0" CornerRadius="2"/>
                        <TextBlock Text="≤ 7 days" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" Margin="0,0,3,0" CornerRadius="2"/>
                        <TextBlock Text="8 – 14 days" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" Margin="0,0,3,0" CornerRadius="2"/>
                        <TextBlock Text="15 – 30 days" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding NearExpiryBatches}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" CanUserReorderColumns="False" CanUserResizeRows="False"
                              SelectionUnit="FullRow" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowStyle="{StaticResource NearExpiryRowStyle}"
                              CanUserSortColumns="True"
                              FontSize="12">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Product" Width="*" MinWidth="160"
                                               Binding="{Binding ProductName}"/>

                            <DataGridTextColumn Header="Batch #" Width="68"
                                               Binding="{Binding BatchId}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Qty Remaining" Width="100"
                                               SortMemberPath="QtyRemaining"
                                               Binding="{Binding QtyRemaining}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Unit Cost" Width="90"
                                               SortMemberPath="UnitCost"
                                               Binding="{Binding UnitCost, StringFormat='₱{0:N2}'}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Value" Width="95"
                                               SortMemberPath="Value"
                                               Binding="{Binding Value, StringFormat='₱{0:N2}'}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Expiry Date" Width="100"
                                               SortMemberPath="ExpiryDate"
                                               Binding="{Binding ExpiryDate, StringFormat='MM/dd/yyyy'}"/>

                            <DataGridTemplateColumn Header="Days Remaining" Width="105"
                                                   SortMemberPath="DaysRemaining" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DaysRemaining}" HorizontalAlignment="Center"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UrgencyLevel}" Value="Red">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UrgencyLevel}" Value="Orange">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ── Expired Tab ─────────────────────────────────────── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Expired (" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ExpiredCount}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text=")" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>

                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top"
                               Text="These batches are past their expiry date. Use Write Off to zero the quantity and record a shrinkage loss."
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,6"/>

                    <DataGrid ItemsSource="{Binding ExpiredBatches}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                              SelectionUnit="FullRow" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowStyle="{StaticResource ExpiredRowStyle}"
                              CanUserSortColumns="True"
                              FontSize="12">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Product" Width="*" MinWidth="160"
                                               IsReadOnly="True"
                                               Binding="{Binding ProductName}"/>

                            <DataGridTextColumn Header="Batch #" Width="68"
                                               IsReadOnly="True"
                                               Binding="{Binding BatchId}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Qty Remaining" Width="100"
                                               IsReadOnly="True"
                                               SortMemberPath="QtyRemaining"
                                               Binding="{Binding QtyRemaining}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Unit Cost" Width="90"
                                               IsReadOnly="True"
                                               SortMemberPath="UnitCost"
                                               Binding="{Binding UnitCost, StringFormat='₱{0:N2}'}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Value" Width="95"
                                               IsReadOnly="True"
                                               SortMemberPath="Value"
                                               Binding="{Binding Value, StringFormat='₱{0:N2}'}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Expiry Date" Width="100"
                                               IsReadOnly="True"
                                               SortMemberPath="ExpiryDate"
                                               Binding="{Binding ExpiryDate, StringFormat='MM/dd/yyyy'}"/>

                            <DataGridTextColumn Header="Days Overdue" Width="100"
                                               IsReadOnly="True"
                                               SortMemberPath="DaysRemaining"
                                               Binding="{Binding DaysRemaining}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Action" Width="90" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Write Off"
                                                Tag="{Binding}"
                                                Style="{StaticResource WriteOffButton}"
                                                Margin="4,2"
                                                Click="WriteOffButton_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

        </TabControl>

    </DockPanel>

</UserControl>
