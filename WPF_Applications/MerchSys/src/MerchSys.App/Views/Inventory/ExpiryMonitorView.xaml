<UserControl x:Class="Views.Inventory.ExpiryMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MerchSys.App.Views.Shell"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="WriteOffButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Row style for near-expiry tab: color by UrgencyLevel -->
        <Style x:Key="NearExpiryRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource SemanticRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UrgencyLevel}" Value="Red">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding UrgencyLevel}" Value="Orange">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding UrgencyLevel}" Value="Yellow">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Row style for expired tab: always red -->
        <Style x:Key="ExpiredRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource SemanticRowStyle}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <DockPanel Margin="10">

        <!-- ═══════════════════════════════════════════════════════════
             SUMMARY CARDS ROW
             ═══════════════════════════════════════════════════════════ -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/> <!-- Hero (Total Value at Risk) -->
                <ColumnDefinition Width="*"/>     <!-- Near-Expiry Batches -->
                <ColumnDefinition Width="*"/>     <!-- Expired Batches -->
            </Grid.ColumnDefinitions>

            <!-- Hero: Total Value at Risk -->
            <Border Grid.Column="0" Style="{StaticResource PrimaryMetricCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding TotalValueAtRisk, StringFormat='₱{0:N2}'}"
                               Style="{StaticResource PrimaryMetricValueStyle}" Foreground="{DynamicResource DangerBrush}"/>
                    <TextBlock Text="Total Value at Risk" Style="{StaticResource CaptionLabelStyle}"/>
                </StackPanel>
            </Border>

            <!-- Near-Expiry Batches -->
            <Border Grid.Column="1" Style="{StaticResource SecondaryMetricCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding NearExpiryCount}" Style="{StaticResource SecondaryMetricValueStyle}" Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock Text="Near-Expiry Batches" Style="{StaticResource CaptionLabelStyle}"/>
                </StackPanel>
            </Border>

            <!-- Expired Batches -->
            <Border Grid.Column="2" Style="{StaticResource SecondaryMetricCardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="{Binding ExpiredCount}" Style="{StaticResource SecondaryMetricValueStyle}" Foreground="{DynamicResource DangerBrush}"/>
                    <TextBlock Text="Expired Batches" Style="{StaticResource CaptionLabelStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             TOOLBAR
             ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource FilterBarStyle}" Margin="0,0,0,6" Effect="{DynamicResource CardShadow}">
            <WrapPanel Orientation="Horizontal">
                <!-- Threshold spinner -->
                <StackPanel Style="{StaticResource FilterBarItemStyle}" Orientation="Horizontal">
                    <TextBlock Text="Near-expiry threshold:" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0">
                        <Grid Width="78">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="ThresholdBox"
                                     Text="{Binding DaysThreshold, UpdateSourceTrigger=LostFocus}"
                                     BorderThickness="0" Padding="6,3"
                                     VerticalContentAlignment="Center"
                                     PreviewTextInput="ThresholdBox_PreviewTextInput"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Stretch">
                                <RepeatButton Content="▲" FontSize="8" BorderThickness="0"
                                              Background="Transparent" Padding="0"
                                              Height="12"
                                              Click="ThresholdUp_Click"/>
                                <RepeatButton Content="▼" FontSize="8" BorderThickness="0"
                                              Background="Transparent" Padding="0"
                                              Height="12"
                                              Click="ThresholdDown_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="days" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Center"/>
                </StackPanel>
 
                <!-- Refresh Button -->
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        VerticalAlignment="Center" Margin="0,0,12,4"/>

                <!-- Last Refreshed -->
                <TextBlock Text="{Binding LastRefreshed}"
                           Style="{StaticResource CaptionLabelStyle}"
                           VerticalAlignment="Center" Margin="0,0,12,4"/>
 
                <!-- Loading indicator -->
                <TextBlock Text="Loading…"
                           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,4"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                <!-- Status message -->
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,12,4"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </WrapPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             TAB CONTROL
             ═══════════════════════════════════════════════════════════ -->
        <TabControl Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" Padding="0">

            <!-- ── Near-Expiry Tab ─────────────────────────────────── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Near-Expiry (" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding NearExpiryCount}" FontWeight="SemiBold"/>
                        <TextBlock Text=")" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>

                <DockPanel Margin="8">
                    <!-- Color legend -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,6">
                        <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" Margin="0,0,3,0" CornerRadius="2"/>
                        <TextBlock Text="≤ 7 days" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" Margin="0,0,3,0" CornerRadius="2"/>
                        <TextBlock Text="8 – 14 days" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" Margin="0,0,3,0" CornerRadius="2"/>
                        <TextBlock Text="15 – 30 days" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <DataGrid ItemsSource="{Binding NearExpiryBatches}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" CanUserReorderColumns="False" CanUserResizeRows="False"
                              SelectionUnit="FullRow" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowStyle="{StaticResource NearExpiryRowStyle}"
                              CanUserSortColumns="True"
                              FontSize="12">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Product" Width="*" MinWidth="160"
                                               Binding="{Binding ProductName}"/>

                            <DataGridTextColumn Header="Batch #" Width="68"
                                               Binding="{Binding BatchId}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Qty Remaining" Width="100"
                                               SortMemberPath="QtyRemaining"
                                               Binding="{Binding QtyRemaining}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Unit Cost" Width="90"
                                               SortMemberPath="UnitCost"
                                               Binding="{Binding UnitCost, StringFormat='₱{0:N2}'}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Value" Width="95"
                                               SortMemberPath="Value"
                                               Binding="{Binding Value, StringFormat='₱{0:N2}'}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Expiry Date" Width="100"
                                               SortMemberPath="ExpiryDate"
                                               Binding="{Binding ExpiryDate, StringFormat='MM/dd/yyyy'}"/>

                            <DataGridTemplateColumn Header="Days Remaining" Width="105"
                                                   SortMemberPath="DaysRemaining" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DaysRemaining}" HorizontalAlignment="Center"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UrgencyLevel}" Value="Red">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UrgencyLevel}" Value="Orange">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                    <views:EmptyStatePanel Title="No near-expiry batches"
                                           Description="There are no batches expiring within the specified threshold."
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                        <views:EmptyStatePanel.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NearExpiryBatches.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:EmptyStatePanel.Style>
                    </views:EmptyStatePanel>
                </Grid>
            </DockPanel>
            </TabItem>

            <!-- ── Expired Tab ─────────────────────────────────────── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Expired (" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ExpiredCount}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text=")" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>

                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top"
                               Text="These batches are past their expiry date. Use Write Off to zero the quantity and record a shrinkage loss."
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,6"/>

                    <Grid>
                        <DataGrid ItemsSource="{Binding ExpiredBatches}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                              SelectionUnit="FullRow" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowStyle="{StaticResource ExpiredRowStyle}"
                              CanUserSortColumns="True"
                              FontSize="12">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Product" Width="*" MinWidth="160"
                                               IsReadOnly="True"
                                               Binding="{Binding ProductName}"/>

                            <DataGridTextColumn Header="Batch #" Width="68"
                                               IsReadOnly="True"
                                               Binding="{Binding BatchId}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Qty Remaining" Width="100"
                                               IsReadOnly="True"
                                               SortMemberPath="QtyRemaining"
                                               Binding="{Binding QtyRemaining}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Unit Cost" Width="90"
                                               IsReadOnly="True"
                                               SortMemberPath="UnitCost"
                                               Binding="{Binding UnitCost, StringFormat='₱{0:N2}'}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Value" Width="95"
                                               IsReadOnly="True"
                                               SortMemberPath="Value"
                                               Binding="{Binding Value, StringFormat='₱{0:N2}'}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Expiry Date" Width="100"
                                               IsReadOnly="True"
                                               SortMemberPath="ExpiryDate"
                                               Binding="{Binding ExpiryDate, StringFormat='MM/dd/yyyy'}"/>

                            <DataGridTextColumn Header="Days Overdue" Width="100"
                                               IsReadOnly="True"
                                               SortMemberPath="DaysRemaining"
                                               Binding="{Binding DaysRemaining}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Action" Width="90" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Write Off"
                                                Tag="{Binding}"
                                                Style="{StaticResource WriteOffButton}"
                                                Margin="4,2"
                                                Click="WriteOffButton_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                    <views:EmptyStatePanel Title="No expired batches"
                                           Description="There are no expired product batches in inventory."
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                        <views:EmptyStatePanel.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExpiredBatches.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:EmptyStatePanel.Style>
                    </views:EmptyStatePanel>
                </Grid>
            </DockPanel>
        </TabItem>

    </TabControl>

</DockPanel>
<views:BusyOverlay Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
</Grid>
</UserControl>
