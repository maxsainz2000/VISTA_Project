<UserControl x:Class="Views.Inventory.StockDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MerchSys.App.Views.Shell"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- DataGrid row coloring using themed foreground triggers -->
        <Style x:Key="StockRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource SemanticRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ExpiryStatus}" Value="NearExpiry">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ExpiryStatus}" Value="HasExpired">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StockStatus}" Value="Low">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StockStatus}" Value="Out">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBadge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <DockPanel Margin="10">

            <!-- ═══════════════════════════════════════════════════════════
                 SUMMARY CARDS ROW
                 ═══════════════════════════════════════════════════════════ -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/> <!-- Hero (Critical Stockout Risk) -->
                    <ColumnDefinition Width="*"/>     <!-- Total Products -->
                    <ColumnDefinition Width="*"/>     <!-- Total Stock Value -->
                    <ColumnDefinition Width="*"/>     <!-- Low / Out of Stock -->
                    <ColumnDefinition Width="*"/>     <!-- Near-Expiry Batches -->
                </Grid.ColumnDefinitions>

                <!-- Hero: Critical Stockout Risk -->
                <Border Grid.Column="0" Style="{StaticResource PrimaryMetricCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding CriticalStockoutCount}" Style="{StaticResource PrimaryMetricValueStyle}" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="Critical Stockout Risk" Style="{StaticResource CaptionLabelStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Total Products -->
                <Border Grid.Column="1" Style="{StaticResource SecondaryMetricCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalProducts}" Style="{StaticResource SecondaryMetricValueStyle}" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Total Products" Style="{StaticResource CaptionLabelStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Total Stock Value -->
                <Border Grid.Column="2" Style="{StaticResource SecondaryMetricCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalStockValue, StringFormat={StaticResource FormatCurrency}}"
                                   Style="{StaticResource SecondaryMetricValueStyle}" Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="Total Stock Value" Style="{StaticResource CaptionLabelStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Low / Out of Stock -->
                <Border Grid.Column="3" Style="{StaticResource SecondaryMetricCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding LowStockCount}" Style="{StaticResource SecondaryMetricValueStyle}" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="Low / Out of Stock" Style="{StaticResource CaptionLabelStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Near-Expiry Batches -->
                <Border Grid.Column="4" Style="{StaticResource SecondaryMetricCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{Binding NearExpiryCount}" Style="{StaticResource SecondaryMetricValueStyle}" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="Near-Expiry Batches" Style="{StaticResource CaptionLabelStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════
                 FILTER / TOOLBAR ROW
                 ═══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Style="{StaticResource FilterBarStyle}" Margin="0,0,0,6" Effect="{DynamicResource CardShadow}">
                <WrapPanel Orientation="Horizontal">
                    <!-- Category -->
                    <StackPanel Style="{StaticResource FilterBarItemStyle}" Orientation="Horizontal">
                        <TextBlock Text="Category:" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Width="140"
                                  Padding="6,4" VerticalContentAlignment="Center"
                                  BorderBrush="{DynamicResource SeparatorBrush}"/>
                    </StackPanel>

                    <!-- Status -->
                    <StackPanel Style="{StaticResource FilterBarItemStyle}" Orientation="Horizontal">
                        <TextBlock Text="Status:" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding SelectedStatus}"
                                  Width="120"
                                  Padding="6,4" VerticalContentAlignment="Center"
                                  BorderBrush="{DynamicResource SeparatorBrush}"/>
                    </StackPanel>

                    <!-- Search -->
                    <StackPanel Style="{StaticResource FilterBarItemStyle}" Orientation="Horizontal">
                        <TextBlock Text="Search:" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200"
                                 Padding="6,4" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 x:Name="SearchBox"/>
                    </StackPanel>

                    <!-- Last Refreshed -->
                    <TextBlock Text="{Binding LastRefreshed}"
                               Style="{StaticResource CaptionLabelStyle}"
                               VerticalAlignment="Center" Margin="0,0,12,4"/>

                    <!-- Refresh Button -->
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Center" Margin="0,0,12,4"/>
                </WrapPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 PRODUCT DETAIL PANEL (bottom, docked, visible on row click)
                 ═══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom"
                    Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}" Margin="0,6,0,0" Height="220"
                    Effect="{DynamicResource CardShadow}">
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Product Detail — " Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="{Binding SelectedProduct.ProductName}"
                                   Style="{StaticResource SectionHeaderStyle}" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding SelectedProduct.Category, StringFormat=' ({0})'}"
                                   Style="{StaticResource SectionHeaderStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal"/>
                    </StackPanel>

                    <!-- Stock Batches -->
                    <DockPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Stock Batches" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4"/>
                        <DataGrid ItemsSource="{Binding ProductDetail.StockBatches}"
                                   AutoGenerateColumns="False"
                                   CanUserAddRows="False" CanUserDeleteRows="False"
                                   IsReadOnly="True" CanUserReorderColumns="False" CanUserResizeRows="False"
                                   HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                   FontSize="11">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Receipt Date" Width="90"
                                                   Binding="{Binding ReceiptDate, StringFormat={StaticResource FormatDate}}"/>
                                <DataGridTextColumn Header="Received"   Width="68"
                                                   HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                   Binding="{Binding QuantityReceived}"
                                                   ElementStyle="{StaticResource NumericCellStyle}"/>
                                <DataGridTextColumn Header="Remaining"  Width="68"
                                                   HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                   Binding="{Binding QuantityRemaining}"
                                                   ElementStyle="{StaticResource NumericCellStyle}"/>
                                <DataGridTextColumn Header="Unit Cost"  Width="78"
                                                   HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                   Binding="{Binding UnitCost, StringFormat={StaticResource FormatCurrency}}"
                                                   ElementStyle="{StaticResource NumericCellStyle}"/>
                                <DataGridTextColumn Header="Expiry Date" Width="90"
                                                   Binding="{Binding ExpiryDate, StringFormat={StaticResource FormatDate}}"/>
                                <DataGridTextColumn Header="Expired?" Width="56"
                                                   Binding="{Binding IsExpired}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Recent Movements -->
                    <DockPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Recent Movements (30 days)" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4"/>
                        <DataGrid ItemsSource="{Binding ProductDetail.RecentMovements}"
                                   AutoGenerateColumns="False"
                                   CanUserAddRows="False" CanUserDeleteRows="False"
                                   IsReadOnly="True" CanUserReorderColumns="False" CanUserResizeRows="False"
                                   HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                   FontSize="11">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type"      Width="72"
                                                   Binding="{Binding MovementType}"/>
                                <DataGridTextColumn Header="Date"      Width="90"
                                                   Binding="{Binding MovementDate, StringFormat={StaticResource FormatDate}}"/>
                                <DataGridTextColumn Header="Qty"       Width="48"
                                                   HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                   Binding="{Binding Quantity}"
                                                   ElementStyle="{StaticResource NumericCellStyle}"/>
                                <DataGridTextColumn Header="Unit Cost" Width="78"
                                                   HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                   Binding="{Binding UnitCost, StringFormat={StaticResource FormatCurrency}}"
                                                   ElementStyle="{StaticResource NumericCellStyle}"/>
                                <DataGridTextColumn Header="Notes"     Width="*"
                                                   Binding="{Binding Notes}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 MAIN PRODUCT DATAGRID
                 ═══════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}"
                    Effect="{DynamicResource CardShadow}">
                <DockPanel Margin="12">

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Stock Inventory" Style="{StaticResource SectionHeaderStyle}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Color legend -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" Margin="0,0,3,0" CornerRadius="2"/>
                        <TextBlock Text="Out of Stock" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" Margin="0,0,3,0" CornerRadius="2"/>
                        <TextBlock Text="Low Stock" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" Margin="0,0,3,0" CornerRadius="2"/>
                        <TextBlock Text="Near-Expiry" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" Margin="0,0,3,0" CornerRadius="2"/>
                        <TextBlock Text="Normal" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- DataGrid Container -->
                    <Grid>
                        <DataGrid x:Name="ProductGrid"
                                  ItemsSource="{Binding Products}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False" CanUserResizeRows="False"
                                  IsReadOnly="True"
                                  SelectionUnit="FullRow" SelectionMode="Single"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  RowStyle="{StaticResource StockRowStyle}"
                                  CanUserSortColumns="True">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Product Name" Width="*" MinWidth="160"
                                                   Binding="{Binding ProductName}"/>

                                <DataGridTextColumn Header="Category" Width="120"
                                                   Binding="{Binding Category}"/>

                                <DataGridTextColumn Header="Stock" Width="70"
                                                   HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                   SortMemberPath="CurrentStock"
                                                   Binding="{Binding CurrentStock}"
                                                   ElementStyle="{StaticResource NumericCellStyle}"/>

                                <DataGridTextColumn Header="Unit" Width="55"
                                                   Binding="{Binding Unit}"/>

                                <DataGridTextColumn Width="85"
                                                    HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                    SortMemberPath="RetailPrice"
                                                    Binding="{Binding RetailPrice, StringFormat={StaticResource FormatCurrency}}"
                                                    ElementStyle="{StaticResource NumericCellStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Retail Price" ToolTip="Selling price set in Product Management." />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="80"
                                                    HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                    SortMemberPath="AverageUnitCost"
                                                    Binding="{Binding AverageUnitCost, StringFormat={StaticResource FormatCurrency}}"
                                                    ElementStyle="{StaticResource NumericCellStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Avg Cost" ToolTip="Weighted-average purchase cost across remaining non-expired batches." />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Width="80"
                                                    HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                    SortMemberPath="FifoOldestUnitCost"
                                                    Binding="{Binding FifoOldestUnitCost, StringFormat={StaticResource FormatCurrency}}"
                                                    ElementStyle="{StaticResource NumericCellStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="FIFO Cost" ToolTip="Unit cost of the oldest batch — the cost the next sale will draw from." />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Stock Value" Width="95"
                                                   HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                   SortMemberPath="StockValue"
                                                   Binding="{Binding StockValue, StringFormat={StaticResource FormatCurrency}}"
                                                   ElementStyle="{StaticResource NumericCellStyle}"/>

                                <!-- Stock Status badge -->
                                <DataGridTemplateColumn Header="Status" Width="80"
                                                       SortMemberPath="StockStatus" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Margin="4,2" Padding="4,2" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StockStatus}" Value="Low">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StockStatus}" Value="Out">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StockStatus}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBadge}">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StockStatus}" Value="Low">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StockStatus}" Value="Out">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Expiry Status -->
                                <DataGridTemplateColumn Header="Expiry" Width="90"
                                                       SortMemberPath="ExpiryStatus" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="—"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasExpiry}" Value="True">
                                                                <Setter Property="Text" Value="OK"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ExpiryStatus}" Value="NearExpiry">
                                                                <Setter Property="Text" Value="Near Expiry"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ExpiryStatus}" Value="HasExpired">
                                                                <Setter Property="Text" Value="Expired!"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Days Until Stockout -->
                                <DataGridTextColumn Header="Days to Stockout" Width="110"
                                                   HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                   SortMemberPath="DaysUntilStockout"
                                                   Binding="{Binding DaysUntilStockoutDisplay}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,8,0"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RiskLevel}" Value="Critical">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RiskLevel}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                        <views:EmptyStatePanel Title="No Stock Products"
                                               Description="There are no products in the stock inventory matching the filters."
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                </DockPanel>
            </Border>

        </DockPanel>

        <views:BusyOverlay Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

        <views:ErrorStatePanel Title="Load Failed"
                               Message="{Binding ErrorMessage}"
                               RetryCommand="{Binding RefreshCommand}"
                               Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>

</UserControl>
