<Window x:Class="Views.Inventory.ProductPriceHistoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MerchSys.App.Views.Shell"
        mc:Ignorable="d"
        Title="Product Price History" Height="500" Width="750"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <DockPanel>

            <!-- Header -->
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Product Retail Price History" Style="{StaticResource PageTitleStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Product: " Style="{StaticResource CaptionLabelStyle}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ProductName}" Style="{StaticResource CaptionLabelStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Footer Close Button -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click" IsCancel="True"/>
            </StackPanel>

            <!-- Main DataGrid Container -->
            <Grid>
                <!-- Main DataGrid -->
                <DataGrid ItemsSource="{Binding HistoryItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" CanUserReorderColumns="False" CanUserResizeRows="False"
                          SelectionUnit="FullRow" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                          Background="{DynamicResource SurfaceBrush}"
                          FontSize="{DynamicResource FontSizeBody}"
                          AlternatingRowBackground="{DynamicResource WindowBackgroundBrush}"
                          x:Name="HistoryGrid">
                    
                    <DataGrid.Columns>
                        
                        <DataGridTextColumn Header="Date &amp; Time" Width="135"
                                           Binding="{Binding ChangedAt, StringFormat={StaticResource FormatDateTime}}"/>

                        <DataGridTextColumn Header="Old Price" Width="95"
                                            HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                            Binding="{Binding OldPrice, StringFormat={StaticResource FormatCurrency}}"
                                            ElementStyle="{StaticResource NumericCellStyle}"/>

                        <DataGridTextColumn Header="New Price" Width="95"
                                            HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                            Binding="{Binding NewPrice, StringFormat={StaticResource FormatCurrency}}"
                                            ElementStyle="{StaticResource NumericCellStyle}"/>

                        <DataGridTemplateColumn Header="Delta" Width="95"
                                                HeaderStyle="{StaticResource RightAlignedHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="SemiBold" HorizontalAlignment="Right" Padding="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="₱0.00"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsIncrease}" Value="True">
                                                        <Setter Property="Text" Value="{Binding Delta, StringFormat={StaticResource FormatCurrencySignedPositive}}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDecrease}" Value="True">
                                                        <Setter Property="Text" Value="{Binding Delta, StringFormat={StaticResource FormatCurrency}}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Changed By" Width="110"
                                           Binding="{Binding ChangedBy}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="Padding" Value="4,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Reason" Width="*" MinWidth="130"
                                           Binding="{Binding Reason}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="Padding" Value="4,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <views:EmptyStatePanel Title="No Price History"
                                       Description="No price changes have been recorded for this product."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
            </Grid>

        </DockPanel>

        <views:BusyOverlay Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

        <views:ErrorStatePanel Title="Load Failed"
                               Message="{Binding ErrorMessage}"
                               Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
