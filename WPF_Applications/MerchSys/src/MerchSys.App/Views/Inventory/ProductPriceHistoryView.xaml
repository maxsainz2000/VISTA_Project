<Window x:Class="Views.Inventory.ProductPriceHistoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Product Price History" Height="500" Width="750"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="#F5F6FA"
        BorderBrush="#DFE6E9" BorderThickness="1">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EBF5FB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RightAlignCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <DockPanel>

            <!-- Header -->
            <Border DockPanel.Dock="Top" BorderBrush="#DFE6E9" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Product Retail Price History" Style="{StaticResource PageTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Product: " Style="{StaticResource SubTitle}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ProductName}" Style="{StaticResource SubTitle}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Loading History…" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="11" Foreground="#7F8C8D"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <!-- Footer Close Button -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click" IsCancel="True"/>
            </StackPanel>

            <!-- Main DataGrid -->
            <DataGrid ItemsSource="{Binding HistoryItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" CanUserReorderColumns="False" CanUserResizeRows="False"
                      SelectionUnit="FullRow" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderBrush="#DFE6E9" BorderThickness="1"
                      Background="White"
                      FontSize="12"
                      AlternatingRowBackground="#FAFBFC"
                      x:Name="HistoryGrid">
                
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D6EAF8"/>
                                <Setter Property="BorderBrush" Value="#2980B9"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                
                <DataGrid.Columns>
                    
                    <DataGridTextColumn Header="Date &amp; Time" Width="135"
                                       Binding="{Binding ChangedAt, StringFormat='yyyy-MM-dd HH:mm:ss UTC'}"/>

                    <DataGridTextColumn Header="Old Price" Width="95"
                                       Binding="{Binding OldPrice, StringFormat='₱{0:N2}'}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="New Price" Width="95"
                                       Binding="{Binding NewPrice, StringFormat='₱{0:N2}'}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Delta" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontWeight="SemiBold" HorizontalAlignment="Right" Padding="0,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="₱0.00"/>
                                            <Setter Property="Foreground" Value="#7F8C8D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsIncrease}" Value="True">
                                                    <Setter Property="Text" Value="{Binding Delta, StringFormat='+₱{0:N2}'}"/>
                                                    <Setter Property="Foreground" Value="#27AE60"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDecrease}" Value="True">
                                                    <Setter Property="Text" Value="{Binding Delta, StringFormat='₱{0:N2}'}"/>
                                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Changed By" Width="110"
                                       Binding="{Binding ChangedBy}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#2C3E50"/>
                                <Setter Property="Padding" Value="4,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Reason" Width="*" MinWidth="130"
                                       Binding="{Binding Reason}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="Foreground" Value="#7F8C8D"/>
                                <Setter Property="Padding" Value="4,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>

        </DockPanel>
    </Grid>
</Window>
