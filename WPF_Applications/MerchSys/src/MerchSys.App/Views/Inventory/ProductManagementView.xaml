<UserControl x:Class="Views.Inventory.ProductManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MerchSys.App.Views.Shell"
             xmlns:helpers="clr-namespace:MerchSys.App.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="{DynamicResource WindowBackgroundBrush}"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FormInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FormCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ProductRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource SemanticRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Root Grid holds main content + overlays -->
    <Grid>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN CONTENT
             ═══════════════════════════════════════════════════════════ -->
        <DockPanel Margin="12">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsBusy}" Value="True"/>
                                <Condition Binding="{Binding LastLoadedAt}" Value="{x:Null}"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <!-- Page Header -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Product Management" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="  (Manager Only)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <views:FreshnessChip Grid.Column="1"
                                     LastLoadedAt="{Binding LastLoadedAt}"
                                     RefreshCommand="{Binding LoadDataCommand}"
                                     VerticalAlignment="Center"/>
            </Grid>

            <!-- Tab Control -->
            <TabControl DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">

                <!-- ═══════════════ TAB 1: PRODUCTS ═══════════════ -->
                <TabItem Header="Products">
                    <DockPanel Margin="12">

                        <!-- Toolbar -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource FilterBarStyle}" Margin="0,0,0,8">
                            <WrapPanel Orientation="Horizontal">
                                <!-- Category -->
                                <StackPanel Style="{StaticResource FilterBarItemStyle}" Orientation="Horizontal">
                                    <TextBlock Text="Category:" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox ItemsSource="{Binding CategoryFilters}"
                                              SelectedItem="{Binding SelectedCategoryFilter}"
                                              Width="140"
                                              Padding="6,4" VerticalContentAlignment="Center"
                                              BorderBrush="{DynamicResource SeparatorBrush}"
                                              TabIndex="1"/>
                                </StackPanel>

                                <!-- Search -->
                                <StackPanel Style="{StaticResource FilterBarItemStyle}" Orientation="Horizontal">
                                    <TextBlock Text="Search:" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Width="200"
                                             Padding="6,4" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                             VerticalContentAlignment="Center"
                                             x:Name="SearchBox"
                                             TabIndex="2"/>
                                </StackPanel>

                                <!-- Add Product -->
                                <Button Content="_Add Product"
                                        Command="{Binding AddProductCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        VerticalAlignment="Center" Margin="0,0,12,4"
                                        TabIndex="3"/>

                                <!-- Edit -->
                                <Button Content="_Edit"
                                        Command="{Binding EditProductCommand}"
                                        CommandParameter="{Binding SelectedProduct}"
                                        IsEnabled="{Binding HasSelectedProduct}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        VerticalAlignment="Center" Margin="0,0,12,4"
                                        TabIndex="4"/>

                                <!-- Deactivate / Reactivate -->
                                <Button Command="{Binding DeactivateProductCommand}"
                                        CommandParameter="{Binding SelectedProduct}"
                                        IsEnabled="{Binding HasSelectedProduct}"
                                        VerticalAlignment="Center" Margin="0,0,12,4"
                                        TabIndex="5">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource WarningButtonStyle}">
                                            <Setter Property="Content" Value="Deactivate"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedProductIsActive}" Value="False">
                                                    <Setter Property="Content" Value="Reactivate"/>
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Price History -->
                                <Button Content="_Price History"
                                        Click="ViewPriceHistory_Click"
                                        IsEnabled="{Binding HasSelectedProduct}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        VerticalAlignment="Center" Margin="0,0,12,4"
                                        TabIndex="6"/>
 

                            </WrapPanel>
                        </Border>

                        <!-- Filter summary bar showing count, active filter chips, and clear all -->
                        <views:FilterSummaryBar DockPanel.Dock="Top"
                                                Margin="4,0,4,8"
                                                ShownCount="{Binding Products.Count}"
                                                TotalCount="{Binding TotalProducts}"
                                                ActiveFilters="{Binding ActiveFilterChips}"
                                                ClearAllCommand="{Binding ClearFiltersCommand}"/>

                        <!-- Product DataGrid Container -->
                        <Grid>
                            <!-- Product DataGrid -->
                            <DataGrid x:Name="ProductGrid" TabIndex="8"
                                      ItemsSource="{Binding Products}"
                                      SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserReorderColumns="False" CanUserResizeRows="False"
                                      IsReadOnly="True"
                                      SelectionUnit="FullRow" SelectionMode="Single"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      RowStyle="{StaticResource ProductRowStyle}"
                                      CanUserSortColumns="True">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Product Name" Width="*" MinWidth="160"
                                                       Binding="{Binding Name}"/>

                                    <DataGridTextColumn Header="SKU" Width="100"
                                                       Binding="{Binding Sku}"/>

                                    <DataGridTextColumn Header="Category" Width="130"
                                                       Binding="{Binding CategoryName}"/>

                                    <DataGridTextColumn Header="Retail Price" Width="95"
                                                       HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                       SortMemberPath="RetailPrice"
                                                       Binding="{Binding RetailPrice, StringFormat={StaticResource FormatCurrency}}"
                                                       ElementStyle="{StaticResource NumericCellStyle}"/>

                                    <DataGridTextColumn Header="Unit" Width="60"
                                                       Binding="{Binding Unit}"/>

                                    <DataGridTemplateColumn Header="Has Expiry" Width="75" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="No"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasExpiry}" Value="True">
                                                                    <Setter Property="Text" Value="Yes"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Min Threshold" Width="95"
                                                       HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                       SortMemberPath="MinThreshold"
                                                       Binding="{Binding MinThreshold}"
                                                       ElementStyle="{StaticResource NumericCellStyle}"/>

                                    <DataGridTemplateColumn Header="Status" Width="80" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="3" Margin="4,2" Padding="5,2" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Active"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                        <Setter Property="Text" Value="Inactive"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                             <views:EmptyStatePanel Title="{Binding EmptyStateTitle}"
                                                    Description="{Binding EmptyStateDescription}"
                                                    ActionText="{Binding EmptyStateActionText}"
                                                    ActionCommand="{Binding EmptyStateActionCommand}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                    </DockPanel>
                </TabItem>

                <!-- ═══════════════ TAB 2: CATEGORIES ═══════════════ -->
                <TabItem Header="Categories">
                    <DockPanel Margin="12">

                        <!-- Category Toolbar -->
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1"
                                Padding="0,8,0,8" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Add _Category"
                                        Command="{Binding AddCategoryCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,8,0"
                                        TabIndex="9"/>
                            </StackPanel>
                        </Border>

                        <TextBlock DockPanel.Dock="Top"
                                   Text="Note: Categories with products cannot be deleted."
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                        <!-- Category DataGrid Container -->
                        <Grid>
                            <!-- Category DataGrid -->
                            <DataGrid ItemsSource="{Binding Categories}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserReorderColumns="False" CanUserResizeRows="False"
                                      IsReadOnly="True"
                                      SelectionUnit="FullRow" SelectionMode="Single"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      CanUserSortColumns="True"
                                      TabIndex="10">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Category Name" Width="*" MinWidth="160"
                                                       Binding="{Binding Name}"/>

                                    <DataGridTextColumn Header="Description" Width="*"
                                                       Binding="{Binding Description}"/>

                                    <DataGridTextColumn Header="Products" Width="80"
                                                       HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                       SortMemberPath="ProductCount"
                                                       Binding="{Binding ProductCount}"
                                                       ElementStyle="{StaticResource NumericCellStyle}"/>

                                    <DataGridTemplateColumn Header="Actions" Width="160" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                                    <Button Content="Edit"
                                                            Command="{Binding DataContext.EditCategoryCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="10,3" FontSize="11"
                                                            Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextOnAccentBrush}"
                                                            BorderThickness="0" Cursor="Hand"
                                                            Margin="0,0,6,0"/>
                                                    <Button Content="Delete"
                                                            Command="{Binding DataContext.DeleteCategoryCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="10,3" FontSize="11"
                                                            BorderThickness="0" Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ProductCount}" Value="0">
                                                                        <Setter Property="IsEnabled" Value="True"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                            <views:EmptyStatePanel Title="No Categories Found"
                                                   Description="There are no product categories configured."
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   ActionCommand="{Binding AddCategoryCommand}"
                                                   ActionText="Add Category">
                                <views:EmptyStatePanel.Style>
                                    <Style TargetType="UserControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Categories.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:EmptyStatePanel.Style>
                            </views:EmptyStatePanel>
                        </Grid>

                    </DockPanel>
                </TabItem>

            </TabControl>
        </DockPanel>

        <!-- ═══════════════════════════════════════════════════════════
             PRODUCT EDITOR OVERLAY
             ═══════════════════════════════════════════════════════════ -->
        <Grid Background="{DynamicResource OverlayBrush}"
              x:Name="ProductEditorOverlay" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="ProductEditorOverlay_IsVisibleChanged">

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border Style="{StaticResource CardStyle}" Padding="24,20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" MinWidth="480" MaxWidth="560">
                <StackPanel>

                    <!-- Dialog Header -->
                    <TextBlock Text="{Binding EditorTitle}"
                               FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,16"/>

                    <views:ErrorSummary TargetContainer="{Binding ElementName=ProductEditorOverlay}" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column -->
                        <StackPanel Grid.Column="0">
                            <HeaderedContentControl Header="Product Name" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="True">
                                <TextBox x:Name="EditorNameTextBox"
                                         Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"
                                         Style="{StaticResource FormInput}"
                                         TabIndex="11"/>
                            </HeaderedContentControl>

                            <HeaderedContentControl Header="SKU" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="True">
                                <TextBox Text="{Binding EditorSku, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"
                                         Style="{StaticResource FormInput}"
                                         TabIndex="12"/>
                            </HeaderedContentControl>

                            <HeaderedContentControl Header="Category" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="True">
                                <ComboBox ItemsSource="{Binding Categories}"
                                          SelectedValuePath="CategoryId"
                                          DisplayMemberPath="Name"
                                          SelectedValue="{Binding EditorCategoryId, NotifyOnValidationError=True}"
                                          Style="{StaticResource FormCombo}"
                                          TabIndex="13"/>
                            </HeaderedContentControl>

                            <!-- Costing Helper Panel -->
                            <StackPanel Orientation="Vertical" Margin="0,0,0,10"
                                        Visibility="{Binding ShowCostingHelper, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Current FIFO Cost: " Style="{StaticResource CaptionLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding EditorFifoCost, StringFormat={StaticResource FormatCurrency}}" FontWeight="Bold" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Suggested Price (20%): " Style="{StaticResource CaptionLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding EditorSuggestedPrice, StringFormat={StaticResource FormatCurrency}}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Current Margin: " Style="{StaticResource CaptionLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EditorMargin, StringFormat={StaticResource FormatCurrency}}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="{Binding EditorMarginPercent, StringFormat=' ({0}%)'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <HeaderedContentControl Header="Retail Price (₱)" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="True">
                                <TextBox Text="{Binding EditorRetailPriceText, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"
                                         helpers:FormHelper.InputMode="PositiveDecimal"
                                         Style="{StaticResource FormInput}"
                                         TabIndex="14"/>
                            </HeaderedContentControl>

                            <HeaderedContentControl Header="Price Change Reason (optional)" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="False">
                                <TextBox Text="{Binding EditorPriceChangeReason, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"
                                         Style="{StaticResource FormInput}"
                                         TabIndex="15"/>
                            </HeaderedContentControl>
                        </StackPanel>

                        <!-- Right Column -->
                        <StackPanel Grid.Column="2">
                            <HeaderedContentControl Header="Unit" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="True">
                                <ComboBox ItemsSource="{Binding UnitOptions}"
                                          SelectedItem="{Binding EditorUnit, NotifyOnValidationError=True}"
                                          Style="{StaticResource FormCombo}"
                                          TabIndex="16"/>
                            </HeaderedContentControl>

                            <TextBlock Text="Has Expiry Date" Style="{StaticResource FieldLabelStyle}"/>
                            <CheckBox IsChecked="{Binding EditorHasExpiry}"
                                      Content="Track expiry on batches"
                                      Margin="0,0,0,12" FontSize="12"
                                      TabIndex="17"/>

                            <HeaderedContentControl Header="Minimum Threshold" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="True">
                                <TextBox Text="{Binding EditorMinThresholdText, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"
                                         helpers:FormHelper.InputMode="PositiveInteger"
                                         Style="{StaticResource FormInput}"
                                         TabIndex="18"/>
                            </HeaderedContentControl>

                            <HeaderedContentControl Header="Description" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="False">
                                <TextBox Text="{Binding EditorDescription, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"
                                         Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="6,4" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                         FontSize="12" Margin="0,0,0,10"
                                         TabIndex="19"/>
                            </HeaderedContentControl>
                        </StackPanel>
                    </Grid>

                    <!-- Validation Error -->
                    <TextBlock Text="{Binding EditorError}"
                               Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSizeCaption}"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding HasEditorError, Converter={StaticResource BoolToVis}}"/>

                    <!-- Footer Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Ca_ncel"
                                Command="{Binding CancelEditorCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                TabIndex="20"/>
                        <Button Content="_Save Product"
                                Command="{Binding SaveProductCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                TabIndex="21"/>
                    </StackPanel>

                </StackPanel>
            </Border>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             CATEGORY EDITOR OVERLAY
             ═══════════════════════════════════════════════════════════ -->
        <Grid Background="{DynamicResource OverlayBrush}"
              x:Name="CategoryEditorOverlay" Visibility="{Binding IsCategoryEditorOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="CategoryEditorOverlay_IsVisibleChanged">

            <Border Style="{StaticResource CardStyle}" MaxWidth="420" Padding="24,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>

                    <TextBlock Text="{Binding CategoryEditorTitle}"
                               FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,16"/>

                    <HeaderedContentControl Header="Category Name" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="True">
                        <TextBox x:Name="CategoryEditorNameTextBox"
                                 Text="{Binding CategoryEditorName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormInput}"
                                 TabIndex="22"/>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Description" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="False">
                        <TextBox Text="{Binding CategoryEditorDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="6,4" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                 FontSize="12" Margin="0,0,0,12"
                                 TabIndex="23"/>
                    </HeaderedContentControl>

                    <!-- Validation Error -->
                    <TextBlock Text="{Binding CategoryEditorError}"
                               Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSizeCaption}"
                               TextWrapping="Wrap" Margin="0,0,0,12"
                               Visibility="{Binding HasCategoryEditorError, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Ca_ncel"
                                Command="{Binding CancelCategoryEditorCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                TabIndex="24"/>
                        <Button Content="_Save Category"
                                Command="{Binding SaveCategoryCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                TabIndex="25"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

        <views:SkeletonPanel Kind="Rows" IsBusy="{Binding IsBusy}" LastLoadedAt="{Binding LastLoadedAt}" Margin="12"/>

        <views:BusyOverlay IsBusy="{Binding IsBusy}" LastLoadedAt="{Binding LastLoadedAt}"/>

        <views:ErrorStatePanel Title="Load Failed"
                               Message="{Binding ErrorMessage}"
                               RetryCommand="{Binding LoadDataCommand}"
                               Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

    </Grid>

</UserControl>
