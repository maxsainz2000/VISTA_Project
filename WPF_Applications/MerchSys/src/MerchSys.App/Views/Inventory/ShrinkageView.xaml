<UserControl x:Class="Views.Inventory.ShrinkageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MerchSys.App.Views.Shell"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FormInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FormCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- Root grid allows dialog overlay to cover full content area -->
    <Grid>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN CONTENT
             ═══════════════════════════════════════════════════════════ -->
        <DockPanel Margin="10">

            <!-- ── Summary Cards ──────────────────────────────────── -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding PeriodTotalValue, StringFormat='₱{0:N2}'}"
                                   Style="{StaticResource MetricValueLargeStyle}" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="Period Shrinkage Value" Style="{StaticResource CaptionLabelStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding FilteredCount}"
                                   Style="{StaticResource MetricValueLargeStyle}" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Records (Filtered)" Style="{StaticResource CaptionLabelStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{Binding LastRefreshed}"
                                   Style="{StaticResource MetricValueStyle}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="Last Refreshed" Style="{StaticResource CaptionLabelStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Toolbar ────────────────────────────────────────── -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}" Padding="12,8" Margin="0,0,0,6"
                    Effect="{DynamicResource CardShadow}">
                <DockPanel>

                    <!-- Right side: status, loading, refresh -->
                    <Button DockPanel.Dock="Right"
                            Content="Refresh"
                            Command="{Binding LoadDataCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                    <!-- Record button on left -->
                    <Button DockPanel.Dock="Left"
                            Content="+ Record Shrinkage"
                            Command="{Binding OpenDialogCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Margin="0,0,16,0"/>

                    <!-- Filters in middle -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <TextBlock Text="From:" Style="{StaticResource CaptionLabelStyle}"/>
                        <DatePicker x:Name="StartDatePicker"
                                    Width="115" Margin="0,0,10,0"
                                    SelectedDateChanged="StartDatePicker_SelectedDateChanged"/>

                        <TextBlock Text="To:" Style="{StaticResource CaptionLabelStyle}"/>
                        <DatePicker x:Name="EndDatePicker"
                                    Width="115" Margin="0,0,16,0"
                                    SelectedDateChanged="EndDatePicker_SelectedDateChanged"/>

                        <TextBlock Text="Product:" Style="{StaticResource CaptionLabelStyle}"/>
                        <ComboBox x:Name="FilterProductCombo"
                                  ItemsSource="{Binding FilterProducts}"
                                  SelectedItem="{Binding FilterSelectedProduct}"
                                  Width="160" Margin="0,0,16,0"
                                  VerticalAlignment="Center"/>

                        <TextBlock Text="Reason:" Style="{StaticResource CaptionLabelStyle}"/>
                        <ComboBox x:Name="ReasonFilterCombo"
                                  Width="110" VerticalAlignment="Center"
                                  SelectionChanged="ReasonFilterCombo_SelectionChanged">
                            <ComboBoxItem Content="(All Reasons)" Tag="" IsSelected="True"/>
                            <ComboBoxItem Content="Damage" Tag="Damage"/>
                            <ComboBoxItem Content="Spoilage" Tag="Spoilage"/>
                            <ComboBoxItem Content="Expiry" Tag="Expiry"/>
                            <ComboBoxItem Content="Admin Error" Tag="Admin Error"/>
                        </ComboBox>

                        <!-- Status message -->
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- ── History DataGrid Container ─────────────────────── -->
            <Grid>
                <!-- ── History DataGrid ───────────────────────────────── -->
                <DataGrid ItemsSource="{Binding HistoryItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" CanUserReorderColumns="False" CanUserResizeRows="False"
                          SelectionUnit="FullRow" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserSortColumns="True"
                          FontSize="12">
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Date" Width="130"
                                           SortMemberPath="RecordedDate"
                                           Binding="{Binding RecordedDate, StringFormat='MM/dd/yyyy HH:mm'}"/>

                        <DataGridTextColumn Header="Product" Width="*" MinWidth="140"
                                           Binding="{Binding ProductName}"/>

                        <DataGridTextColumn Header="Qty" Width="55"
                                           SortMemberPath="QuantityLost"
                                           Binding="{Binding QuantityLost}"
                                           ElementStyle="{StaticResource NumericCellStyle}"/>

                        <DataGridTextColumn Header="Unit Cost" Width="90"
                                           SortMemberPath="UnitCost"
                                           Binding="{Binding UnitCost, StringFormat='₱{0:N2}'}"
                                           ElementStyle="{StaticResource NumericCellStyle}"/>

                        <DataGridTextColumn Header="Total Value" Width="100"
                                           SortMemberPath="TotalValue"
                                           Binding="{Binding TotalValue, StringFormat='₱{0:N2}'}"
                                           ElementStyle="{StaticResource NumericCellStyle}"/>

                        <!-- Reason column with color coding -->
                        <DataGridTemplateColumn Header="Reason" Width="100" SortMemberPath="Reason" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Reason}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Reason}" Value="Damage">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Reason}" Value="Spoilage">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Reason}" Value="Expiry">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Reason}" Value="Admin Error">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Notes" Width="160"
                                           Binding="{Binding Notes}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Recorded By" Width="110"
                                           Binding="{Binding RecordedBy}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <views:EmptyStatePanel Title="No Shrinkage Records"
                                       Description="No shrinkage loss records found for the selected period."
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                    <views:EmptyStatePanel.Style>
                        <Style TargetType="UserControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HistoryItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:EmptyStatePanel.Style>
                </views:EmptyStatePanel>
            </Grid>

        </DockPanel>

        <!-- ═══════════════════════════════════════════════════════════
             RECORD SHRINKAGE DIALOG OVERLAY
             ═══════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVis}}"
              Background="{DynamicResource OverlayBrush}"
              Panel.ZIndex="100">

            <Border Style="{StaticResource CardStyle}"
                    Width="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="28,24">

                <StackPanel>

                    <!-- Dialog title -->
                    <TextBlock Text="Record Shrinkage"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,20"/>

                    <!-- Product -->
                    <TextBlock Text="Product *" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding DialogProducts}"
                               SelectedItem="{Binding DialogSelectedProduct}"
                               Style="{StaticResource FormCombo}"
                               Margin="0,0,0,4"/>
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Select a product to see available stock."/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DialogSelectedProduct}" Value="{x:Null}">
                                        <Setter Property="Text" Value="Select a product to see available stock."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Available stock: "/>
                        <Run Text="{Binding DialogAvailableStock}" FontWeight="SemiBold"/>
                        <Run Text=" units"/>
                    </TextBlock>

                    <!-- Quantity -->
                    <TextBlock Text="Quantity *" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="QuantityBox"
                              Text="{Binding DialogQuantity, UpdateSourceTrigger=LostFocus}"
                              Style="{StaticResource FormInput}"
                              Margin="0,0,0,12"
                              PreviewTextInput="QuantityBox_PreviewTextInput"/>

                    <!-- Reason -->
                    <TextBlock Text="Reason *" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding ReasonOptions}"
                               SelectedItem="{Binding DialogReason}"
                               Style="{StaticResource FormCombo}"
                               Margin="0,0,0,12"/>

                    <!-- Notes -->
                    <TextBlock Text="Notes (optional)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding DialogNotes, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource FormInput}"
                              Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,12"/>

                    <!-- Batch (optional) -->
                    <TextBlock Text="Batch (optional — leave Auto for FIFO)" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding DialogBatches}"
                               SelectedItem="{Binding DialogSelectedBatch}"
                               Style="{StaticResource FormCombo}"
                               Margin="0,0,0,20"/>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Click="CancelDialogButton_Click"/>
                        <Button Content="Confirm"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="ConfirmRecordButton_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

        <views:BusyOverlay Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

    </Grid>

</UserControl>
