<UserControl x:Class="Views.Inventory.ShrinkageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="#F5F6FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE6E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDC3C7"/>
                    <Setter Property="Foreground" Value="#7F8C8D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecordButton" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDC3C7"/>
                    <Setter Property="Foreground" Value="#7F8C8D"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DialogPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DialogCancelButton" TargetType="Button">
            <Setter Property="Background" Value="#ECF0F1"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BDC3C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DialogLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="DialogInput" TargetType="Control">
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="RightAlignCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,4,0"/>
        </Style>
    </UserControl.Resources>

    <!-- Root grid allows dialog overlay to cover full content area -->
    <Grid>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN CONTENT
             ═══════════════════════════════════════════════════════════ -->
        <DockPanel Margin="10">

            <!-- ── Summary Cards ──────────────────────────────────── -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding PeriodTotalValue, StringFormat='₱{0:N2}'}"
                                   Style="{StaticResource CardValue}" Foreground="#E74C3C"/>
                        <TextBlock Text="Period Shrinkage Value" Style="{StaticResource CardLabel}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding FilteredCount}"
                                   Style="{StaticResource CardValue}" Foreground="#2980B9"/>
                        <TextBlock Text="Records (Filtered)" Style="{StaticResource CardLabel}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SummaryCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{Binding LastRefreshed}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#7F8C8D"/>
                        <TextBlock Text="Last Refreshed" Style="{StaticResource CardLabel}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Toolbar ────────────────────────────────────────── -->
            <Border DockPanel.Dock="Top"
                    Background="White" BorderBrush="#DFE6E9" BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                <DockPanel>

                    <!-- Right side: status, loading, refresh -->
                    <Button DockPanel.Dock="Right"
                            Content="Refresh"
                            Command="{Binding LoadDataCommand}"
                            Style="{StaticResource ActionButton}"/>

                    <TextBlock DockPanel.Dock="Right"
                               Text="Loading…"
                               FontSize="10" Foreground="#95A5A6"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                    <!-- Record button on left -->
                    <Button DockPanel.Dock="Left"
                            Content="+ Record Shrinkage"
                            Command="{Binding OpenDialogCommand}"
                            Style="{StaticResource RecordButton}"
                            Margin="0,0,16,0"/>

                    <!-- Filters in middle -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <TextBlock Text="From:" Style="{StaticResource FilterLabel}"/>
                        <DatePicker x:Name="StartDatePicker"
                                    Width="115" Margin="0,0,10,0"
                                    SelectedDateChanged="StartDatePicker_SelectedDateChanged"/>

                        <TextBlock Text="To:" Style="{StaticResource FilterLabel}"/>
                        <DatePicker x:Name="EndDatePicker"
                                    Width="115" Margin="0,0,16,0"
                                    SelectedDateChanged="EndDatePicker_SelectedDateChanged"/>

                        <TextBlock Text="Product:" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="FilterProductCombo"
                                  ItemsSource="{Binding FilterProducts}"
                                  SelectedItem="{Binding FilterSelectedProduct}"
                                  Width="160" Margin="0,0,16,0"
                                  VerticalAlignment="Center"/>

                        <TextBlock Text="Reason:" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="ReasonFilterCombo"
                                  Width="110" VerticalAlignment="Center"
                                  SelectionChanged="ReasonFilterCombo_SelectionChanged">
                            <ComboBoxItem Content="(All Reasons)" Tag="" IsSelected="True"/>
                            <ComboBoxItem Content="Damage" Tag="Damage"/>
                            <ComboBoxItem Content="Spoilage" Tag="Spoilage"/>
                            <ComboBoxItem Content="Expiry" Tag="Expiry"/>
                            <ComboBoxItem Content="Admin Error" Tag="Admin Error"/>
                        </ComboBox>

                        <!-- Status message -->
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#27AE60"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                            <Setter Property="Foreground" Value="#E74C3C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- ── History DataGrid ───────────────────────────────── -->
            <DataGrid ItemsSource="{Binding HistoryItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" CanUserReorderColumns="False" CanUserResizeRows="False"
                      SelectionUnit="FullRow" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderBrush="#DFE6E9" BorderThickness="1"
                      CanUserSortColumns="True"
                      Background="White"
                      FontSize="12">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D6EAF8"/>
                                <Setter Property="BorderBrush" Value="#2980B9"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>

                    <DataGridTextColumn Header="Date" Width="130"
                                       SortMemberPath="RecordedDate"
                                       Binding="{Binding RecordedDate, StringFormat='MM/dd/yyyy HH:mm'}"/>

                    <DataGridTextColumn Header="Product" Width="*" MinWidth="140"
                                       Binding="{Binding ProductName}"/>

                    <DataGridTextColumn Header="Qty" Width="55"
                                       SortMemberPath="QuantityLost"
                                       Binding="{Binding QuantityLost}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Unit Cost" Width="90"
                                       SortMemberPath="UnitCost"
                                       Binding="{Binding UnitCost, StringFormat='₱{0:N2}'}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Total Value" Width="100"
                                       SortMemberPath="TotalValue"
                                       Binding="{Binding TotalValue, StringFormat='₱{0:N2}'}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Reason column with color coding -->
                    <DataGridTemplateColumn Header="Reason" Width="100" SortMemberPath="Reason" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Reason}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#7F8C8D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Reason}" Value="Damage">
                                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Reason}" Value="Spoilage">
                                                    <Setter Property="Foreground" Value="#E67E22"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Reason}" Value="Expiry">
                                                    <Setter Property="Foreground" Value="#8E44AD"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Reason}" Value="Admin Error">
                                                    <Setter Property="Foreground" Value="#2980B9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Notes" Width="160"
                                       Binding="{Binding Notes}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="Foreground" Value="#7F8C8D"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Recorded By" Width="110"
                                       Binding="{Binding RecordedBy}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#7F8C8D"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>

        </DockPanel>

        <!-- ═══════════════════════════════════════════════════════════
             RECORD SHRINKAGE DIALOG OVERLAY
             ═══════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVis}}"
              Background="#99000000"
              Panel.ZIndex="100">

            <Border Background="White" CornerRadius="8"
                    Width="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="28,24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
                </Border.Effect>

                <StackPanel>

                    <!-- Dialog title -->
                    <TextBlock Text="Record Shrinkage"
                               FontSize="16" FontWeight="Bold" Foreground="#2C3E50"
                               Margin="0,0,0,20"/>

                    <!-- Product -->
                    <TextBlock Text="Product *" Style="{StaticResource DialogLabel}"/>
                    <ComboBox ItemsSource="{Binding DialogProducts}"
                              SelectedItem="{Binding DialogSelectedProduct}"
                              Style="{StaticResource DialogInput}"
                              Margin="0,0,0,4"/>
                    <TextBlock FontSize="10" Foreground="#7F8C8D" Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Select a product to see available stock."/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DialogSelectedProduct}" Value="{x:Null}">
                                        <Setter Property="Text" Value="Select a product to see available stock."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Available stock: "/>
                        <Run Text="{Binding DialogAvailableStock}" FontWeight="SemiBold"/>
                        <Run Text=" units"/>
                    </TextBlock>

                    <!-- Quantity -->
                    <TextBlock Text="Quantity *" Style="{StaticResource DialogLabel}"/>
                    <TextBox x:Name="QuantityBox"
                             Text="{Binding DialogQuantity, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource DialogInput}"
                             Margin="0,0,0,12"
                             PreviewTextInput="QuantityBox_PreviewTextInput"/>

                    <!-- Reason -->
                    <TextBlock Text="Reason *" Style="{StaticResource DialogLabel}"/>
                    <ComboBox ItemsSource="{Binding ReasonOptions}"
                              SelectedItem="{Binding DialogReason}"
                              Style="{StaticResource DialogInput}"
                              Margin="0,0,0,12"/>

                    <!-- Notes -->
                    <TextBlock Text="Notes (optional)" Style="{StaticResource DialogLabel}"/>
                    <TextBox Text="{Binding DialogNotes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DialogInput}"
                             Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,12"/>

                    <!-- Batch (optional) -->
                    <TextBlock Text="Batch (optional — leave Auto for FIFO)" Style="{StaticResource DialogLabel}"/>
                    <ComboBox ItemsSource="{Binding DialogBatches}"
                              SelectedItem="{Binding DialogSelectedBatch}"
                              Style="{StaticResource DialogInput}"
                              Margin="0,0,0,20"/>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{StaticResource DialogCancelButton}"
                                Margin="0,0,8,0"
                                Click="CancelDialogButton_Click"/>
                        <Button Content="Confirm"
                                Style="{StaticResource DialogPrimaryButton}"
                                Click="ConfirmRecordButton_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>

        </Grid>

    </Grid>

</UserControl>
