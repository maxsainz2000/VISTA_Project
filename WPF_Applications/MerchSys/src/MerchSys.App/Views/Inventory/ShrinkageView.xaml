<UserControl x:Class="Views.Inventory.ShrinkageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MerchSys.App.Views.Shell"
             xmlns:helpers="clr-namespace:MerchSys.App.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="{DynamicResource WindowBackgroundBrush}"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FormInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FormCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- Root grid allows dialog overlay to cover full content area -->
    <Grid>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN CONTENT
             ═══════════════════════════════════════════════════════════ -->
        <DockPanel Margin="10">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsBusy}" Value="True"/>
                                <Condition Binding="{Binding LastLoadedAt}" Value="{x:Null}"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <!-- ── Summary Cards ──────────────────────────────────── -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/> <!-- Hero (Period Total Value) -->
                    <ColumnDefinition Width="*"/>     <!-- Records (Filtered) -->
                </Grid.ColumnDefinitions>

                <!-- Hero: Period Shrinkage Value -->
                <Border Grid.Column="0" Style="{StaticResource PrimaryMetricCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding PeriodTotalValue, StringFormat={StaticResource FormatCurrency}}"
                                   Style="{StaticResource PrimaryMetricValueStyle}" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="Period Shrinkage Value" Style="{StaticResource CaptionLabelStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Records (Filtered) -->
                <Border Grid.Column="1" Style="{StaticResource SecondaryMetricCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{Binding FilteredCount}"
                                   Style="{StaticResource SecondaryMetricValueStyle}" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Records (Filtered)" Style="{StaticResource CaptionLabelStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Toolbar ────────────────────────────────────────── -->
            <Border DockPanel.Dock="Top" Style="{StaticResource FilterBarStyle}" Margin="0,0,0,6" Effect="{DynamicResource CardShadow}">
                <WrapPanel Orientation="Horizontal">
                    <!-- Record button -->
                    <Button Content="_Record Shrinkage"
                            Command="{Binding OpenDialogCommand}"
                            IsEnabled="{Binding CanEdit}"
                            Style="{StaticResource DangerButtonStyle}"
                            VerticalAlignment="Center" Margin="0,0,12,4"
                            TabIndex="1"/>

                    <!-- Date range From -->
                    <StackPanel Style="{StaticResource FilterBarItemStyle}" Orientation="Horizontal">
                        <TextBlock Text="From:" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="StartDatePicker"
                                    Width="115"
                                    SelectedDateChanged="StartDatePicker_SelectedDateChanged"
                                    TabIndex="2"/>
                    </StackPanel>

                    <!-- Date range To -->
                    <StackPanel Style="{StaticResource FilterBarItemStyle}" Orientation="Horizontal">
                        <TextBlock Text="To:" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="EndDatePicker"
                                    Width="115"
                                    SelectedDateChanged="EndDatePicker_SelectedDateChanged"
                                    TabIndex="3"/>
                    </StackPanel>

                    <!-- Product filter -->
                    <StackPanel Style="{StaticResource FilterBarItemStyle}" Orientation="Horizontal">
                        <TextBlock Text="Product:" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="FilterProductCombo"
                                  ItemsSource="{Binding FilterProducts}"
                                  SelectedItem="{Binding FilterSelectedProduct}"
                                  Width="160"
                                  TabIndex="4"/>
                    </StackPanel>

                    <!-- Reason filter -->
                    <StackPanel Style="{StaticResource FilterBarItemStyle}" Orientation="Horizontal">
                        <TextBlock Text="Reason:" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="ReasonFilterCombo"
                                  Width="110"
                                  SelectionChanged="ReasonFilterCombo_SelectionChanged"
                                  TabIndex="5">
                            <ComboBoxItem Content="(All Reasons)" Tag="" IsSelected="True"/>
                            <ComboBoxItem Content="Damage" Tag="Damage"/>
                            <ComboBoxItem Content="Spoilage" Tag="Spoilage"/>
                            <ComboBoxItem Content="Expiry" Tag="Expiry"/>
                            <ComboBoxItem Content="Admin Error" Tag="Admin Error"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Refresh Button -->
                    <Button Content="Re_fresh"
                            Command="{Binding LoadDataCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Center" Margin="0,0,12,4"
                            TabIndex="6"/>

                    <!-- Data Freshness Chip -->
                    <views:FreshnessChip LastLoadedAt="{Binding LastLoadedAt}"
                                         RefreshCommand="{Binding LoadDataCommand}"
                                         VerticalAlignment="Center" Margin="0,0,12,4"/>

                    <!-- Status Message -->
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,4"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </WrapPanel>
            </Border>

            <!-- Filter summary bar showing count, active filter chips, and clear all -->
            <views:FilterSummaryBar DockPanel.Dock="Top"
                                    Margin="4,0,4,8"
                                    ShownCount="{Binding FilteredCount}"
                                    TotalCount="{Binding TotalCount}"
                                    ActiveFilters="{Binding ActiveFilterChips}"
                                    ClearAllCommand="{Binding ClearFiltersCommand}"/>

            <!-- ── History DataGrid Container ─────────────────────── -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- ── History DataGrid ───────────────────────────────── -->
                <DataGrid Grid.Row="0" ItemsSource="{Binding HistoryItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" CanUserReorderColumns="False" CanUserResizeRows="False"
                          SelectionUnit="FullRow" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserSortColumns="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          FontSize="12"
                          TabIndex="7">
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Date" Width="130"
                                           SortMemberPath="RecordedDate"
                                           Binding="{Binding RecordedDate, StringFormat={StaticResource FormatDateTime}}"/>

                        <DataGridTextColumn Header="Product" Width="*" MinWidth="140"
                                           Binding="{Binding ProductName}"/>

                        <DataGridTextColumn Header="Qty" Width="55"
                                           HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                           SortMemberPath="QuantityLost"
                                           Binding="{Binding QuantityLost}"
                                           ElementStyle="{StaticResource NumericCellStyle}"/>

                        <DataGridTextColumn Header="Unit Cost" Width="90"
                                           HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                           SortMemberPath="UnitCost"
                                           Binding="{Binding UnitCost, StringFormat={StaticResource FormatCurrency}}"
                                           ElementStyle="{StaticResource NumericCellStyle}"/>

                        <DataGridTextColumn Header="Total Value" Width="100"
                                           HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                           SortMemberPath="TotalValue"
                                           Binding="{Binding TotalValue, StringFormat={StaticResource FormatCurrency}}"
                                           ElementStyle="{StaticResource NumericCellStyle}"/>

                        <!-- Reason column with color coding -->
                        <DataGridTemplateColumn Header="Reason" Width="100" SortMemberPath="Reason" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Reason}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Reason}" Value="Damage">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Reason}" Value="Spoilage">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Reason}" Value="Expiry">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Reason}" Value="Admin Error">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Notes" Width="160"
                                           Binding="{Binding Notes}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Recorded By" Width="110"
                                           Binding="{Binding RecordedBy}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <views:EmptyStatePanel Grid.Row="0" Title="{Binding EmptyStateTitle}"
                                       Description="{Binding EmptyStateDescription}"
                                       ActionCommand="{Binding EmptyStateActionCommand}"
                                       ActionText="{Binding EmptyStateActionText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

                <!-- INFRA-34: incremental keyset paging — appends the next page; virtualization preserved -->
                <Button Grid.Row="1"
                        Content="Load more"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding LoadMoreCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,8"
                        Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}"/>
            </Grid>

        </DockPanel>

        <!-- ═══════════════════════════════════════════════════════════
             RECORD SHRINKAGE DIALOG OVERLAY
             ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="RecordShrinkageDialogOverlay"
              Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVis}}"
              Background="{DynamicResource OverlayBrush}"
              Panel.ZIndex="100"
              IsVisibleChanged="RecordShrinkageDialogOverlay_IsVisibleChanged">

            <Border Style="{StaticResource CardStyle}"
                    Width="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="28,24">

                <StackPanel>

                    <!-- Dialog title -->
                    <TextBlock Text="Record Shrinkage"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,20"/>

                    <!-- Product -->
                    <HeaderedContentControl Header="Product" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="True">
                        <ComboBox x:Name="DialogProductComboBox"
                                  ItemsSource="{Binding DialogProducts}"
                                  SelectedItem="{Binding DialogSelectedProduct, NotifyOnValidationError=True}"
                                  Style="{StaticResource FormCombo}"
                                  TabIndex="8"/>
                    </HeaderedContentControl>
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Select a product to see available stock."/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DialogSelectedProduct}" Value="{x:Null}">
                                        <Setter Property="Text" Value="Select a product to see available stock."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Available stock: "/>
                        <Run Text="{Binding DialogAvailableStock}" FontWeight="SemiBold"/>
                        <Run Text=" units"/>
                    </TextBlock>

                    <!-- Quantity -->
                    <HeaderedContentControl Header="Quantity" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="True">
                        <TextBox x:Name="QuantityBox"
                                 Text="{Binding DialogQuantity, UpdateSourceTrigger=LostFocus, NotifyOnValidationError=True}"
                                 helpers:FormHelper.InputMode="PositiveInteger"
                                 Style="{StaticResource FormInput}"
                                 PreviewTextInput="QuantityBox_PreviewTextInput"
                                 TabIndex="9"/>
                    </HeaderedContentControl>

                    <!-- Reason -->
                    <HeaderedContentControl Header="Reason" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="True">
                        <ComboBox ItemsSource="{Binding ReasonOptions}"
                                  SelectedItem="{Binding DialogReason, NotifyOnValidationError=True}"
                                  Style="{StaticResource FormCombo}"
                                  TabIndex="10"/>
                    </HeaderedContentControl>

                    <!-- Notes -->
                    <HeaderedContentControl Header="Notes (optional)" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="False">
                        <TextBox Text="{Binding DialogNotes, UpdateSourceTrigger=PropertyChanged}" TabIndex="11"
                                 Style="{StaticResource FormInput}"
                                 Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </HeaderedContentControl>

                    <!-- Batch (optional) -->
                    <HeaderedContentControl Header="Batch (optional — leave Auto for FIFO)" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="False">
                        <ComboBox ItemsSource="{Binding DialogBatches}"
                                  SelectedItem="{Binding DialogSelectedBatch}"
                                  Style="{StaticResource FormCombo}"
                                  TabIndex="12"/>
                    </HeaderedContentControl>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="_Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Click="CancelDialogButton_Click"
                                TabIndex="13"/>
                        <Button Content="_Confirm"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="ConfirmRecordButton_Click"
                                TabIndex="14"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

        <views:SkeletonPanel Kind="Rows" IsBusy="{Binding IsBusy}" LastLoadedAt="{Binding LastLoadedAt}" Margin="10"/>

        <views:BusyOverlay IsBusy="{Binding IsBusy}" LastLoadedAt="{Binding LastLoadedAt}"/>

        <views:ErrorStatePanel Title="Load Failed"
                               Message="{Binding ErrorMessage}"
                               RetryCommand="{Binding LoadDataCommand}"
                               Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

    </Grid>

</UserControl>
