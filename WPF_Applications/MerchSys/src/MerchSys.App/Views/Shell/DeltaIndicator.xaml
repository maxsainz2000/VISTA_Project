<UserControl x:Class="Views.Shell.DeltaIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MerchSys.App.Views.Shell"
             mc:Ignorable="d"
             d:DesignHeight="30" d:DesignWidth="100">
    <UserControl.Resources>
        <!-- Style for the Arrow Path -->
        <Style x:Key="ArrowPathStyle" TargetType="Path" BasedOn="{StaticResource IconBase}">
            <Style.Triggers>
                <!-- Direction: Up -->
                <DataTrigger Binding="{Binding Direction, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static local:DeltaDirection.Up}">
                    <Setter Property="Data" Value="{StaticResource IconArrowUpGeometry}"/>
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- Direction: Down -->
                <DataTrigger Binding="{Binding Direction, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static local:DeltaDirection.Down}">
                    <Setter Property="Data" Value="{StaticResource IconArrowDownGeometry}"/>
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- Direction: Flat -->
                <DataTrigger Binding="{Binding Direction, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static local:DeltaDirection.Flat}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style for the Brush of the whole indicator (Path and TextBlock) -->
        <Style x:Key="IndicatorTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Style.Triggers>
                <!-- Up + Normal semantics -> SuccessBrush -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Direction, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static local:DeltaDirection.Up}"/>
                        <Condition Binding="{Binding InvertSemantics, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </MultiDataTrigger>
                <!-- Up + Inverted semantics -> DangerBrush -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Direction, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static local:DeltaDirection.Up}"/>
                        <Condition Binding="{Binding InvertSemantics, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </MultiDataTrigger>
                <!-- Down + Normal semantics -> DangerBrush -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Direction, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static local:DeltaDirection.Down}"/>
                        <Condition Binding="{Binding InvertSemantics, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </MultiDataTrigger>
                <!-- Down + Inverted semantics -> SuccessBrush -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Direction, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static local:DeltaDirection.Down}"/>
                        <Condition Binding="{Binding InvertSemantics, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </MultiDataTrigger>
                <!-- Flat -> TextSecondaryBrush -->
                <DataTrigger Binding="{Binding Direction, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static local:DeltaDirection.Flat}">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IndicatorPathStyle" TargetType="Path" BasedOn="{StaticResource ArrowPathStyle}">
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
            <Style.Triggers>
                <!-- Up + Normal semantics -> SuccessBrush -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Direction, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static local:DeltaDirection.Up}"/>
                        <Condition Binding="{Binding InvertSemantics, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                </MultiDataTrigger>
                <!-- Up + Inverted semantics -> DangerBrush -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Direction, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static local:DeltaDirection.Up}"/>
                        <Condition Binding="{Binding InvertSemantics, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                </MultiDataTrigger>
                <!-- Down + Normal semantics -> DangerBrush -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Direction, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static local:DeltaDirection.Down}"/>
                        <Condition Binding="{Binding InvertSemantics, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                </MultiDataTrigger>
                <!-- Down + Inverted semantics -> SuccessBrush -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Direction, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static local:DeltaDirection.Down}"/>
                        <Condition Binding="{Binding InvertSemantics, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                </MultiDataTrigger>
                <!-- Flat -> TextSecondaryBrush -->
                <DataTrigger Binding="{Binding Direction, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static local:DeltaDirection.Flat}">
                    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Path Style="{StaticResource IndicatorPathStyle}"/>
        <TextBlock Style="{StaticResource IndicatorTextStyle}"
                   Text="{Binding Percent, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={StaticResource FormatPercentSigned}}"/>
    </StackPanel>
</UserControl>
