<UserControl x:Class="Views.Shell.ConnectionStatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MerchSys.App.ViewModels.Shell"
             mc:Ignorable="d"
             d:DesignHeight="28" d:DesignWidth="130">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Retry button — stripped chrome, white text on transparent background -->
        <Style x:Key="RetryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Pill badge -->
    <Border CornerRadius="8"
            Padding="8,4"
            Background="{Binding IndicatorBrush}"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- Filled dot — visible when Online or Offline -->
            <Ellipse Width="8" Height="8"
                     Fill="White"
                     Margin="0,0,5,0"
                     VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReconnecting}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <!-- Dashed ring spinner — visible when Reconnecting -->
            <Ellipse Width="8" Height="8"
                     Stroke="White"
                     StrokeThickness="1.5"
                     StrokeDashArray="2 1"
                     Margin="0,0,5,0"
                     VerticalAlignment="Center"
                     Visibility="Collapsed"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReconnecting}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="SpinnerBegin">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                From="0" To="360"
                                                Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SpinnerBegin"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
                <Ellipse.RenderTransform>
                    <RotateTransform/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- State label -->
            <TextBlock Text="{Binding StatusText}"
                       Foreground="White"
                       FontSize="11"
                       VerticalAlignment="Center"/>

            <!-- Retry button — shown only in Offline state -->
            <Button Content="Retry"
                    Command="{Binding RetryCommand}"
                    Style="{StaticResource RetryButtonStyle}"
                    Margin="4,0,0,0"
                    Visibility="{Binding IsRetryVisible, Converter={StaticResource BoolToVis}}"/>

        </StackPanel>
    </Border>

</UserControl>
