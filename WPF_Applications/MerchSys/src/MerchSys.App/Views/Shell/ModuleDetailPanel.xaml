<UserControl x:Class="Views.Shell.ModuleDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:MerchSys.App.Models"
             xmlns:panels="clr-namespace:MerchSys.App.Views.Shell.Modules"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="220"
             Background="{DynamicResource SidebarBackgroundBrush}">

    <UserControl.Resources>

        <!-- Nav sub-item button — chevron + label, active highlight (macOS sidebar style) -->
        <Style x:Key="NavItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="{DynamicResource RadiusSmall}"
                                Margin="8,2,8,2"
                                ClipToBounds="True">
                            <Grid>
                                <!-- Active Background (macOS style soft pill selection) -->
                                <Border x:Name="ActiveBg"
                                        Background="{DynamicResource SelectionBackgroundBrush}"
                                        Opacity="0"/>
                                <!-- Hover Background -->
                                <Border x:Name="HoverBg"
                                        Background="{DynamicResource HoverBackgroundBrush}"
                                        Opacity="0"/>
                                <!-- Content -->
                                <Border Padding="12,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="Chevron" Text="▸" Margin="0,0,6,0"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="10" VerticalAlignment="Center"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover state transition (~120ms) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <!-- Active selection state trigger -->
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActiveBg"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActiveBg"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                                <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Log Out button style — fades in a hover background and turns Danger on hover -->
        <Style x:Key="LogOutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS-style Toggle Switch Style -->
        <Style x:Key="ThemeToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <!-- Track -->
                            <Border x:Name="Track"
                                    Background="{DynamicResource SeparatorBrush}"
                                    CornerRadius="10"
                                    BorderThickness="0">
                                <Grid>
                                    <!-- Active Accent Track Fill (fades in when checked) -->
                                    <Border x:Name="ActiveTrack"
                                            Background="{DynamicResource AccentBrush}"
                                            CornerRadius="10"
                                            Opacity="0"/>
                                </Grid>
                            </Border>
                            <!-- Sliding Thumb -->
                            <Border x:Name="Thumb"
                                    Width="16" Height="16"
                                    Background="White"
                                    CornerRadius="8"
                                    HorizontalAlignment="Left"
                                    Margin="2,0,2,0"
                                    VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Checked state (Dark Mode active) -->
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Fade track accent color in -->
                                            <DoubleAnimation Storyboard.TargetName="ActiveTrack"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"/>
                                            <!-- Translate thumb to the right -->
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="16" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Fade track accent color out -->
                                            <DoubleAnimation Storyboard.TargetName="ActiveTrack"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                            <!-- Translate thumb back to the left -->
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    </UserControl.Resources>

    <!-- Right border separator separates the sidebar panel from the content canvas -->
    <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,1,0">
        <DockPanel>

            <!-- ── Bottom bar: Log Out + Theme Toggle + Connection Status ───── -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                <Border Height="1" 
                        Background="{DynamicResource SeparatorBrush}" 
                        Margin="12,0,12,0"/>
                
                <!-- Connection status indicator slot — filled by ModuleDetailPanel.xaml.vb -->
                <ContentControl x:Name="ConnectionStatusSlot" 
                                Margin="12,6,12,0" 
                                HorizontalAlignment="Stretch"/>

                <!-- Footer actions: Log Out and Theme Toggle switch -->
                <Grid Margin="12,4,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" 
                            Content="Log Out"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource LogOutButtonStyle}"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Dark Mode" 
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   VerticalAlignment="Center"/>
                        <ToggleButton x:Name="ThemeToggle"
                                      IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                      Command="{Binding ToggleThemeCommand}"
                                      Style="{StaticResource ThemeToggleSwitchStyle}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ── Top: Module name header ─────────────────────────────────── -->
            <Border DockPanel.Dock="Top" Padding="0,10,0,4">
                <StackPanel>
                    <!-- Session identity -->
                    <TextBlock Text="{Binding CurrentUsername}"
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               FontSize="{DynamicResource FontSizeBody}" 
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentRoleDisplay}"
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="{DynamicResource FontSizeCaption}"
                               HorizontalAlignment="Center" 
                               Margin="0,2,0,0"/>
                    <!-- Divider -->
                    <Border Height="1" 
                            Background="{DynamicResource SeparatorBrush}" 
                            Margin="12,8,12,4"/>
                    <!-- Active module name -->
                    <TextBlock Text="{Binding ActiveModuleName}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSizeCaption}" 
                               FontWeight="Bold"
                               Margin="16,0,16,4"/>
                    <!-- Search Affordance Button -->
                    <Button Command="{Binding CommandPalette.OpenCommand}"
                            Style="{StaticResource CleanButtonStyle}"
                            Margin="12,4,12,8"
                            Cursor="Hand"
                            Focusable="False">
                        <Border Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource SeparatorBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Path Grid.Column="0"
                                      Width="12" Height="12"
                                      Margin="0,0,6,0"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Stretch="Uniform"
                                      Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                                
                                <TextBlock Grid.Column="1"
                                           Text="Search..."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           VerticalAlignment="Center"/>
                                
                                <TextBlock Grid.Column="2"
                                           Text="Ctrl+K"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           Opacity="0.7"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ── Nav item list for active module ─────────────────────────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>

                    <!-- Purchasing panel -->
                    <ItemsControl ItemsSource="{Binding PurchasingItems}" Focusable="False">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveModule}"
                                                 Value="{x:Static models:AppModule.Purchasing}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DisplayName}"
                                        Style="{StaticResource NavItemStyle}"
                                        Command="{Binding DataContext.NavigateCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Inventory panel -->
                    <ItemsControl ItemsSource="{Binding InventoryItems}" Focusable="False">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveModule}"
                                                 Value="{x:Static models:AppModule.Inventory}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DisplayName}"
                                        Style="{StaticResource NavItemStyle}"
                                        Command="{Binding DataContext.NavigateCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- POS panel -->
                    <ItemsControl ItemsSource="{Binding PosItems}" Focusable="False">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveModule}"
                                                 Value="{x:Static models:AppModule.POS}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DisplayName}"
                                        Style="{StaticResource NavItemStyle}"
                                        Command="{Binding DataContext.NavigateCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Accounting panel -->
                    <ItemsControl ItemsSource="{Binding AccountingItems}" Focusable="False">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveModule}"
                                                 Value="{x:Static models:AppModule.Accounting}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DisplayName}"
                                        Style="{StaticResource NavItemStyle}"
                                        Command="{Binding DataContext.NavigateCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Developer Tools panel (Debug builds only, Manager role only) -->
                    <panels:DeveloperToolsPanel>
                        <panels:DeveloperToolsPanel.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveModule}"
                                                 Value="{x:Static models:AppModule.DeveloperTools}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </panels:DeveloperToolsPanel.Style>
                    </panels:DeveloperToolsPanel>

                </Grid>
            </ScrollViewer>

        </DockPanel>
    </Border>

</UserControl>
