<UserControl x:Class="Views.Shell.FilterSummaryBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Premium Chip Remove Button Style -->
        <Style x:Key="ChipRemoveButtonStyle" TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Count Label -->
        <TextBlock Text="{Binding ResultCountText, ElementName=Root}"
                   Style="{StaticResource CaptionLabelStyle}"
                   VerticalAlignment="Center"
                   Margin="0,0,16,0"/>

        <!-- Active Filter Chips -->
        <ItemsControl ItemsSource="{Binding ActiveFilters, ElementName=Root}"
                      VerticalAlignment="Center"
                      Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SidebarBackgroundBrush}"
                            BorderBrush="{DynamicResource SeparatorBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8,3"
                            Margin="0,2,8,2"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Button Content="×"
                                    Style="{StaticResource ChipRemoveButtonStyle}"
                                    Command="{Binding RemoveCommand}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Clear All Button -->
        <Button Content="Clear all"
                Style="{StaticResource LinkButtonStyle}"
                Command="{Binding ClearAllCommand, ElementName=Root}"
                Visibility="{Binding HasActiveFilters, ElementName=Root, Converter={StaticResource BoolToVis}}"
                VerticalAlignment="Center"
                FontSize="11"
                Margin="8,0,0,0"/>
    </WrapPanel>
</UserControl>
