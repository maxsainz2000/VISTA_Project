<Window x:Class="Views.Shell.ReportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Report Preview" Width="740" Height="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" x:Name="ReportTitleBlock"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,10"/>

        <!-- Content area -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                Background="{DynamicResource SurfaceBrush}"
                Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="PreviewTextBox"
                         IsReadOnly="True"
                         FontFamily="Courier New" FontSize="11"
                         Padding="12"
                         BorderThickness="0"
                         TextWrapping="NoWrap"
                         Background="Transparent"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         VerticalScrollBarVisibility="Disabled"
                         HorizontalScrollBarVisibility="Disabled"/>
            </ScrollViewer>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Print" x:Name="PrintButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="14,6" Margin="0,0,8,0"
                    Click="PrintButton_Click"
                    TabIndex="1"/>
            <Button Content="Save As..." x:Name="SaveButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="14,6" Margin="0,0,8,0"
                    Click="SaveButton_Click"
                    TabIndex="2"/>
            <Button Content="Close" x:Name="CloseButton"
                    Padding="14,6"
                    Click="CloseButton_Click"
                    TabIndex="3"/>
        </StackPanel>
    </Grid>
</Window>
