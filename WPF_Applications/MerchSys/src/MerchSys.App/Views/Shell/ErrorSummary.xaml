<UserControl x:Class="Views.Shell.ErrorSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="400"
             Visibility="Collapsed"
             IsTabStop="False" Focusable="False">
    
    <Border Background="{DynamicResource SidebarBackgroundBrush}"
            BorderBrush="{DynamicResource DangerBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusSmall}"
            Padding="12,10"
            Margin="0,0,0,12">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Path Style="{StaticResource IconBase}" Data="{StaticResource IconWarningGeometry}"
                      Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                      Fill="{DynamicResource DangerBrush}"/>
                <AccessText Text="Please correct the following errors before saving:"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource DangerBrush}"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSizeBody}"/>
            </StackPanel>
            <ItemsControl x:Name="ErrorsControl" Focusable="False" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="ErrorButton_Click"
                                Style="{StaticResource CleanButtonStyle}"
                                Margin="22,0,0,4"
                                HorizontalAlignment="Left"
                                IsTabStop="False">
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       TextDecorations="Underline"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
