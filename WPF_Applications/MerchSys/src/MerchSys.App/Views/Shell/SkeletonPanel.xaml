<UserControl x:Class="Views.Shell.SkeletonPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MerchSys.App.Views.Shell">
    
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <!-- Show skeleton on IsBusy and LastLoadedAt = null -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsBusy, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding LastLoadedAt, RelativeSource={RelativeSource Self}}" Value="{x:Null}"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid>
        <!-- Cards Template -->
        <DockPanel x:Name="CardsPanel" Margin="0">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Cards">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            
            <!-- Top Dashboard Title Placeholder -->
            <Grid DockPanel.Dock="Top" Height="45" Margin="0,0,0,10">
                <views:SkeletonBlock Width="250" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="4"/>
                <views:SkeletonBlock Width="120" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="4"/>
            </Grid>
            
            <!-- KPI Cards Row -->
            <Grid DockPanel.Dock="Top" Height="90" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <views:SkeletonBlock Grid.Column="0" Margin="0,0,8,0" CornerRadius="8"/>
                <views:SkeletonBlock Grid.Column="1" Margin="0,0,8,0" CornerRadius="8"/>
                <views:SkeletonBlock Grid.Column="2" Margin="0,0,8,0" CornerRadius="8"/>
                <views:SkeletonBlock Grid.Column="3" Margin="0,0,8,0" CornerRadius="8"/>
                <views:SkeletonBlock Grid.Column="4" Margin="0,0,0,0" CornerRadius="8"/>
            </Grid>
            
            <!-- What This Means Box Placeholder -->
            <views:SkeletonBlock DockPanel.Dock="Top" Height="65" Margin="0,0,0,10" CornerRadius="6"/>
            
            <!-- Bottom Chart & Table Split -->
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <views:SkeletonBlock Grid.Column="0" CornerRadius="8"/>
                <views:SkeletonBlock Grid.Column="2" CornerRadius="8"/>
            </Grid>
        </DockPanel>
        
        <!-- Rows Template -->
        <DockPanel x:Name="RowsPanel" Margin="0">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Rows">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            
            <!-- Filter Bar Placeholder -->
            <views:SkeletonBlock DockPanel.Dock="Top" Height="48" Margin="0,0,0,10" CornerRadius="6"/>
            
            <!-- Table Container Placeholder -->
            <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="6">
                <DockPanel Margin="12">
                    <!-- Table Title / Header -->
                    <Grid DockPanel.Dock="Top" Height="30" Margin="0,0,0,12">
                        <views:SkeletonBlock Width="180" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="4"/>
                        <views:SkeletonBlock Width="220" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="4"/>
                    </Grid>
                    
                    <!-- Table Grid Rows -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Table Header -->
                            <RowDefinition Height="35"/>
                            <!-- Table Rows -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header row -->
                        <views:SkeletonBlock Grid.Row="0" Margin="0,0,0,6" CornerRadius="4"/>
                        
                        <!-- Row Silhouettes -->
                        <StackPanel Grid.Row="1" Orientation="Vertical">
                            <views:SkeletonBlock Height="32" Margin="0,4" CornerRadius="4"/>
                            <views:SkeletonBlock Height="32" Margin="0,4" CornerRadius="4"/>
                            <views:SkeletonBlock Height="32" Margin="0,4" CornerRadius="4"/>
                            <views:SkeletonBlock Height="32" Margin="0,4" CornerRadius="4"/>
                            <views:SkeletonBlock Height="32" Margin="0,4" CornerRadius="4"/>
                            <views:SkeletonBlock Height="32" Margin="0,4" CornerRadius="4"/>
                            <views:SkeletonBlock Height="32" Margin="0,4" CornerRadius="4"/>
                            <views:SkeletonBlock Height="32" Margin="0,4" CornerRadius="4"/>
                            <views:SkeletonBlock Height="32" Margin="0,4" CornerRadius="4"/>
                            <views:SkeletonBlock Height="32" Margin="0,4" CornerRadius="4"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
