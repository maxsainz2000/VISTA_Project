<UserControl x:Class="Views.Accounting.FinancialOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vatTiles="clr-namespace:MerchSys.App.Views.Accounting.Components"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="#F5F6FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE6E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE6E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style x:Key="RefreshButton" TargetType="Button">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDC3C7"/>
                    <Setter Property="Foreground" Value="#7F8C8D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AlertCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#EBF5EE"/>
            <Setter Property="BorderBrush" Value="#27AE60"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="AlertValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E8449"/>
        </Style>

        <Style x:Key="AlertLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="10">

        <!-- ═══════════════════════════════════════════════════════════
             TOOLBAR ROW
             ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="White" BorderBrush="#DFE6E9" BorderThickness="1"
                CornerRadius="4" Padding="12,7" Margin="0,0,0,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Financial Overview" FontSize="14" FontWeight="Bold"
                               Foreground="#2C3E50" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Dashboard" FontSize="13" Foreground="#7F8C8D"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding LastRefreshed}"
                               FontSize="10" Foreground="#95A5A6"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Loading…" FontSize="10" Foreground="#7F8C8D"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Refresh" Command="{Binding RefreshCommand}"
                            Style="{StaticResource RefreshButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             KPI CARDS ROW — 7 cards
             ═══════════════════════════════════════════════════════════ -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="{Binding TodayRevenue, StringFormat='₱{0:N0}'}"
                               Style="{StaticResource KpiValue}" Foreground="#2980B9"/>
                    <TextBlock Text="Today Revenue" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="{Binding MonthToDateRevenue, StringFormat='₱{0:N0}'}"
                               Style="{StaticResource KpiValue}" Foreground="#2980B9"/>
                    <TextBlock Text="MTD Revenue" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="{Binding YearToDateRevenue, StringFormat='₱{0:N0}'}"
                               Style="{StaticResource KpiValue}" Foreground="#2C3E50"/>
                    <TextBlock Text="YTD Revenue" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentGrossMargin, StringFormat='{}{0:N1}%'}"
                               Style="{StaticResource KpiValue}" Foreground="#27AE60"/>
                    <TextBlock Text="Gross Margin %" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="{Binding TotalAR, StringFormat='₱{0:N0}'}"
                               Style="{StaticResource KpiValue}" Foreground="#E67E22"/>
                    <TextBlock Text="AR Outstanding" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="5" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="{Binding TotalAP, StringFormat='₱{0:N0}'}"
                               Style="{StaticResource KpiValue}" Foreground="#E74C3C"/>
                    <TextBlock Text="AP Outstanding" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="{Binding InventoryValue, StringFormat='₱{0:N0}'}"
                               Style="{StaticResource KpiValue}" Foreground="#8E44AD"/>
                    <TextBlock Text="Inventory Value" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <vatTiles:VatPayableTile Grid.Column="7" Margin="0"/>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             WHAT THIS MEANS BOX — mandatory, always visible
             ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="#EBF5FB" BorderBrush="#AED6F1" BorderThickness="1"
                CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,12,0">
                    <TextBlock Text="💡" FontSize="22" VerticalAlignment="Top"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="What This Means"
                               FontSize="12" FontWeight="Bold" Foreground="#1A5276"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding WhatThisMeansText}"
                               FontSize="12" Foreground="#1F618D"
                               TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             ALERTS PANEL — bottom
             ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Background="White" BorderBrush="#DFE6E9" BorderThickness="1"
                CornerRadius="6" Padding="14,10" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="Alerts" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal">

                    <!-- Overdue AR -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AlertCard}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOverdueAR}" Value="True">
                                        <Setter Property="Background" Value="#FDEDEC"/>
                                        <Setter Property="BorderBrush" Value="#E74C3C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding OverdueARCount}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AlertValue}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOverdueAR}" Value="True">
                                                <Setter Property="Foreground" Value="#922B21"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Overdue Customer Balances" Style="{StaticResource AlertLabel}"/>
                        </StackPanel>
                    </Border>

                    <!-- Overdue AP -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AlertCard}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOverdueAP}" Value="True">
                                        <Setter Property="Background" Value="#FDF2E9"/>
                                        <Setter Property="BorderBrush" Value="#E67E22"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding OverdueAPCount}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AlertValue}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOverdueAP}" Value="True">
                                                <Setter Property="Foreground" Value="#A04000"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Overdue Supplier Bills" Style="{StaticResource AlertLabel}"/>
                        </StackPanel>
                    </Border>

                    <!-- Low Stock -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AlertCard}">
                                <Setter Property="Margin" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLowStock}" Value="True">
                                        <Setter Property="Background" Value="#FEFCE8"/>
                                        <Setter Property="BorderBrush" Value="#F39C12"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding LowStockAlertCount}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AlertValue}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasLowStock}" Value="True">
                                                <Setter Property="Foreground" Value="#B7950B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Low Stock Products" Style="{StaticResource AlertLabel}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN CONTENT — trend chart (left) + top products (right)
             ═══════════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── 6-Month Trend Chart ────────────────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="6-Month Revenue Trend"
                               Style="{StaticResource SectionHeader}"/>

                    <!-- Legend -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Rectangle Width="12" Height="12" Fill="#2980B9" Margin="0,0,4,0" RadiusX="2" RadiusY="2"/>
                        <TextBlock Text="Revenue" FontSize="10" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Rectangle Width="12" Height="12" Fill="#E74C3C" Margin="0,0,4,0" RadiusX="2" RadiusY="2"/>
                        <TextBlock Text="COGS" FontSize="10" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Rectangle Width="12" Height="12" Fill="#27AE60" Margin="0,0,4,0" RadiusX="2" RadiusY="2"/>
                        <TextBlock Text="Gross Profit" FontSize="10" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Axis label -->
                    <TextBlock DockPanel.Dock="Bottom" Text="← Last 6 Months"
                               FontSize="9" Foreground="#BDC3C7"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>

                    <!-- Bar chart area -->
                    <ItemsControl ItemsSource="{Binding MonthlyTrend}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" Margin="4,0">

                                    <!-- Bars — fixed-height grid, bars are bottom-aligned -->
                                    <Grid Height="130">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Rectangle Grid.Column="0"
                                                   Height="{Binding RevenueBarHeight}"
                                                   VerticalAlignment="Bottom"
                                                   Fill="#2980B9" RadiusX="2" RadiusY="2">
                                            <Rectangle.ToolTip>
                                                <TextBlock Text="{Binding Revenue, StringFormat='Revenue: ₱{0:N2}'}"/>
                                            </Rectangle.ToolTip>
                                        </Rectangle>

                                        <Rectangle Grid.Column="2"
                                                   Height="{Binding COGSBarHeight}"
                                                   VerticalAlignment="Bottom"
                                                   Fill="#E74C3C" RadiusX="2" RadiusY="2">
                                            <Rectangle.ToolTip>
                                                <TextBlock Text="{Binding COGS, StringFormat='COGS: ₱{0:N2}'}"/>
                                            </Rectangle.ToolTip>
                                        </Rectangle>

                                        <Rectangle Grid.Column="4"
                                                   Height="{Binding GrossProfitBarHeight}"
                                                   VerticalAlignment="Bottom"
                                                   Fill="#27AE60" RadiusX="2" RadiusY="2">
                                            <Rectangle.ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding GrossProfit, StringFormat='Gross Profit: ₱{0:N2}'}"/>
                                                    <TextBlock Text="{Binding GrossMarginPercent, StringFormat='Margin: {0:N1}%'}"/>
                                                </StackPanel>
                                            </Rectangle.ToolTip>
                                        </Rectangle>
                                    </Grid>

                                    <!-- Month label -->
                                    <TextBlock Text="{Binding Month}"
                                               FontSize="9" Foreground="#7F8C8D"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- ── Top Products Table ─────────────────────────────── -->
            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Top 10 Products by Revenue"
                               Style="{StaticResource SectionHeader}"/>

                    <DataGrid ItemsSource="{Binding TopProducts}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" CanUserReorderColumns="False" CanUserResizeRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderBrush="#DFE6E9" BorderThickness="1"
                              RowBackground="White" AlternatingRowBackground="#FAFBFC"
                              FontSize="11" CanUserSortColumns="False"
                              SelectionMode="Single">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Product" Width="*" MinWidth="120"
                                               Binding="{Binding ProductName}"/>

                            <DataGridTextColumn Header="Units Sold" Width="72"
                                               Binding="{Binding QuantitySold}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Revenue" Width="88"
                                               Binding="{Binding Revenue, StringFormat='₱{0:N0}'}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="COGS" Width="80"
                                               Binding="{Binding COGS, StringFormat='₱{0:N0}'}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Margin %" Width="70"
                                               Binding="{Binding GrossMarginPercent, StringFormat='{}{0:N1}%'}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

        </Grid>

    </DockPanel>

</UserControl>
