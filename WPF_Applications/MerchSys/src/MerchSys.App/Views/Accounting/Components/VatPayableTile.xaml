<UserControl x:Class="Views.Accounting.Components.VatPayableTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="80" d:DesignWidth="180">

    <Border x:Name="TileBorder"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusSmall}"
            Padding="14,10"
            Margin="0,0,8,0"
            Cursor="Hand">

        <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToVatReturnCommand}"/>
        </Border.InputBindings>

        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVatWarning}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                        <Setter Property="BorderThickness" Value="3,1,1,1"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsVatCritical}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                        <Setter Property="BorderThickness" Value="3,1,1,1"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel>

            <!-- Tax type label (VAT Payable / Percentage Tax) -->
            <TextBlock Text="{Binding VatPayableLabel, FallbackValue='VAT Payable'}"
                       FontSize="10"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextOptions.TextFormattingMode="Display"/>

            <!-- Amount row -->
            <TextBlock FontSize="20" FontWeight="Bold" Margin="0,2,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVatWarning}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsVatCritical}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                <Setter Property="FontWeight" Value="ExtraBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding VatPayable, Converter={StaticResource PesoConverter}, FallbackValue='₱0.00'}"/>
            </TextBlock>

            <!-- Filing due date -->
            <TextBlock FontSize="10"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,2,0,0">
                <Run Text="Due "/>
                <Run Text="{Binding VatFilingDueDate, Converter={StaticResource DateFormatter}, ConverterParameter='MMM d', TargetNullValue=''}"/>
            </TextBlock>

        </StackPanel>
    </Border>
</UserControl>
