<UserControl x:Class="Views.Accounting.Components.VatPayableTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="80" d:DesignWidth="180">

    <Border x:Name="TileBorder"
            Background="White"
            BorderBrush="#DFE6E9"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14,10"
            Margin="0,0,8,0"
            Cursor="Hand">

        <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToVatReturnCommand}"/>
        </Border.InputBindings>

        <!-- Severity DataTriggers: override left border colour -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#DFE6E9"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVatWarning}" Value="True">
                        <Setter Property="BorderBrush" Value="#F39C12"/>
                        <Setter Property="BorderThickness" Value="3,1,1,1"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsVatCritical}" Value="True">
                        <Setter Property="BorderBrush" Value="#E74C3C"/>
                        <Setter Property="BorderThickness" Value="3,1,1,1"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel>

            <!-- Tax type label (VAT Payable / Percentage Tax) -->
            <TextBlock Text="{Binding VatPayableLabel, FallbackValue='VAT Payable'}"
                       FontSize="10"
                       Foreground="#7F8C8D"
                       TextOptions.TextFormattingMode="Display"/>

            <!-- Amount row -->
            <TextBlock FontSize="20" FontWeight="Bold" Margin="0,2,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#2C3E50"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVatWarning}" Value="True">
                                <Setter Property="Foreground" Value="#D68910"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsVatCritical}" Value="True">
                                <Setter Property="Foreground" Value="#E74C3C"/>
                                <Setter Property="FontWeight" Value="ExtraBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="₱"/>
                <Run Text="{Binding VatPayable, StringFormat=N2, FallbackValue='0.00'}"/>
            </TextBlock>

            <!-- Filing due date -->
            <TextBlock Text="{Binding VatFilingDueDate, StringFormat='Due {0:MMM d}', TargetNullValue=''}"
                       FontSize="10"
                       Foreground="#7F8C8D"
                       Margin="0,2,0,0"/>

        </StackPanel>
    </Border>
</UserControl>
