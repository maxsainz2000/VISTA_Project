<UserControl x:Class="Views.Accounting.IncomeStatementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MerchSys.App.Views.Shell"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="LineLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="LineLabelMuted" TargetType="TextBlock" BasedOn="{StaticResource LineLabel}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="LineAmount" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0,5"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="LineAmountMuted" TargetType="TextBlock" BasedOn="{StaticResource LineAmount}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="LineBoldLabel" TargetType="TextBlock" BasedOn="{StaticResource LineLabel}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="LineBoldAmount" TargetType="TextBlock" BasedOn="{StaticResource LineAmount}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="LinePercent" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5,0,5"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
        </Style>

        <Style x:Key="LineBoldPercent" TargetType="TextBlock" BasedOn="{StaticResource LinePercent}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PeriodToggle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <DockPanel Margin="10">

            <!-- ═══════════════════════════════════════════════════════════
                 TOOLBAR ROW
                 ═══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}" Padding="12,7" Margin="0,0,0,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Income Statement" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" — Profit &amp; Loss" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                        <!-- Period Type Toggle -->
                        <TextBlock Text="View:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton Content="Monthly" IsChecked="{Binding IsMonthly, Mode=TwoWay}"
                                     Style="{StaticResource PeriodToggle}"/>
                        <RadioButton Content="Quarterly" IsChecked="{Binding IsQuarterly, Mode=TwoWay}"
                                     Style="{StaticResource PeriodToggle}"/>
                        <RadioButton Content="Annual" IsChecked="{Binding IsAnnual, Mode=TwoWay}"
                                     Style="{StaticResource PeriodToggle}" Margin="0,0,14,0"/>

                        <!-- Month Selector — Monthly only -->
                        <ComboBox ItemsSource="{Binding AvailableMonths}"
                                  SelectedItem="{Binding SelectedMonth, Mode=TwoWay}"
                                  Width="50" Margin="0,0,6,0" FontSize="11" VerticalAlignment="Center"
                                  Visibility="{Binding IsMonthly, Converter={StaticResource BoolToVis}}"/>

                        <!-- Quarter Selector — Quarterly only -->
                        <ComboBox ItemsSource="{Binding AvailableQuarterLabels}"
                                  SelectedItem="{Binding SelectedQuarterLabel, Mode=TwoWay}"
                                  Width="52" Margin="0,0,6,0" FontSize="11" VerticalAlignment="Center"
                                  Visibility="{Binding IsQuarterly, Converter={StaticResource BoolToVis}}"/>

                        <!-- Year Selector — always visible -->
                        <ComboBox ItemsSource="{Binding AvailableYears}"
                                  SelectedItem="{Binding SelectedYear, Mode=TwoWay}"
                                  Width="64" Margin="0,0,12,0" FontSize="11" VerticalAlignment="Center"/>

                        <TextBlock Text="Loading…" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Refresh" Command="{Binding LoadCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" FontWeight="SemiBold"
                                Margin="0,0,8,0"/>

                        <!-- Export buttons — read-only, available to all roles -->
                        <Button Content="Export _CSV"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" FontWeight="SemiBold"
                                Click="ExportCsv_Click"
                                Margin="0,0,6,0"
                                TabIndex="10"
                                AutomationProperties.Name="Export Income Statement to CSV"/>
                        <Button Content="Export _PDF"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" FontWeight="SemiBold"
                                Click="ExportPdf_Click"
                                TabIndex="11"
                                AutomationProperties.Name="Export Income Statement to printable report"/>

                    </StackPanel>
                </Grid>
            </Border>

        <!-- ═══════════════════════════════════════════════════════════
             WHAT THIS MEANS BOX — mandatory, always visible
             ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusSmall}" Padding="14,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,12,0">
                    <Path Style="{StaticResource IconBase}" Data="{StaticResource IconLightbulbGeometry}"
                          Width="22" Height="22" VerticalAlignment="Top"
                          Fill="{DynamicResource AccentBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="What This Means"
                               FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding WhatThisMeansText}"
                               FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN TAB CONTROL
             ═══════════════════════════════════════════════════════════ -->
        <TabControl Background="Transparent" BorderThickness="0">

            <!-- ── Income Statement Tab ──────────────────────────────── -->
            <TabItem Header="Income Statement" FontSize="12">
                <Border Style="{StaticResource CardStyle}" CornerRadius="{DynamicResource RadiusSmall}" Padding="14,12" Margin="0,6,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                             <!-- Period subtitle -->
                             <TextBlock Text="{Binding PeriodDescription}"
                                        FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                        Margin="0,0,0,14"/>

                            <!-- P&L Grid -->
                            <Grid MaxWidth="580" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="148"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- 0: Net Sales -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- 1: Less COGS -->
                                    <RowDefinition Height="6"/>
                                    <!-- 2: spacer -->
                                    <RowDefinition Height="1"/>
                                    <!-- 3: separator -->
                                    <RowDefinition Height="6"/>
                                    <!-- 4: spacer -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- 5: Gross Profit -->
                                    <RowDefinition Height="10"/>
                                    <!-- 6: spacer -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- 7: Less Op Expenses -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- 8: Shrinkage Loss -->
                                    <RowDefinition Height="6"/>
                                    <!-- 9: spacer -->
                                    <RowDefinition Height="1"/>
                                    <!-- 10: separator -->
                                    <RowDefinition Height="6"/>
                                    <!-- 11: spacer -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- 12: Net Income -->
                                </Grid.RowDefinitions>

                                <!-- Row 0: Net Sales -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Net Sales"
                                           Style="{StaticResource LineLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding NetSalesDisplay}"
                                           Style="{StaticResource LineAmount}"/>

                                <!-- Row 1: Less COGS -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Less: Cost of Goods Sold"
                                           Style="{StaticResource LineLabelMuted}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding COGSDisplay}"
                                           Style="{StaticResource LineAmountMuted}"/>

                                <!-- Row 3: Separator -->
                                <Rectangle Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                           Fill="{DynamicResource SeparatorBrush}" Height="1"/>

                                <!-- Row 5: Gross Profit -->
                                <TextBlock Grid.Row="5" Grid.Column="0"
                                           Text="Gross Profit"
                                           Style="{StaticResource LineBoldLabel}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1"
                                           Text="{Binding GrossProfitDisplay}"
                                           Style="{StaticResource LineBoldAmount}"/>
                                <TextBlock Grid.Row="5" Grid.Column="2"
                                           Text="{Binding GrossMarginPercent, StringFormat={StaticResource FormatPercent}}"
                                           Style="{StaticResource LineBoldPercent}"/>

                                <!-- Row 7: Less Operating Expenses -->
                                <TextBlock Grid.Row="7" Grid.Column="0"
                                           Text="Less: Operating Expenses"
                                           Style="{StaticResource LineLabelMuted}"/>
                                <TextBlock Grid.Row="7" Grid.Column="1"
                                           Text="{Binding OperatingExpensesDisplay}"
                                           Style="{StaticResource LineAmountMuted}"/>

                                <!-- Row 8: Shrinkage Loss (indented) -->
                                <TextBlock Grid.Row="8" Grid.Column="0"
                                           Text="Shrinkage Loss"
                                           Style="{StaticResource LineLabelMuted}"
                                           Margin="20,0,0,0"/>
                                <TextBlock Grid.Row="8" Grid.Column="1"
                                           Text="{Binding ShrinkageLossDisplay}"
                                           Style="{StaticResource LineAmountMuted}"/>

                                <!-- Row 10: Separator -->
                                <Rectangle Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3"
                                           Fill="{DynamicResource SeparatorBrush}" Height="1"/>

                                <TextBlock Grid.Row="12" Grid.Column="0"
                                           Text="Net Income"
                                           Style="{StaticResource LineBoldLabel}"/>
                                <TextBlock Grid.Row="12" Grid.Column="1"
                                           Text="{Binding NetIncomeDisplay}"
                                           Style="{StaticResource LineBoldAmount}"/>
                                <TextBlock Grid.Row="12" Grid.Column="2"
                                           Text="{Binding NetMarginPercent, StringFormat={StaticResource FormatPercent}}"
                                           Style="{StaticResource LineBoldPercent}"/>

                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ── Per-Product Margins Tab ───────────────────────────── -->
            <TabItem Header="Per-Product Margins" FontSize="12">
                <Border Style="{StaticResource CardStyle}" CornerRadius="{DynamicResource RadiusSmall}" Padding="14,12" Margin="0,6,0,0">
                    <Grid>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Products sorted by gross margin — lowest first to identify underperformers."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                            <DataGrid ItemsSource="{Binding ProductMargins}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True" CanUserReorderColumns="False" CanUserResizeRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                      RowBackground="{DynamicResource SurfaceBrush}" AlternatingRowBackground="{DynamicResource SidebarBackgroundBrush}"
                                      RowStyle="{StaticResource SemanticRowStyle}"
                                      FontSize="11" CanUserSortColumns="True"
                                      SelectionMode="Single">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Product" Width="*" MinWidth="140"
                                                       Binding="{Binding ProductName}"/>

                                    <DataGridTextColumn Header="Revenue" Width="110"
                                                       HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                       Binding="{Binding Revenue, StringFormat={StaticResource FormatCurrency}}"
                                                       ElementStyle="{StaticResource NumericCellStyle}"/>

                                    <DataGridTextColumn Header="COGS" Width="110"
                                                       HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                       Binding="{Binding COGS, StringFormat={StaticResource FormatCurrency}}"
                                                       ElementStyle="{StaticResource NumericCellStyle}"/>

                                    <DataGridTextColumn Header="Gross Profit" Width="110"
                                                       HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                       Binding="{Binding GrossProfit, StringFormat={StaticResource FormatCurrency}}"
                                                       ElementStyle="{StaticResource NumericCellStyle}"/>

                                    <DataGridTextColumn Header="Margin %" Width="80"
                                                       HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                       Binding="{Binding GrossMarginPercent, StringFormat={StaticResource FormatPercent}}"
                                                       ElementStyle="{StaticResource NumericCellStyle}"/>

                                    <DataGridTextColumn Header="Units Sold" Width="84"
                                                       HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                       Binding="{Binding UnitsSold, StringFormat={StaticResource FormatQuantityInt}}"
                                                       ElementStyle="{StaticResource NumericCellStyle}"/>

                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- Empty State Panel overlayed when no margins exist -->
                        <views:EmptyStatePanel Title="No Product Margin Data"
                                               Description="There are no product margin records to display for this period."
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>

    </DockPanel>

    <!-- Busy Overlay overlaying the entire view -->
    <views:BusyOverlay Message="Loading income statement..."
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

    <views:ErrorStatePanel Title="Load Failed"
                           Message="{Binding ErrorMessage}"
                           RetryCommand="{Binding LoadCommand}"
                           Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Grid>
</UserControl>
