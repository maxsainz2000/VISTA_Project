<UserControl x:Class="Views.Accounting.TamperAuditReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="#F5F6FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE6E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="ApplyButton" TargetType="Button">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDC3C7"/>
                    <Setter Property="Foreground" Value="#7F8C8D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeverityCritical" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C0392B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="AuditDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F0F0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/>
            <Setter Property="BorderBrush" Value="#DFE6E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Tamper Audit Report"
                       FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Review receipt integrity violations detected by the POS tamper audit system."
                       FontSize="12" Foreground="#7F8C8D" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Date range filter bar -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="From:" Style="{StaticResource FilterLabel}"/>
                <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}"
                            Width="130" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="To:" Style="{StaticResource FilterLabel}"/>
                <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay}"
                            Width="130" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="Apply Filter"
                        Style="{StaticResource ApplyButton}"
                        Command="{Binding LoadCommand}"/>
                <Button Content="Export to CSV"
                        Style="{StaticResource ApplyButton}"
                        Margin="16,0,0,0"
                        IsEnabled="{Binding HasEntries}"
                        Click="ExportCsv_Click"/>
                <Button Content="Export to PDF"
                        Style="{StaticResource ApplyButton}"
                        Margin="8,0,0,0"
                        IsEnabled="{Binding HasEntries}"
                        Click="ExportPdf_Click"/>
                <TextBlock Text="Loading…"
                           VerticalAlignment="Center" FontSize="12" Foreground="#7F8C8D"
                           Margin="16,0,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- Empty state banner — shown when loaded and no incidents found -->
        <Border Grid.Row="2"
                Visibility="{Binding HasNoEntries, Converter={StaticResource BoolToVis}}"
                Background="#EAF4FB" BorderBrush="#AED6F1" BorderThickness="1"
                CornerRadius="6" Padding="16,12" Margin="0,0,0,12">
            <TextBlock Text="No tamper incidents detected in the selected period."
                       FontSize="13" Foreground="#1A5276" VerticalAlignment="Center"/>
        </Border>

        <!-- Incident DataGrid — shown when entries exist -->
        <Border Grid.Row="3" Style="{StaticResource SectionCard}" Padding="0"
                Visibility="{Binding HasEntries, Converter={StaticResource BoolToVis}}">
            <DataGrid Style="{StaticResource AuditDataGrid}"
                      ItemsSource="{Binding Entries}">
                <DataGrid.Columns>

                    <DataGridTextColumn Header="Date / Time Detected"
                                        Binding="{Binding DetectedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                        Width="180" MinWidth="160"/>

                    <DataGridTextColumn Header="Receipt Number"
                                        Binding="{Binding ReceiptNumber}"
                                        Width="140" MinWidth="120"/>

                    <DataGridTemplateColumn Header="Expected Hash" Width="160" MinWidth="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ExpectedHashShort}"
                                           ToolTip="{Binding ExpectedHash}"
                                           FontFamily="Consolas" FontSize="12"
                                           Padding="4,2" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Actual Hash" Width="160" MinWidth="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ActualHashShort}"
                                           ToolTip="{Binding ActualHash}"
                                           FontFamily="Consolas" FontSize="12"
                                           Padding="4,2" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Severity" Width="100" MinWidth="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Severity}"
                                           Style="{StaticResource SeverityCritical}"
                                           Padding="4,2" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Details"
                                        Binding="{Binding Details}"
                                        Width="*" MinWidth="120"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>
