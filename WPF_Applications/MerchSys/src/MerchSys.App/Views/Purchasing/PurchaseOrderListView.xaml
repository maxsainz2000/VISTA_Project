<UserControl x:Class="Views.Purchasing.PurchaseOrderListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MerchSys.App.Views.Shell"
             xmlns:helpers="clr-namespace:MerchSys.App.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="{DynamicResource WindowBackgroundBrush}"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <DockPanel Margin="10">

        <!-- ═══════════════════════════════════════════════════════════
             FILTER / TOOLBAR ROW
             ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource FilterBarStyle}" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Status Filter -->
                    <StackPanel Style="{StaticResource FilterBarItemStyle}" Orientation="Horizontal">
                        <TextBlock Text="Status:" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding SelectedStatus}"
                                  Width="130"
                                  Padding="6,4" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Search Filter -->
                    <StackPanel Style="{StaticResource FilterBarItemStyle}" Orientation="Horizontal">
                        <TextBlock Text="Search:" Style="{StaticResource CaptionLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200"
                                 Padding="6,4"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Action buttons — hidden from Owner (IsManager = False) -->
                    <StackPanel Style="{StaticResource FilterBarItemStyle}" Orientation="Horizontal"
                                Visibility="{Binding IsManager, Converter={StaticResource BoolToVis}}">
                        <Button Content="_New PO"
                                Command="{Binding NewPOCommand}"
                                Style="{StaticResource SuccessButtonStyle}"
                                Margin="0,0,6,0"
                                TabIndex="1"/>
                        <Button Content="_Edit"
                                Command="{Binding EditPOCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,6,0"
                                TabIndex="2"/>
                        <Button Content="_Submit"
                                Command="{Binding SubmitPOCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,6,0"
                                TabIndex="3"/>
                        <Button Content="_Delete"
                                Command="{Binding DeletePOCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Margin="0"
                                TabIndex="4"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Data Freshness Chip -->
                <views:FreshnessChip Grid.Column="1"
                                     LastLoadedAt="{Binding LastLoadedAt}"
                                     RefreshCommand="{Binding RefreshCommand}"
                                     VerticalAlignment="Center"
                                     Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             STATUS BAR
             ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Padding="8,3" Margin="0,0,0,4">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource CaptionLabelStyle}"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             EDITOR PANEL — visible when IsEditorOpen = True
             ═══════════════════════════════════════════════════════════ -->
        <Border x:Name="EditorPanelOverlay"
                DockPanel.Dock="Bottom"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusSmall}" Margin="0,6,0,0" MinHeight="280"
                IsVisibleChanged="EditorPanelOverlay_IsVisibleChanged">
            <DockPanel Margin="12,10">

                <!-- Editor Header Row -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Editor.EditorTitle}"
                               Style="{StaticResource SectionHeaderStyle}"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="_Save Draft"
                                Command="{Binding SaveDraftCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                TabIndex="15"/>
                        <Button Content="Su_bmit PO"
                                Command="{Binding SubmitEditorCommand}"
                                Style="{StaticResource SuccessButtonStyle}"
                                TabIndex="16"/>
                        <Button Content="_Cancel"
                                Command="{Binding CancelEditorCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0"
                                TabIndex="17"/>
                    </StackPanel>
                </Grid>

                <views:ErrorSummary TargetContainer="{Binding ElementName=EditorPanelOverlay}" Margin="0,0,0,8" DockPanel.Dock="Top"/>

                <!-- Header Fields Row -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <HeaderedContentControl Grid.Column="0" Header="Vendor" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="True">
                        <ComboBox x:Name="VendorComboBox"
                                  ItemsSource="{Binding Editor.Vendors}"
                                  SelectedItem="{Binding Editor.SelectedVendor, NotifyOnValidationError=True}"
                                  DisplayMemberPath="Name"
                                  Padding="6,4" VerticalContentAlignment="Center"
                                  TabIndex="7"/>
                    </HeaderedContentControl>

                    <HeaderedContentControl Grid.Column="2" Header="Expected Delivery" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="True">
                        <DatePicker SelectedDate="{Binding Editor.ExpectedDeliveryDate, NotifyOnValidationError=True}"
                                    TabIndex="8"/>
                    </HeaderedContentControl>

                    <HeaderedContentControl Grid.Column="4" Header="Notes" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="False">
                        <TextBox Text="{Binding Editor.Notes, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"
                                 Padding="6,3" VerticalContentAlignment="Center"
                                 TabIndex="9"/>
                    </HeaderedContentControl>
                </Grid>

                <!-- Line Items toolbar -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Line Items" Style="{StaticResource SectionHeaderStyle}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="+ Add Line"
                                Command="{Binding Editor.AddLineCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,3" FontSize="11" Margin="0,0,3,0"
                                TabIndex="10"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center">
                        <Run Text="Running Total: "/>
                        <Run Text="{Binding Editor.TotalAmount, Converter={StaticResource PesoConverter}, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>

                <!-- Line Items DataGrid -->
                <DataGrid x:Name="LineItemsGrid"
                          TabIndex="11"
                          ItemsSource="{Binding Editor.LineItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" CanUserResizeRows="False"
                          IsReadOnly="False"
                          SelectionUnit="FullRow" SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                          HeadersVisibility="Column"
                          Background="{DynamicResource SurfaceBrush}"
                          AlternatingRowBackground="{DynamicResource WindowBackgroundBrush}"
                          FontSize="{DynamicResource FontSizeBody}">
                    <DataGrid.RowStyle>
                        <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource SemanticRowStyle}"/>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Product" Width="*" MinWidth="200">
                             <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProductName}" Padding="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Editor.VendorCatalog,
                                                           RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               SelectedValue="{Binding ProductId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               SelectedValuePath="ProductId"
                                               DisplayMemberPath="ProductName"
                                               IsSynchronizedWithCurrentItem="False"
                                               Padding="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Qty" Width="70"
                                            HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                            Binding="{Binding QuantityOrdered, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={StaticResource FormatQuantity}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Unit Cost" Width="100"
                                            HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                            Binding="{Binding UnitCost, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={StaticResource FormatQuantity}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Line Total" Width="110"
                                            IsReadOnly="True"
                                            HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                            Binding="{Binding LineTotal, StringFormat={StaticResource FormatCurrency}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Per-row Remove button -->
                        <DataGridTemplateColumn Header="" Width="70" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove"
                                            FontSize="10" Padding="4,2"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Command="{Binding DataContext.Editor.RemoveLineCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN PO LIST DATAGRID
             ═══════════════════════════════════════════════════════════ -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}">
            <DockPanel Margin="12">

                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Purchase Orders" Style="{StaticResource SectionHeaderStyle}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Status legend -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" Margin="0,0,3,0" CornerRadius="2"/>
                    <TextBlock Text="Draft" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,3,0" CornerRadius="2"/>
                    <TextBlock Text="Submitted" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" Margin="0,0,3,0" CornerRadius="2"/>
                    <TextBlock Text="Received" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" Margin="0,0,3,0" CornerRadius="2"/>
                    <TextBlock Text="Verified" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" Margin="0,0,3,0" CornerRadius="2"/>
                    <TextBlock Text="Closed" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid>
                    <DataGrid x:Name="POGrid"
                              TabIndex="6"
                              ItemsSource="{Binding Orders}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserResizeRows="False"
                              IsReadOnly="True"
                              SelectionUnit="FullRow" SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                              HeadersVisibility="Column"
                              CanUserSortColumns="True"
                              Background="{DynamicResource SurfaceBrush}"
                              AlternatingRowBackground="{DynamicResource WindowBackgroundBrush}"
                              FontSize="{DynamicResource FontSizeBody}">
                        <DataGrid.RowStyle>
                            <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource SemanticRowStyle}"/>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Order Number" Width="130"
                                                Binding="{Binding OrderNumber}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Vendor" Width="*" MinWidth="150"
                                                Binding="{Binding VendorName}"/>

                            <!-- Status badge -->
                            <DataGridTemplateColumn Header="Status" Width="100"
                                                    SortMemberPath="Status" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Margin="4,2" Padding="5,2" HorizontalAlignment="Center"
                                                Background="{DynamicResource SidebarBackgroundBrush}" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Submitted">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Received">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Verified">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Closed">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Submitted">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Received">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Verified">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Closed">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Order Date" Width="105"
                                                SortMemberPath="OrderDate"
                                                Binding="{Binding OrderDate, StringFormat={StaticResource FormatDate}}"/>

                            <DataGridTextColumn Header="Expected Delivery" Width="120"
                                                SortMemberPath="ExpectedDeliveryDate"
                                                Binding="{Binding ExpectedDeliveryDate, StringFormat={StaticResource FormatDate}}"/>

                            <DataGridTextColumn Header="Total Amount" Width="110"
                                                SortMemberPath="TotalAmount"
                                                HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                Binding="{Binding TotalAmount, StringFormat={StaticResource FormatCurrency}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <views:EmptyStatePanel Title="No Purchase Orders"
                                           Description="There are no purchase orders found matching the filter."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                                           ActionCommand="{Binding NewPOCommand}"
                                           ActionText="New PO"/>

                    <views:BusyOverlay Message="Loading purchase orders..."
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                    <views:ErrorStatePanel Title="Load Failed"
                                           Message="{Binding ErrorMessage}"
                                           RetryCommand="{Binding RefreshCommand}"
                                           Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </DockPanel>
        </Border>

    </DockPanel>
</UserControl>
