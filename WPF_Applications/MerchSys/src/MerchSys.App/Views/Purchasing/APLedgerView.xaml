<UserControl x:Class="Views.Purchasing.APLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MerchSys.App.Views.Shell"
             xmlns:helpers="clr-namespace:MerchSys.App.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="1200"
             Background="{DynamicResource WindowBackgroundBrush}"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Tab/Filter toggle buttons — inactive state -->
        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Row coloring based on overdue/paid status -->
        <Style x:Key="APRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource SemanticRowStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding VendorName, StringFormat='Invoice for \{0\}'}"/>
            <Setter Property="AutomationProperties.HelpText" Value="{Binding OutstandingBalance, StringFormat='Outstanding balance \{0:C\}'}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPaid}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Root grid enables the payment dialog overlay -->
    <Grid>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN CONTENT
             ═══════════════════════════════════════════════════════════ -->
        <DockPanel Margin="10">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsBusy}" Value="True"/>
                                <Condition Binding="{Binding LastLoadedAt}" Value="{x:Null}"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <!-- SUMMARY HEADER ───────────────────────────────────────── -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}" Padding="16,12" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Accounts Payable Ledger"
                               Style="{StaticResource PageTitleStyle}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Total Outstanding:" Style="{StaticResource CaptionLabelStyle}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TotalOutstanding, StringFormat={StaticResource FormatCurrency}}"
                                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- FILTER TOOLBAR ───────────────────────────────────────── -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status filter buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Filter:" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0"/>

                        <Button Content="All" IsTabStop="False"
                                Command="{Binding SetFilterCommand}" CommandParameter="All">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAllFilterActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Outstanding" IsTabStop="False"
                                Command="{Binding SetFilterCommand}" CommandParameter="Outstanding">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOutstandingFilterActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Overdue" IsTabStop="False"
                                Command="{Binding SetFilterCommand}" CommandParameter="Overdue">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdueFilterActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Paid" IsTabStop="False"
                                Command="{Binding SetFilterCommand}" CommandParameter="Paid">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaidFilterActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Vendor filter dropdown -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="16,0">
                        <TextBlock Text="Vendor:" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding VendorItems}"
                                  SelectedItem="{Binding SelectedVendorItem}"
                                  DisplayMemberPath="DisplayName"
                                  Width="200" Padding="8,5"
                                  VerticalContentAlignment="Center"
                                  FontSize="12"
                                  IsTabStop="False"/>
                    </StackPanel>

                    <!-- Record Payment + Refresh -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <views:FreshnessChip LastLoadedAt="{Binding LastLoadedAt}"
                                             RefreshCommand="{Binding RefreshCommand}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"/>
                        <Button Content="_Record Payment"
                                Command="{Binding OpenPaymentDialogCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="{Binding CanEdit}"
                                Margin="0,0,8,0"
                                TabIndex="1"/>
                        <Button Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                TabIndex="2">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconBase}" Data="{StaticResource IconRefreshGeometry}"
                                      Width="13" Height="13" Margin="0,0,6,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <AccessText Text="Re_fresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- STATUS BAR ────────────────────────────────────────────── -->
            <Border DockPanel.Dock="Top" Padding="8,3" Margin="0,0,0,4">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource CaptionLabelStyle}"/>
                </Grid>
            </Border>

            <!-- ROW LEGEND ────────────────────────────────────────────── -->
            <Border DockPanel.Dock="Top" Padding="8,4" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                    <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1" CornerRadius="2" Margin="0,0,4,0"/>
                    <TextBlock Text="Overdue" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource SuccessBrush}"
                            BorderThickness="1" CornerRadius="2" Margin="0,0,4,0"/>
                    <TextBlock Text="Paid" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Filter summary bar showing count, active filter chips, and clear all -->
            <views:FilterSummaryBar DockPanel.Dock="Top"
                                    Margin="4,0,4,8"
                                    ShownCount="{Binding Entries.Count}"
                                    TotalCount="{Binding TotalAPRows}"
                                    ActiveFilters="{Binding ActiveFilterChips}"
                                    ClearAllCommand="{Binding ClearFiltersCommand}"/>

            <!-- AP LEDGER GRID ────────────────────────────────────────── -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}">
                <Grid>
                    <DataGrid x:Name="APGrid"
                              TabIndex="3"
                              ItemsSource="{Binding Entries}"
                              SelectedItem="{Binding SelectedEntry}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserResizeRows="False"
                              IsReadOnly="True"
                              SelectionUnit="FullRow" SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              RowStyle="{StaticResource APRowStyle}"
                              Background="{DynamicResource SurfaceBrush}"
                              AlternatingRowBackground="{DynamicResource WindowBackgroundBrush}"
                              FontSize="{DynamicResource FontSizeBody}" Margin="1">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Vendor" Width="140" MinWidth="110"
                                                Binding="{Binding VendorName}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Invoice #" Width="120"
                                                Binding="{Binding InvoiceNumber}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="PO Number" Width="110"
                                                Binding="{Binding PurchaseOrderNumber}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Invoice Date" Width="105"
                                                Binding="{Binding InvoiceDate, StringFormat={StaticResource FormatDate}}"/>

                            <DataGridTextColumn Header="Due Date" Width="105"
                                                Binding="{Binding DueDate, StringFormat={StaticResource FormatDate}}"/>

                            <DataGridTextColumn Header="Total Amt" Width="110"
                                                Binding="{Binding TotalAmount, StringFormat={StaticResource FormatCurrency}}"
                                                HeaderStyle="{StaticResource RightAlignedHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Outstanding" Width="110"
                                                Binding="{Binding OutstandingBalance, StringFormat={StaticResource FormatCurrency}}"
                                                HeaderStyle="{StaticResource RightAlignedHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <views:EmptyStatePanel Title="No Entries"
                                           Description="There are no accounts payable ledger entries available."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

        </DockPanel>

        <views:SkeletonPanel Kind="Rows" IsBusy="{Binding IsBusy}" LastLoadedAt="{Binding LastLoadedAt}" Margin="10"/>

        <views:BusyOverlay IsBusy="{Binding IsBusy}" LastLoadedAt="{Binding LastLoadedAt}"/>

        <views:ErrorStatePanel Title="Load Failed"
                               Message="{Binding ErrorMessage}"
                               RetryCommand="{Binding RefreshCommand}"
                               Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- ═══════════════════════════════════════════════════════════
             PAYMENT DIALOG OVERLAY
             ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="PaymentDialogOverlay"
              Visibility="{Binding IsPaymentDialogOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="10"
              IsVisibleChanged="PaymentDialogOverlay_IsVisibleChanged">

            <!-- Semi-transparent backdrop -->
            <Rectangle Fill="{DynamicResource OverlayBrush}"/>

            <!-- Dialog card -->
            <Border Style="{StaticResource CardStyle}" Padding="28,24"
                    MaxWidth="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">

                <StackPanel MinWidth="340">

                    <TextBlock Text="Record Payment" Style="{StaticResource SectionHeaderStyle}"
                               FontSize="16" Margin="0,0,0,20"/>

                    <!-- Invoice details -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Vendor:"
                                   Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding PaymentDialogVendorName}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Invoice:"
                                   Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding PaymentDialogInvoice}"
                                   FontFamily="Consolas" Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Balance:"
                                   Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Text="{Binding PaymentDialogBalance, StringFormat={StaticResource FormatCurrency}}"
                                   FontWeight="Bold" FontSize="15" Foreground="{DynamicResource DangerBrush}"/>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,0,0,16"/>

                    <!-- Payment amount input -->
                    <HeaderedContentControl Header="Payment Amount" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="True">
                        <TextBox x:Name="PaymentAmountInputTextBox"
                                 Text="{Binding PaymentAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 helpers:FormHelper.InputMode="PositiveDecimal"
                                 Padding="10,8" FontSize="14"
                                 TabIndex="4"/>
                    </HeaderedContentControl>

                    <!-- Error message -->
                    <Border Visibility="{Binding HasPaymentError, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            CornerRadius="3" Padding="10,6" Margin="0,8,0,0">
                        <TextBlock Text="{Binding PaymentError}"
                                   Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="_Cancel" IsCancel="True"
                                Command="{Binding CancelPaymentCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,10,0"
                                TabIndex="5"/>
                        <Button Content="_Confirm Payment" IsDefault="True"
                                Command="{Binding ConfirmPaymentCommand}"
                                Style="{StaticResource SuccessButtonStyle}"
                                TabIndex="6"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
