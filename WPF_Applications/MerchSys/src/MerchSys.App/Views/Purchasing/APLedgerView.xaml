<UserControl x:Class="Views.Purchasing.APLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="1200"
             Background="#F5F6FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Filter toggle buttons — inactive state -->
        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Background" Value="#ECF0F1"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D5D8DC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Active filter button -->
        <Style x:Key="FilterButtonActive" TargetType="Button" BasedOn="{StaticResource FilterButton}">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2471A3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDC3C7"/>
                    <Setter Property="Foreground" Value="#7F8C8D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConfirmButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Padding" Value="18,6"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDC3C7"/>
                    <Setter Property="Foreground" Value="#7F8C8D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#ECF0F1"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D5D8DC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Row coloring based on overdue/paid status -->
        <Style x:Key="APRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter Property="Background" Value="#FEF5E4"/>
                    <Setter Property="BorderBrush" Value="#E67E22"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPaid}" Value="True">
                    <Setter Property="Background" Value="#EAFAF1"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6EAF8"/>
                    <Setter Property="BorderBrush" Value="#2980B9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Root grid enables the payment dialog overlay -->
    <Grid>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN CONTENT
             ═══════════════════════════════════════════════════════════ -->
        <DockPanel Margin="10">

            <!-- SUMMARY HEADER ───────────────────────────────────────── -->
            <Border DockPanel.Dock="Top"
                    Background="White" BorderBrush="#DFE6E9" BorderThickness="1"
                    CornerRadius="4" Padding="16,12" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Accounts Payable Ledger"
                               FontSize="16" FontWeight="Bold" Foreground="#2C3E50"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Total Outstanding:" FontSize="12" Foreground="#7F8C8D"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TotalOutstanding, StringFormat='₱{0:N2}'}"
                                   FontSize="18" FontWeight="Bold" Foreground="#E74C3C"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- FILTER TOOLBAR ───────────────────────────────────────── -->
            <Border DockPanel.Dock="Top"
                    Background="White" BorderBrush="#DFE6E9" BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status filter buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Filter:" Style="{StaticResource FieldLabel}" FontSize="12"/>

                        <Button Content="All"
                                Command="{Binding SetFilterCommand}" CommandParameter="All">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAllFilterActive}" Value="True">
                                            <Setter Property="Background" Value="#2980B9"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Outstanding"
                                Command="{Binding SetFilterCommand}" CommandParameter="Outstanding">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOutstandingFilterActive}" Value="True">
                                            <Setter Property="Background" Value="#2980B9"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Overdue"
                                Command="{Binding SetFilterCommand}" CommandParameter="Overdue">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdueFilterActive}" Value="True">
                                            <Setter Property="Background" Value="#E67E22"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Paid"
                                Command="{Binding SetFilterCommand}" CommandParameter="Paid">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaidFilterActive}" Value="True">
                                            <Setter Property="Background" Value="#27AE60"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Vendor filter dropdown -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="16,0">
                        <TextBlock Text="Vendor:" Style="{StaticResource FieldLabel}" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding VendorItems}"
                                  SelectedItem="{Binding SelectedVendorItem}"
                                  DisplayMemberPath="DisplayName"
                                  Width="200" Padding="8,5"
                                  VerticalContentAlignment="Center"
                                  BorderBrush="#BDC3C7" FontSize="12"/>
                    </StackPanel>

                    <!-- Record Payment + Refresh -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Record Payment"
                                Command="{Binding OpenPaymentDialogCommand}"
                                Style="{StaticResource ActionButton}"
                                Margin="0,0,8,0"/>
                        <Button Content="↻ Refresh"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- STATUS BAR ────────────────────────────────────────────── -->
            <Border DockPanel.Dock="Top" Padding="8,3" Margin="0,0,0,4">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                    <TextBlock Text="Loading…" HorizontalAlignment="Right"
                               FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <!-- ROW LEGEND ────────────────────────────────────────────── -->
            <Border DockPanel.Dock="Top" Padding="8,4" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                    <Border Width="14" Height="14" Background="#FEF5E4" BorderBrush="#E67E22"
                            BorderThickness="1" CornerRadius="2" Margin="0,0,4,0"/>
                    <TextBlock Text="Overdue" FontSize="10" Foreground="#7F8C8D"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Border Width="14" Height="14" Background="#EAFAF1" BorderBrush="#27AE60"
                            BorderThickness="1" CornerRadius="2" Margin="0,0,4,0"/>
                    <TextBlock Text="Paid" FontSize="10" Foreground="#7F8C8D"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- AP LEDGER GRID ────────────────────────────────────────── -->
            <Border Background="White" BorderBrush="#DFE6E9" BorderThickness="1" CornerRadius="4">
                <DataGrid x:Name="APGrid"
                          ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" CanUserResizeRows="False"
                          IsReadOnly="True"
                          SelectionUnit="FullRow" SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          RowStyle="{StaticResource APRowStyle}"
                          RowBackground="White" AlternatingRowBackground="#FAFBFC"
                          FontSize="12" Margin="1">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Vendor" Width="140" MinWidth="110"
                                            Binding="{Binding VendorName}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#2C3E50"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Invoice #" Width="120"
                                            Binding="{Binding InvoiceNumber}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Invoice Date" Width="100"
                                            Binding="{Binding InvoiceDate, StringFormat='MM/dd/yyyy'}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#7F8C8D"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Due Date" Width="100"
                                            Binding="{Binding DueDate, StringFormat='MM/dd/yyyy'}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="Foreground" Value="#C0392B"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Total Amount" Width="110"
                                            Binding="{Binding TotalAmount, StringFormat='₱{0:N2}'}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Amount Paid" Width="110"
                                            Binding="{Binding AmountPaid, StringFormat='₱{0:N2}'}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                    <Setter Property="Foreground" Value="#27AE60"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Balance" Width="110"
                                            Binding="{Binding Balance, StringFormat='₱{0:N2}'}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaid}" Value="False">
                                            <Setter Property="Foreground" Value="#E74C3C"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                            <Setter Property="Foreground" Value="#27AE60"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- IsPaid column -->
                        <DataGridTemplateColumn Header="Paid" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="✗"/>
                                                <Setter Property="Foreground" Value="#BDC3C7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                        <Setter Property="Text" Value="✓"/>
                                                        <Setter Property="Foreground" Value="#27AE60"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- IsOverdue column -->
                        <DataGridTemplateColumn Header="Overdue" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value=""/>
                                                <Setter Property="Foreground" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                        <Setter Property="Text" Value="⚠ Yes"/>
                                                        <Setter Property="Foreground" Value="#E67E22"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </DockPanel>

        <!-- ═══════════════════════════════════════════════════════════
             PAYMENT DIALOG OVERLAY
             ═══════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsPaymentDialogOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="10">

            <!-- Semi-transparent backdrop -->
            <Rectangle Fill="#000000" Opacity="0.45"/>

            <!-- Dialog card -->
            <Border Background="White" CornerRadius="6" Padding="28,24"
                    MaxWidth="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#DFE6E9" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.25" ShadowDepth="4"/>
                </Border.Effect>

                <StackPanel MinWidth="340">

                    <TextBlock Text="Record Payment" Style="{StaticResource SectionHeader}"
                               FontSize="16" Margin="0,0,0,20"/>

                    <!-- Invoice details -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Vendor:"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding PaymentDialogVendorName}"
                                   FontWeight="SemiBold" Foreground="#2C3E50"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Invoice:"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding PaymentDialogInvoice}"
                                   FontFamily="Consolas" Foreground="#2C3E50"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Balance:"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Text="{Binding PaymentDialogBalance, StringFormat='₱{0:N2}'}"
                                   FontWeight="Bold" FontSize="15" Foreground="#E74C3C"/>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="#DFE6E9" Margin="0,0,0,16"/>

                    <!-- Payment amount input -->
                    <TextBlock Text="Payment Amount:" Style="{StaticResource FieldLabel}"
                               FontSize="12" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding PaymentAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" FontSize="14"
                             BorderBrush="#BDC3C7" BorderThickness="1"/>

                    <!-- Error message -->
                    <Border Visibility="{Binding HasPaymentError, Converter={StaticResource BoolToVis}}"
                            Background="#FDEDEC" BorderBrush="#E74C3C" BorderThickness="1"
                            CornerRadius="3" Padding="10,6" Margin="0,8,0,0">
                        <TextBlock Text="{Binding PaymentError}"
                                   Foreground="#C0392B" FontSize="11" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="Cancel"
                                Command="{Binding CancelPaymentCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0"/>
                        <Button Content="Confirm Payment"
                                Command="{Binding ConfirmPaymentCommand}"
                                Style="{StaticResource ConfirmButton}"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>

</UserControl>
