<UserControl x:Class="Views.Purchasing.VendorCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="#F5F6FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDC3C7"/>
                    <Setter Property="Foreground" Value="#7F8C8D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#27AE60"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#E74C3C"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#7F8C8D"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Main Master-Detail Layout -->
        <DockPanel Margin="10">
            <!-- Header/Status row -->
            <Border DockPanel.Dock="Top"
                    Background="White" BorderBrush="#DFE6E9" BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <TextBlock Text="Vendor Product Catalog Manager" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Vendor Master List -->
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Right: Product Catalog Detail -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Vendor Master Panel -->
                <Border Grid.Column="0" Background="White" BorderBrush="#DFE6E9" BorderThickness="1" CornerRadius="4" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Vendors" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding Vendors}"
                                 SelectedItem="{Binding SelectedVendor}"
                                 DisplayMemberPath="Name"
                                 BorderBrush="#DFE6E9" BorderThickness="1"
                                 FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderBrush" Value="#F2F4F4"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Catalog Detail Panel -->
                <Border Grid.Column="2" Background="White" BorderBrush="#DFE6E9" BorderThickness="1" CornerRadius="4" Padding="12">
                    <DockPanel>
                        <!-- No Vendor Selected State -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedVendor}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <TextBlock Text="Please select a vendor from the list to manage their catalog."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="13" Foreground="#7F8C8D"/>
                        </Grid>

                        <!-- Selected Vendor Catalog Editor -->
                        <Grid Visibility="{Binding HasSelectedVendor, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Catalog for: " Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedVendor.Name}" Style="{StaticResource SectionHeader}" Foreground="#2980B9" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Add Product Action (Manager Only) -->
                                    <Button Content="+ Add Product to Catalog"
                                            Command="{Binding SearchProductsCommand}"
                                            CommandParameter=""
                                            Click="OpenSearchDialog"
                                            Style="{StaticResource SuccessButton}"
                                            HorizontalAlignment="Right"
                                            Visibility="{Binding IsManager, Converter={StaticResource BoolToVis}}"/>
                                </Grid>

                                <!-- Catalog Grid -->
                                <DataGrid ItemsSource="{Binding CatalogEntries}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          IsReadOnly="False"
                                          GridLinesVisibility="Horizontal"
                                          BorderBrush="#DFE6E9" BorderThickness="1"
                                          HeadersVisibility="Column"
                                          RowBackground="White" AlternatingRowBackground="#FAFBFC"
                                          FontSize="12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                                        
                                        <!-- Editable LastUnitCost -->
                                        <DataGridTemplateColumn Header="Last Unit Cost (₱)" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding LastUnitCost, StringFormat='N2'}" Padding="6,4" HorizontalAlignment="Right"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding LastUnitCost, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Padding="4,2" HorizontalAlignment="Stretch" IsReadOnly="{Binding DataContext.IsManager, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Editable Notes -->
                                        <DataGridTemplateColumn Header="Notes" Width="220">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Notes}" Padding="6,4" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Padding="4,2" HorizontalAlignment="Stretch" IsReadOnly="{Binding DataContext.IsManager, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Manager Actions Column -->
                                        <DataGridTemplateColumn Header="Actions" Width="140" IsReadOnly="True"
                                                                Visibility="{Binding DataContext.IsManager, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Save"
                                                                Command="{Binding DataContext.SaveEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                FontSize="10" Padding="6,2" Margin="0,0,4,0"
                                                                Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                                        <Button Content="Remove"
                                                                Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                FontSize="10" Padding="6,2"
                                                                Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>

        <!-- ADD PRODUCT MODAL DIALOG OVERLAY -->
        <Grid x:Name="SearchDialogOverlay"
              Visibility="{Binding IsSearchDialogOpen, Converter={StaticResource BoolToVis}}"
              Background="#80000000">
            <Border Width="520" Height="460"
                    Background="White" BorderBrush="#2980B9" BorderThickness="1.5"
                    CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Add Product to Catalog" Style="{StaticResource SectionHeader}" Foreground="#2980B9" Margin="0,0,0,12"/>

                    <!-- Footer actions -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Add Product"
                                Command="{Binding AddProductCommand}"
                                Style="{StaticResource SuccessButton}"
                                Margin="0,0,8,0"/>
                        <Button Content="Cancel"
                                Click="CloseSearchDialog"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>

                    <!-- Product detail input -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Agreed Unit Cost (₱):" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewEntryCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" BorderBrush="#BDC3C7"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Catalog Notes:" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NewEntryNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" BorderBrush="#BDC3C7"/>
                    </Grid>

                    <!-- Product search box -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ProductSearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 x:Name="ModalSearchBox" KeyDown="ModalSearchBox_KeyDown"
                                 Padding="6,4" BorderBrush="#BDC3C7" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Search"
                                Command="{Binding SearchProductsCommand}"
                                Style="{StaticResource ActionButton}"
                                Margin="4,0,0,0"/>
                    </Grid>

                    <!-- Search Results -->
                    <ListBox ItemsSource="{Binding ProductSearchResults}"
                             SelectedItem="{Binding SelectedProductResult}"
                             BorderBrush="#DFE6E9" BorderThickness="1"
                             FontSize="11">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Sku}" Foreground="#7F8C8D" Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
