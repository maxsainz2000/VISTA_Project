<UserControl x:Class="Views.Purchasing.VendorCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MerchSys.App.Views.Shell"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="{DynamicResource WindowBackgroundBrush}"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- Main Master-Detail Layout -->
        <DockPanel Margin="10">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsBusy}" Value="True"/>
                                <Condition Binding="{Binding LastLoadedAt}" Value="{x:Null}"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <!-- Header/Status row -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Vendor Product Catalog Manager" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"/>
                    <views:FreshnessChip Grid.Column="1"
                                         LastLoadedAt="{Binding LastLoadedAt}"
                                         RefreshCommand="{Binding LoadVendorsCommand}"
                                         VerticalAlignment="Center"
                                         Margin="16,0,0,0"
                                         HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Vendor Master List -->
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Right: Product Catalog Detail -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Vendor Master Panel -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Vendors" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding Vendors}"
                                 SelectedItem="{Binding SelectedVendor}"
                                 DisplayMemberPath="Name"
                                 FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 TabIndex="1">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Catalog Detail Panel -->
                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="12">
                    <Grid>
                        <DockPanel>
                            <!-- No Vendor Selected State -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedVendor}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBlock Text="Please select a vendor from the list to manage their catalog."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>

                            <!-- Selected Vendor Catalog Editor -->
                            <Grid Visibility="{Binding HasSelectedVendor, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Catalog for: " Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedVendor.Name}" Style="{StaticResource SectionHeaderStyle}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Add Product Action (Manager Only) -->
                                        <Button Content="+ _Add Product to Catalog"
                                                Command="{Binding SearchProductsCommand}"
                                                CommandParameter=""
                                                Click="OpenSearchDialog"
                                                Style="{StaticResource SuccessButtonStyle}"
                                                HorizontalAlignment="Right"
                                                Visibility="{Binding IsManager, Converter={StaticResource BoolToVis}}"
                                                TabIndex="2"/>
                                    </Grid>

                                    <!-- Catalog Grid -->
                                    <Grid>
                                        <DataGrid ItemsSource="{Binding CatalogEntries}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                                  IsReadOnly="False"
                                                  GridLinesVisibility="Horizontal"
                                                  BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                                  HeadersVisibility="Column"
                                                  Background="{DynamicResource SurfaceBrush}"
                                                  AlternatingRowBackground="{DynamicResource WindowBackgroundBrush}"
                                                  FontSize="{DynamicResource FontSizeBody}"
                                                  TabIndex="3">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource SemanticRowStyle}"/>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                                                
                                                <!-- Read-Only LastUnitCost -->
                                                <DataGridTextColumn Header="Last Unit Cost" Width="130" IsReadOnly="True"
                                                                    HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                                    Binding="{Binding LastUnitCost, StringFormat={StaticResource FormatCurrency}}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}"/>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- Editable Notes -->
                                                <DataGridTemplateColumn Header="Notes" Width="220">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Notes}" Padding="6,4" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Padding="4,2" HorizontalAlignment="Stretch" IsReadOnly="{Binding DataContext.IsManager, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- Manager Actions Column -->
                                                <DataGridTemplateColumn Header="Actions" Width="140" IsReadOnly="True"
                                                                        Visibility="{Binding DataContext.IsManager, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Content="_Save"
                                                                        Command="{Binding DataContext.SaveEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        FontSize="10" Padding="6,2" Margin="0,0,4,0"
                                                                        Style="{StaticResource SuccessButtonStyle}"/>
                                                                <Button Content="_Remove"
                                                                        Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        FontSize="10" Padding="6,2"
                                                                        Style="{StaticResource DangerButtonStyle}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Empty State Panel -->
                                        <views:EmptyStatePanel Title="Catalog Empty"
                                                               Description="This vendor has no products in their catalog."
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <views:EmptyStatePanel.Style>
                                                <Style TargetType="views:EmptyStatePanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasSelectedVendor}" Value="True"/>
                                                                <Condition Binding="{Binding CatalogEntries.Count}" Value="0"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </views:EmptyStatePanel.Style>
                                        </views:EmptyStatePanel>
                                    </Grid>
                                </DockPanel>
                            </Grid>
                        </DockPanel>

                        <!-- Busy Overlay -->
                        <views:SkeletonPanel Kind="Rows" IsBusy="{Binding IsBusy}" LastLoadedAt="{Binding LastLoadedAt}" Margin="10"/>

                        <views:BusyOverlay Message="Loading catalog..."
                                           IsBusy="{Binding IsBusy}"
                                           LastLoadedAt="{Binding LastLoadedAt}"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <views:ErrorStatePanel Title="Load Failed"
                                               Message="{Binding ErrorMessage}"
                                               RetryCommand="{Binding LoadVendorsCommand}"
                                               Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>

        <!-- ADD PRODUCT MODAL DIALOG OVERLAY -->
        <Grid x:Name="SearchDialogOverlay"
              Visibility="{Binding IsSearchDialogOpen, Converter={StaticResource BoolToVis}}"
              Background="{DynamicResource OverlayBrush}">
            <Border Width="520" Height="460"
                    Style="{StaticResource CardStyle}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Add Product to Catalog" Style="{StaticResource SectionHeaderStyle}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>

                    <!-- Footer actions -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="_Add Product"
                                Command="{Binding AddProductCommand}"
                                Style="{StaticResource SuccessButtonStyle}"
                                Margin="0,0,8,0"
                                TabIndex="14"/>
                        <Button Content="_Cancel"
                                Click="CloseSearchDialog"
                                Style="{StaticResource SecondaryButtonStyle}"
                                TabIndex="15"/>
                    </StackPanel>

                    <!-- Product detail input -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Catalog Notes:" Style="{StaticResource CaptionLabelStyle}" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewEntryNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" TabIndex="13"/>
                    </Grid>

                    <!-- Product search box -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ProductSearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 x:Name="ModalSearchBox" KeyDown="ModalSearchBox_KeyDown"
                                 Padding="6,4" VerticalContentAlignment="Center"
                                 TabIndex="10"/>
                        <Button Grid.Column="1" Content="_Search"
                                Command="{Binding SearchProductsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="4,0,0,0"
                                TabIndex="11"/>
                    </Grid>

                    <!-- Search Results -->
                    <ListBox ItemsSource="{Binding ProductSearchResults}"
                             SelectedItem="{Binding SelectedProductResult}"
                             FontSize="11"
                             TabIndex="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Sku}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
