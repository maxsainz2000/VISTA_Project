<UserControl x:Class="Views.Purchasing.GoodsReceivingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MerchSys.App.Views.Shell"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1100"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Row coloring: discrepancy rows turn warning color -->
        <Style x:Key="GRRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource SemanticRowStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasDiscrepancy}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <DockPanel Margin="10">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsBusy}" Value="True"/>
                                <Condition Binding="{Binding LastLoadedAt}" Value="{x:Null}"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <!-- ═══════════════════════════════════════════════════════════
                 PO SELECTOR TOOLBAR
                 ═══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}" Padding="12,10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Select Submitted PO:" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding SubmittedPOs}"
                              SelectedItem="{Binding SelectedPO}"
                              DisplayMemberPath="DisplayText"
                              Padding="8,5" VerticalContentAlignment="Center"
                              FontSize="12"
                              TabIndex="1"/>

                    <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" Padding="4,0"
                            Command="{Binding LoadPOsCommand}"
                            ToolTip="Reload submitted POs"
                            Margin="0,0,-30,0"
                            TabIndex="2"
                            AutomationProperties.Name="Reload submitted purchase orders"
                            AutomationProperties.HelpText="Refreshes the dropdown list of submitted purchase orders from the database.">
                        <Path Style="{StaticResource IconBase}" Data="{StaticResource IconRefreshGeometry}"
                              Width="14" Height="14"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>

                    <views:FreshnessChip Grid.Column="2"
                                         LastLoadedAt="{Binding LastLoadedAt}"
                                         RefreshCommand="{Binding LoadPOsCommand}"
                                         VerticalAlignment="Center"
                                         Margin="12,0"
                                         HorizontalAlignment="Left"/>

                    <Button Grid.Column="3"
                            Content="_Confirm Receipt"
                            Command="{Binding ConfirmReceiptCommand}"
                            Style="{StaticResource SuccessButtonStyle}"
                            Padding="18,6"
                            TabIndex="3"/>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 STATUS BAR
                 ═══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Padding="8,3" Margin="0,0,0,4">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource CaptionLabelStyle}"/>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 PLACEHOLDER — shown when no PO is selected
                 ═══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}" Padding="24" Margin="0,0,0,6"
                    Height="120">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPOSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Select a submitted Purchase Order above to begin receiving goods."
                               FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Only POs in Submitted status are available."
                               FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource SeparatorBrush}" HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 RECEIVING GRID — visible when a PO is selected
                 ═══════════════════════════════════════════════════════════ -->
            <Border Visibility="{Binding IsPOSelected, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}">
                <DockPanel Margin="12">

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Receiving Lines" Style="{StaticResource SectionHeaderStyle}"
                                   VerticalAlignment="Center"/>
                        <!-- Discrepancy legend -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1" CornerRadius="2" Margin="0,0,4,0"/>
                            <TextBlock Text="Discrepancy detected" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="ReceivingGrid"
                               TabIndex="4"
                               ItemsSource="{Binding ReceivingLines}"
                               AutoGenerateColumns="False"
                               CanUserAddRows="False" CanUserDeleteRows="False"
                               CanUserReorderColumns="False" CanUserResizeRows="False"
                               IsReadOnly="False"
                               SelectionUnit="FullRow" SelectionMode="Single"
                               GridLinesVisibility="Horizontal"
                               BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                               HeadersVisibility="Column"
                               RowStyle="{StaticResource GRRowStyle}"
                               Background="{DynamicResource SurfaceBrush}"
                               AlternatingRowBackground="{DynamicResource WindowBackgroundBrush}"
                               FontSize="{DynamicResource FontSizeBody}">
                        <DataGrid.Columns>

                            <!-- Read-only: Product -->
                            <DataGridTextColumn Header="Product Name" Width="*" MinWidth="180"
                                               IsReadOnly="True"
                                               Binding="{Binding ProductName}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Read-only: Qty Ordered -->
                            <DataGridTextColumn Header="Qty Ordered" Width="95"
                                               IsReadOnly="True"
                                               HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                               Binding="{Binding QtyOrdered, StringFormat={StaticResource FormatQuantity}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Editable: Qty Received -->
                            <DataGridTextColumn Header="Qty Received" Width="100"
                                               HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                               Binding="{Binding QtyReceived, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={StaticResource FormatQuantity}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDiscrepancy}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Editable: Unit Cost -->
                            <DataGridTextColumn Header="Unit Cost" Width="100"
                                               HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                               Binding="{Binding UnitCost, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={StaticResource FormatQuantity}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Editable: Expiry Date (template column for DatePicker) -->
                            <DataGridTemplateColumn Header="Expiry Date" Width="130" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ExpiryDate, StringFormat={StaticResource FormatDate}}"
                                                   FontSize="12" VerticalAlignment="Center" Padding="4,0"
                                                   Foreground="{Binding ExpiryDate, Converter={x:Null}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <DatePicker SelectedDate="{Binding ExpiryDate, Mode=TwoWay}"
                                                    BorderThickness="0" FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Editable: VAT Classification -->
                            <DataGridTemplateColumn Header="VAT Class" Width="105" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding VatClassification}"
                                                   FontSize="12" VerticalAlignment="Center" Padding="4,0"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding VatClassification, Mode=TwoWay}"
                                                  ItemsSource="{Binding DataContext.VatTreatmentValues,
                                                                RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                  BorderThickness="0" FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Read-only: VAT Amount (auto-computed) -->
                            <DataGridTextColumn Header="VAT Amt" Width="80"
                                               IsReadOnly="True"
                                               HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                               Binding="{Binding VatAmount, StringFormat={StaticResource FormatCurrency}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Editable: Discrepancy Notes — styled red when discrepancy exists and notes empty -->
                            <DataGridTemplateColumn Header="Discrepancy Notes" Width="*" MinWidth="160" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDiscrepancy}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DiscrepancyNotes}"
                                                       FontSize="12" VerticalAlignment="Center" Padding="4,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDiscrepancy}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding DiscrepancyNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" FontSize="12" Padding="4,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Discrepancy indicator badge -->
                            <DataGridTemplateColumn Header="" Width="36" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Path Width="15" Height="15" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="{StaticResource IconWarningGeometry}">
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource IconBase}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDiscrepancy}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

        </DockPanel>

        <views:EmptyStatePanel Title="No Purchase Orders Awaiting Receipt"
                               Description="There are no submitted purchase orders currently awaiting receipt."
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <views:SkeletonPanel Kind="Rows" IsBusy="{Binding IsBusy}" LastLoadedAt="{Binding LastLoadedAt}" Margin="10"/>

        <views:BusyOverlay Message="Processing receipt..."
                           IsBusy="{Binding IsBusy}"
                           LastLoadedAt="{Binding LastLoadedAt}"/>

        <views:ErrorStatePanel Title="Load Failed"
                               Message="{Binding ErrorMessage}"
                               RetryCommand="{Binding LoadPOsCommand}"
                               Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
