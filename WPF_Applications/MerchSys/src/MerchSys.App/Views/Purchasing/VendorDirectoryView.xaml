<UserControl x:Class="Views.Purchasing.VendorDirectoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MerchSys.App.Views.Shell"
             xmlns:helpers="clr-namespace:MerchSys.App.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="{DynamicResource WindowBackgroundBrush}"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <DockPanel Margin="10">

        <!-- ═══════════════════════════════════════════════════════════
             TOOLBAR
             ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusSmall}" Padding="12,8" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Search:" Style="{StaticResource CaptionLabelStyle}" Margin="0,0,4,0"/>
                <TextBox Grid.Column="1"
                         x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4" BorderThickness="1"
                         VerticalContentAlignment="Center"
                         TabIndex="5"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            Visibility="{Binding IsManager, Converter={StaticResource BoolToVis}}">
                    <Button Content="_Add Vendor"
                            Command="{Binding AddVendorCommand}"
                            Style="{StaticResource SuccessButtonStyle}"
                            TabIndex="1"/>
                    <Button Content="_Edit"
                            Command="{Binding EditVendorCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            TabIndex="2"/>
                    <Button Content="_Delete"
                            Command="{Binding DeleteVendorCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            TabIndex="3"/>
                    <Button Content="Re_fresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0"
                            TabIndex="4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             STATUS BAR
             ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Padding="8,3" Margin="0,0,0,4">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             EDITOR PANEL
             ═══════════════════════════════════════════════════════════ -->
        <Border x:Name="EditorPanelOverlay"
                DockPanel.Dock="Bottom"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusSmall}" Margin="0,6,0,0" Padding="16,12"
                IsVisibleChanged="EditorPanelOverlay_IsVisibleChanged">
            <DockPanel>

                <!-- Editor header + action buttons -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Editor.EditorTitle}"
                               Style="{StaticResource SectionHeaderStyle}"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="_Save"
                                Command="{Binding SaveVendorCommand}"
                                Style="{StaticResource SuccessButtonStyle}"
                                TabIndex="14"/>
                        <Button Content="_Cancel"
                                Command="{Binding CancelEditorCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0"
                                TabIndex="15"/>
                    </StackPanel>
                </Grid>

                <!-- Validation error -->
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding Editor.ValidationError}"
                           Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,0,0,6"
                           Visibility="{Binding Editor.ValidationError,
                                        Converter={StaticResource BoolToVis},
                                        ConverterParameter=notEmpty}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Editor.ValidationError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Editor.ValidationError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Form fields: 3 rows × 3 columns of inputs with spacing -->
                <Grid DockPanel.Dock="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: Name | ContactPerson | LeadTimeDays -->
                    <HeaderedContentControl Grid.Row="0" Grid.Column="0" Header="Name" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="True">
                        <TextBox x:Name="VendorNameTextBox"
                                 Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" BorderThickness="1" VerticalContentAlignment="Center"
                                 TabIndex="7"/>
                    </HeaderedContentControl>

                    <HeaderedContentControl Grid.Row="0" Grid.Column="2" Header="Contact Person" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="False">
                        <TextBox Text="{Binding Editor.ContactPerson, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" BorderThickness="1" VerticalContentAlignment="Center"
                                 TabIndex="8"/>
                    </HeaderedContentControl>

                    <HeaderedContentControl Grid.Row="0" Grid.Column="4" Header="Lead Time (days)" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="True">
                        <TextBox Text="{Binding Editor.DefaultLeadTimeDays, UpdateSourceTrigger=PropertyChanged}"
                                 helpers:FormHelper.InputMode="PositiveInteger"
                                 Padding="6,4" BorderThickness="1" VerticalContentAlignment="Center"
                                 TabIndex="9"/>
                    </HeaderedContentControl>

                    <!-- Row 2: Phone | Email -->
                    <HeaderedContentControl Grid.Row="2" Grid.Column="0" Header="Phone" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="True">
                        <TextBox Text="{Binding Editor.Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" BorderThickness="1" VerticalContentAlignment="Center"
                                 TabIndex="10"/>
                    </HeaderedContentControl>

                    <HeaderedContentControl Grid.Row="2" Grid.Column="2" Header="Email" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="False">
                        <TextBox Text="{Binding Editor.Email, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" BorderThickness="1" VerticalContentAlignment="Center"
                                 TabIndex="11"/>
                    </HeaderedContentControl>

                    <!-- Row 4: Address | Notes -->
                    <HeaderedContentControl Grid.Row="4" Grid.Column="0" Header="Address" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="False">
                        <TextBox Text="{Binding Editor.Address, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" BorderThickness="1" VerticalContentAlignment="Center"
                                 TabIndex="12"/>
                    </HeaderedContentControl>

                    <HeaderedContentControl Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" Header="Notes" Style="{StaticResource FieldRowStyle}" helpers:FormHelper.IsRequired="False">
                        <TextBox Text="{Binding Editor.Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" BorderThickness="1" VerticalContentAlignment="Center"
                                 TabIndex="13"/>
                    </HeaderedContentControl>
                </Grid>

            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN CONTENT: Vendor list + Detail panel
             ═══════════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Vendor List -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,6,0">
                <Grid>
                    <DockPanel Margin="12">
                        <TextBlock DockPanel.Dock="Top" Text="Vendors"
                                   Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>

                        <DataGrid x:Name="VendorGrid"
                                  TabIndex="6"
                                  ItemsSource="{Binding Vendors}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False" CanUserResizeRows="False"
                                  IsReadOnly="True"
                                  SelectionUnit="FullRow" SelectionMode="Single"
                                  GridLinesVisibility="Horizontal"
                                  BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                  HeadersVisibility="Column"
                                  Background="{DynamicResource SurfaceBrush}"
                                  AlternatingRowBackground="{DynamicResource WindowBackgroundBrush}"
                                  CanUserSortColumns="True"
                                  FontSize="{DynamicResource FontSizeBody}">
                            <DataGrid.RowStyle>
                                <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource SemanticRowStyle}"/>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Name" Width="*" MinWidth="160"
                                                   Binding="{Binding Name}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Contact Person" Width="140"
                                                   Binding="{Binding ContactPerson}"/>

                                <DataGridTextColumn Header="Phone" Width="120"
                                                   Binding="{Binding Phone}"/>

                                <DataGridTextColumn Header="Email" Width="180"
                                                   Binding="{Binding Email}"/>

                                <DataGridTextColumn Header="Lead Time (days)" Width="120"
                                                   Binding="{Binding DefaultLeadTimeDays}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Empty State Panel -->
                    <views:EmptyStatePanel Title="No Vendors Found"
                                           Description="There are no vendors registered in the directory."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

                    <!-- Busy Overlay -->
                    <views:BusyOverlay Message="Loading vendors..."
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                    <views:ErrorStatePanel Title="Load Failed"
                                           Message="{Binding ErrorMessage}"
                                           RetryCommand="{Binding RefreshCommand}"
                                           Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Detail Panel -->
            <Border Grid.Column="1"
                    Width="340"
                    Visibility="{Binding HasDetailVisible, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}">
                <DockPanel Margin="12">

                    <!-- Vendor name header -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding VendorDetail.Vendor.Name}"
                               FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Stats row -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource SidebarBackgroundBrush}" CornerRadius="{DynamicResource RadiusSmall}" Padding="8,6" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding VendorDetail.TotalPurchaseOrders}"
                                           Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock Text="Total POs" Style="{StaticResource CaptionLabelStyle}" TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding VendorDetail.TotalSpent, StringFormat='₱{0:N0}'}"
                                           Style="{StaticResource MetricValueStyle}" FontSize="13"/>
                                <TextBlock Text="Total Spent" Style="{StaticResource CaptionLabelStyle}" TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding VendorDetail.LastOrderDate, StringFormat='MM/dd/yy'}"
                                           Style="{StaticResource MetricValueStyle}" FontSize="12"/>
                                <TextBlock Text="Last Order" Style="{StaticResource CaptionLabelStyle}" TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding VendorDetail.AverageLeadTimeDays, StringFormat='{}{0:N1}d'}"
                                           Style="{StaticResource MetricValueStyle}" FontSize="13"/>
                                <TextBlock Text="Avg Lead Time" Style="{StaticResource CaptionLabelStyle}" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Recent POs header -->
                    <TextBlock DockPanel.Dock="Top" Text="Recent Purchase Orders"
                               Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>

                    <!-- Recent POs grid -->
                    <DataGrid ItemsSource="{Binding RecentPOs}"
                               AutoGenerateColumns="False"
                               CanUserAddRows="False" CanUserDeleteRows="False"
                               CanUserReorderColumns="False" CanUserResizeRows="False"
                               IsReadOnly="True"
                               SelectionUnit="FullRow" SelectionMode="Single"
                               GridLinesVisibility="Horizontal"
                               BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                               HeadersVisibility="Column"
                               Background="{DynamicResource SurfaceBrush}"
                               AlternatingRowBackground="{DynamicResource WindowBackgroundBrush}"
                               FontSize="{DynamicResource FontSizeBody}">
                        <DataGrid.RowStyle>
                            <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource SemanticRowStyle}"/>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Order #" Width="*"
                                               Binding="{Binding OrderNumber}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Date" Width="70"
                                               Binding="{Binding OrderDate, StringFormat='MM/dd/yy'}"/>

                            <DataGridTextColumn Header="Status" Width="70"
                                               Binding="{Binding Status}"/>

                            <DataGridTextColumn Header="Total" Width="80"
                                               Binding="{Binding Total, StringFormat='₱{0:N0}'}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </DockPanel>
            </Border>

        </Grid>

    </DockPanel>

</UserControl>
