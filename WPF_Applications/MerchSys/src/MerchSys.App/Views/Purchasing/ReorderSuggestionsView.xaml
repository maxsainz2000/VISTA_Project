<UserControl x:Class="Views.Purchasing.ReorderSuggestionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Tab buttons -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Filter buttons -->
        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AcceptRowButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DismissRowButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="Padding" Value="18,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Seasonal row highlight -->
        <Style x:Key="SuggestionRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSeasonalAdjusted}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConfigRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Root grid enables the edit dialog overlay -->
    <Grid>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN CONTENT
             ═══════════════════════════════════════════════════════════ -->
        <DockPanel Margin="10">

            <!-- PAGE HEADER ──────────────────────────────────────────── -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}" Padding="16,12" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Reorder Suggestions"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="⚡ Generate Suggestions"
                                Command="{Binding GenerateCommand}"
                                Style="{StaticResource ActionButton}"
                                Margin="0,0,8,0"/>
                        <Button Content="↻ Refresh"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- TAB SWITCHER ─────────────────────────────────────────── -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}" Padding="4,4" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Suggestions" Command="{Binding SwitchTabCommand}" CommandParameter="Suggestions">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuggestionsTabActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Configuration" Command="{Binding SwitchTabCommand}" CommandParameter="Configuration">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConfigTabActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- STATUS BAR ────────────────────────────────────────────── -->
            <Border DockPanel.Dock="Top" Padding="8,3" Margin="0,0,0,4">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Working…" HorizontalAlignment="Right"
                               FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 SUGGESTIONS TAB
                 ══════════════════════════════════════════════════════════ -->
            <DockPanel DockPanel.Dock="Top"
                       Visibility="{Binding IsSuggestionsTabActive, Converter={StaticResource BoolToVis}}">

                <!-- Filter toolbar -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSmall}" Padding="12,8" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Filter:" Style="{StaticResource FieldLabel}" FontSize="12"/>

                        <Button Content="Pending" Command="{Binding SetFilterCommand}" CommandParameter="Pending">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPendingFilterActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Accepted" Command="{Binding SetFilterCommand}" CommandParameter="Accepted">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAcceptedFilterActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Dismissed" Command="{Binding SetFilterCommand}" CommandParameter="Dismissed">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDismissedFilterActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Seasonal legend -->
                        <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource WarningBrush}"
                                BorderThickness="1" CornerRadius="2" Margin="24,0,4,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Seasonal adjustment" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Suggestions grid -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}">
                    <DataGrid x:Name="SuggestionsGrid"
                               ItemsSource="{Binding Suggestions}"
                               AutoGenerateColumns="False"
                               CanUserAddRows="False" CanUserDeleteRows="False"
                               CanUserReorderColumns="False" CanUserResizeRows="False"
                               IsReadOnly="True"
                               SelectionUnit="FullRow" SelectionMode="Single"
                               GridLinesVisibility="Horizontal"
                               BorderThickness="0"
                               HeadersVisibility="Column"
                               RowStyle="{StaticResource SuggestionRowStyle}"
                               Background="{DynamicResource SurfaceBrush}"
                               AlternatingRowBackground="{DynamicResource WindowBackgroundBrush}"
                               FontSize="{DynamicResource FontSizeBody}" Margin="1">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Product" Width="160" MinWidth="120"
                                                Binding="{Binding ProductName}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Stock" Width="65"
                                                Binding="{Binding CurrentStock}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Reorder Pt." Width="80"
                                                Binding="{Binding ReorderPoint}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Sugg. Qty" Width="80"
                                                Binding="{Binding SuggestedQty}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Preferred Vendor" Width="150"
                                                Binding="{Binding PreferredVendor}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Lead Days" Width="75"
                                                Binding="{Binding EstLeadTimeDays}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Seasonal indicator -->
                            <DataGridTemplateColumn Header="★" Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value=""/>
                                                    <Setter Property="Foreground" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSeasonalAdjusted}" Value="True">
                                                            <Setter Property="Text" Value="★"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            <Setter Property="ToolTip" Value="Seasonally adjusted reorder point"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Status" Width="80"
                                                Binding="{Binding Status}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Accepted">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Dismissed">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Per-row action buttons — visible only for Pending rows -->
                            <DataGridTemplateColumn Header="Actions" Width="160" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="4,2">
                                            <Button Content="✓ Accept"
                                                     Command="{Binding DataContext.AcceptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource AcceptRowButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Accepted">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Dismissed">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="✗ Dismiss"
                                                     Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DismissRowButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Accepted">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Dismissed">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <!-- Accepted / Dismissed label -->
                                            <TextBlock VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Accepted">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Text" Value="Accepted"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Dismissed">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Text" Value="Dismissed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </DockPanel>

            <!-- ══════════════════════════════════════════════════════════
                 CONFIGURATION TAB
                 ══════════════════════════════════════════════════════════ -->
            <DockPanel DockPanel.Dock="Top"
                       Visibility="{Binding IsConfigTabActive, Converter={StaticResource BoolToVis}}">

                <!-- Config toolbar -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSmall}" Padding="12,8" Margin="0,0,0,6">
                    <TextBlock Text="Select a row and click Edit to update reorder parameters."
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </Border>

                <!-- Config grid -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}">
                    <DataGrid x:Name="ConfigGrid"
                               ItemsSource="{Binding Configs}"
                               AutoGenerateColumns="False"
                               CanUserAddRows="False" CanUserDeleteRows="False"
                               CanUserReorderColumns="False" CanUserResizeRows="False"
                               IsReadOnly="True"
                               SelectionUnit="FullRow" SelectionMode="Single"
                               GridLinesVisibility="Horizontal"
                               BorderThickness="0"
                               HeadersVisibility="Column"
                               RowStyle="{StaticResource ConfigRowStyle}"
                               Background="{DynamicResource SurfaceBrush}"
                               AlternatingRowBackground="{DynamicResource WindowBackgroundBrush}"
                               FontSize="{DynamicResource FontSizeBody}" Margin="1">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Product" Width="160" MinWidth="120"
                                                Binding="{Binding ProductName}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Min Threshold" Width="100"
                                                Binding="{Binding MinimumThreshold}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Safety Stock" Width="90"
                                                Binding="{Binding SafetyStock}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Default Qty" Width="85"
                                                Binding="{Binding DefaultOrderQuantity}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Lead Days" Width="80"
                                                Binding="{Binding LeadTimeDays}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- IsSeasonalItem -->
                            <DataGridTemplateColumn Header="Seasonal" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="✗"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SeparatorBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSeasonalItem}" Value="True">
                                                            <Setter Property="Text" Value="★"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Season ×" Width="75"
                                                Binding="{Binding SeasonalMultiplier, StringFormat='N2'}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- IsActive -->
                            <DataGridTemplateColumn Header="Monitoring" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Disabled"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Active"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Edit button -->
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Edit"
                                                 Style="{StaticResource ActionButton}"
                                                 Padding="10,3" FontSize="11"
                                                 Command="{Binding DataContext.OpenEditConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </DockPanel>

        </DockPanel>

        <!-- ═══════════════════════════════════════════════════════════
             CONFIG EDIT DIALOG OVERLAY
             ═══════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsEditDialogOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="10">

            <!-- Semi-transparent backdrop -->
            <Rectangle Fill="{DynamicResource OverlayBrush}"/>

            <!-- Dialog card -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="28,24"
                    MaxWidth="460"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    Effect="{DynamicResource CardShadow}">

                <StackPanel MinWidth="380">

                    <TextBlock Text="Edit Reorder Configuration"
                               Style="{StaticResource SectionHeader}"
                               FontSize="16" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding EditProductName}"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                    <!-- Fields -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Minimum Threshold:"
                                   Style="{StaticResource FieldLabel}" FontSize="12"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding EditMinThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="13"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Safety Stock:"
                                   Style="{StaticResource FieldLabel}" FontSize="12"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding EditSafetyStock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="13"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Default Order Qty:"
                                   Style="{StaticResource FieldLabel}" FontSize="12"/>
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 Text="{Binding EditDefaultOrderQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="13"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Lead Time (Days):"
                                   Style="{StaticResource FieldLabel}" FontSize="12"/>
                        <TextBox Grid.Row="6" Grid.Column="1"
                                 Text="{Binding EditLeadTimeDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="13"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Seasonal Item:"
                                   Style="{StaticResource FieldLabel}" FontSize="12"/>
                        <CheckBox Grid.Row="8" Grid.Column="1"
                                  IsChecked="{Binding EditIsSeasonalItem, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Seasonal Multiplier:"
                                   Style="{StaticResource FieldLabel}" FontSize="12"/>
                        <TextBox Grid.Row="10" Grid.Column="1"
                                 Text="{Binding EditSeasonalMultiplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="13"/>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Monitoring Active:"
                                   Style="{StaticResource FieldLabel}" FontSize="12"/>
                        <CheckBox Grid.Row="12" Grid.Column="1"
                                  IsChecked="{Binding EditIsActive, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,0,0,12"/>

                    <!-- Error message -->
                    <Border Visibility="{Binding HasEditError, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            CornerRadius="3" Padding="10,6" Margin="0,0,0,12">
                        <TextBlock Text="{Binding EditError}"
                                   Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Command="{Binding CancelEditCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0"/>
                        <Button Content="Save Changes"
                                Command="{Binding SaveConfigCommand}"
                                Style="{StaticResource SaveButton}"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
