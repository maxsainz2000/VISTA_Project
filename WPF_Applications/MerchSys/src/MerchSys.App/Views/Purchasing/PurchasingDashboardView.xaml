<UserControl x:Class="Views.Purchasing.PurchasingDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MerchSys.App.Views.Shell"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- DataGrid row coloring for overdue POs -->
        <Style x:Key="PORowStyle" TargetType="DataGridRow" BasedOn="{StaticResource SemanticRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <DockPanel Margin="10">

            <!-- ═══════════════════════════════════════════════════════════
                 TOOLBAR ROW
                 ═══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}" Padding="12,7" Margin="0,0,0,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Purchasing Dashboard" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" — Overview" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding LastRefreshed}"
                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Loading…" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Refresh" Command="{Binding RefreshCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,10,0">

                    <!-- ═══════════════════════════════════════════════════════════
                         KPI CARDS ROW
                         ═══════════════════════════════════════════════════════════ -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/> <!-- Hero: Outstanding AP -->
                            <ColumnDefinition Width="*"/>     <!-- Overdue AP -->
                            <ColumnDefinition Width="*"/>     <!-- Pending Deliveries -->
                            <ColumnDefinition Width="*"/>     <!-- Reorder suggestions -->
                            <ColumnDefinition Width="*"/>     <!-- Active Vendors -->
                        </Grid.ColumnDefinitions>

                        <!-- Hero: Total Outstanding AP -->
                        <Button Grid.Column="0"
                                Command="{Binding NavigateToViewCommand}" CommandParameter="APLedgerView"
                                Style="{StaticResource CleanButtonStyle}" Margin="0,0,8,0">
                            <Border Style="{StaticResource PrimaryMetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalOutstandingAP, StringFormat='₱{0:N2}'}"
                                               Style="{StaticResource PrimaryMetricValueStyle}" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Outstanding AP" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Overdue AP -->
                        <Button Grid.Column="1"
                                Command="{Binding NavigateToViewCommand}" CommandParameter="APLedgerView"
                                Style="{StaticResource CleanButtonStyle}" Margin="0,0,8,0">
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource SecondaryMetricCardStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOverdueAP}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding OverdueAPAmount, StringFormat='₱{0:N2}'}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryMetricValueStyle}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasOverdueAP}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Overdue AP" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Pending Deliveries -->
                        <Button Grid.Column="2"
                                Command="{Binding NavigateToViewCommand}" CommandParameter="PurchaseOrderListView"
                                Style="{StaticResource CleanButtonStyle}" Margin="0,0,8,0">
                            <Border Style="{StaticResource SecondaryMetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding PendingDeliveriesCount}"
                                               Style="{StaticResource SecondaryMetricValueStyle}" Foreground="{DynamicResource WarningBrush}"/>
                                    <TextBlock Text="Pending Deliveries" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Reorder Suggestions -->
                        <Button Grid.Column="3"
                                Command="{Binding NavigateToViewCommand}" CommandParameter="ReorderSuggestionsView"
                                Style="{StaticResource CleanButtonStyle}" Margin="0,0,8,0">
                            <Border Style="{StaticResource SecondaryMetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ReorderSuggestionsCount}"
                                               Style="{StaticResource SecondaryMetricValueStyle}" Foreground="{DynamicResource SuccessBrush}"/>
                                    <TextBlock Text="Pending Reorders" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Active Vendors -->
                        <Button Grid.Column="4"
                                Command="{Binding NavigateToViewCommand}" CommandParameter="VendorDirectoryView"
                                Style="{StaticResource CleanButtonStyle}">
                            <Border Style="{StaticResource SecondaryMetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveVendorsCount}"
                                               Style="{StaticResource SecondaryMetricValueStyle}" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Active Vendors" Style="{StaticResource KpiLabel}"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </Grid>

                    <!-- ═══════════════════════════════════════════════════════════
                         WHAT THIS MEANS BOX
                         ═══════════════════════════════════════════════════════════ -->
                    <Border Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}" Padding="14,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,12,0">
                                <Path Style="{StaticResource IconBase}" Data="{StaticResource IconLightbulbGeometry}"
                                      Width="22" Height="22" VerticalAlignment="Top"
                                      Fill="{DynamicResource AccentBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="What This Means"
                                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding WhatThisMeansText}"
                                           FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═══════════════════════════════════════════════════════════
                         MAIN CONTENT: Spend Trend (left) + Top Vendors (right)
                         ═══════════════════════════════════════════════════════════ -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 6-Month Spend Trend -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14,12" CornerRadius="{DynamicResource RadiusSmall}" MinHeight="240">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="6-Month Purchasing Spend"
                                           Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>

                                <!-- Legend -->
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Rectangle Width="12" Height="12" Fill="{DynamicResource AccentBrush}" Margin="0,0,4,0" RadiusX="2" RadiusY="2"/>
                                    <TextBlock Text="Purchase Order Value" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Axis Label -->
                                <TextBlock DockPanel.Dock="Bottom" Text="← Last 6 Months"
                                           FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>

                                <!-- Bar Chart -->
                                <ItemsControl ItemsSource="{Binding MonthlyTrend}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center" Margin="4,0">
                                                <Grid Height="130">
                                                    <Rectangle Height="{Binding SpendBarHeight}"
                                                               VerticalAlignment="Bottom"
                                                               Fill="{DynamicResource AccentBrush}" RadiusX="2" RadiusY="2" Width="28">
                                                        <Rectangle.ToolTip>
                                                            <TextBlock Text="{Binding Spend, StringFormat='Spend: ₱{0:N2}'}"/>
                                                        </Rectangle.ToolTip>
                                                    </Rectangle>
                                                </Grid>
                                                <TextBlock Text="{Binding Month}"
                                                           FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>

                        <!-- Top Vendors Table -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14,12" CornerRadius="{DynamicResource RadiusSmall}" MinHeight="240">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Top 5 Vendors by Spend"
                                           Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>

                                <DataGrid ItemsSource="{Binding TopVendors}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          IsReadOnly="True" CanUserReorderColumns="False" CanUserResizeRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                          RowBackground="{DynamicResource SurfaceBrush}" AlternatingRowBackground="{DynamicResource SidebarBackgroundBrush}"
                                          RowStyle="{StaticResource SemanticRowStyle}"
                                          FontSize="11" CanUserSortColumns="False"
                                          SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Vendor" Width="*" MinWidth="140"
                                                            Binding="{Binding VendorName}"/>
                                        <DataGridTextColumn Header="Purchase Orders" Width="100"
                                                            Binding="{Binding POCount}"
                                                            ElementStyle="{StaticResource NumericCellStyle}"/>
                                        <DataGridTextColumn Header="Total Spend" Width="120"
                                                            Binding="{Binding TotalSpend, StringFormat='₱{0:N2}'}"
                                                            ElementStyle="{StaticResource NumericCellStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ═══════════════════════════════════════════════════════════
                         PENDING & OVERDUE POs GRID (Bottom Detail)
                         ═══════════════════════════════════════════════════════════ -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}"
                            Effect="{DynamicResource CardShadow}" Margin="0,0,0,10">
                        <DockPanel Margin="12">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="Pending &amp; Overdue Deliveries" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Color Legend -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" Margin="0,0,3,0" CornerRadius="2"/>
                                <TextBlock Text="Overdue Delivery" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border Width="14" Height="14" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" Margin="0,0,3,0" CornerRadius="2"/>
                                <TextBlock Text="Normal" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- DataGrid Container -->
                            <Grid MinHeight="150">
                                <DataGrid ItemsSource="{Binding PendingPurchaseOrders}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          CanUserReorderColumns="False" CanUserResizeRows="False"
                                          IsReadOnly="True"
                                          SelectionUnit="FullRow" SelectionMode="Single"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column"
                                          RowStyle="{StaticResource PORowStyle}"
                                          CanUserSortColumns="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PO Number" Width="100" Binding="{Binding OrderNumber}"/>
                                        <DataGridTextColumn Header="Vendor" Width="*" MinWidth="180" Binding="{Binding VendorName}"/>
                                        <DataGridTextColumn Header="Order Date" Width="120" Binding="{Binding OrderDate, StringFormat='MM/dd/yyyy HH:mm'}"/>
                                        <DataGridTextColumn Header="Expected Delivery" Width="130" Binding="{Binding ExpectedDeliveryDate, StringFormat='MM/dd/yyyy'}"/>
                                        <DataGridTextColumn Header="Amount" Width="100" Binding="{Binding TotalAmount, StringFormat='₱{0:N2}'}" ElementStyle="{StaticResource NumericCellStyle}"/>
                                        <DataGridTextColumn Header="Status" Width="90" Binding="{Binding Status}"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <views:EmptyStatePanel Title="No Pending Orders"
                                                       Description="There are no active purchase orders currently awaiting delivery."
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>

        <views:BusyOverlay Message="Loading purchasing dashboard..." Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

        <views:ErrorStatePanel Title="Load Failed"
                               Message="{Binding ErrorMessage}"
                               RetryCommand="{Binding RefreshCommand}"
                               Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
