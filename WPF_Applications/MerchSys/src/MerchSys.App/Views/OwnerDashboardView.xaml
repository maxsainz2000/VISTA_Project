<UserControl x:Class="Views.OwnerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="{DynamicResource WindowBackgroundBrush}"
             Unloaded="OnUnloaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="KpiValueSmall" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InterpretationBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style x:Key="InterpretationText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>

        <Style x:Key="WhatThisMeansLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Text" Value="WHAT THIS MEANS"/>
        </Style>

        <Style x:Key="RefreshButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="AlertValue" TargetType="TextBlock" BasedOn="{StaticResource KpiValue}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════ HEADER ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}">
                        <Run Text="Villon Farm Supply — Owner Dashboard"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                        <Run Text="Welcome, "/>
                        <Run Text="{Binding OwnerDisplayName, Mode=OneWay, FallbackValue=Owner}" FontWeight="SemiBold"/>
                        <Run Text=" · Read-only access"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastRefreshedDisplay}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource RefreshButton}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconBase}" Data="{StaticResource IconRefreshGeometry}"
                                  Width="13" Height="13" Margin="0,0,6,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Border Grid.Row="1" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="10">
            <TextBlock Text="Loading KPIs…" HorizontalAlignment="Center"
                       VerticalAlignment="Center" FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>

        <!-- ═══════ 2×2 KPI CARD GRID ════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── PURCHASING card ─────────────────────────────────────────────── -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource KpiCard}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Path Style="{StaticResource IconBase}" Data="{StaticResource IconBoxGeometry}"
                              Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                              Fill="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Style="{StaticResource CardTitle}" Text="PURCHASING"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource InterpretationBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource WhatThisMeansLabel}"/>
                            <TextBlock Text="{Binding PurchasingInterpretation}"
                                       Style="{StaticResource InterpretationText}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <TextBlock Text="Active Vendors" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="{Binding ActiveVendorCount}" Style="{StaticResource KpiValue}"/>

                        <TextBlock Text="Open Purchase Orders" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="{Binding OpenPurchaseOrderCount}" Style="{StaticResource KpiValue}"/>

                        <TextBlock Text="Pending Deliveries" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="{Binding PendingDeliveryCount}" Style="{StaticResource KpiValue}"/>

                        <TextBlock Text="Overdue Accounts Payable" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Style="{StaticResource AlertValue}">
                            <Run Text="₱"/>
                            <Run Text="{Binding OverdueApTotal, Mode=OneWay, StringFormat=N0}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── INVENTORY card ──────────────────────────────────────────────── -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource KpiCard}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Path Style="{StaticResource IconBase}" Data="{StaticResource IconChartBarGeometry}"
                              Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                              Fill="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Style="{StaticResource CardTitle}" Text="INVENTORY"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource InterpretationBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource WhatThisMeansLabel}"/>
                            <TextBlock Text="{Binding InventoryInterpretation}"
                                       Style="{StaticResource InterpretationText}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <TextBlock Text="Total SKUs" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="{Binding TotalSkuCount}" Style="{StaticResource KpiValue}"/>

                        <TextBlock Text="Total Stock Value" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Style="{StaticResource KpiValue}">
                            <Run Text="₱"/>
                            <Run Text="{Binding TotalStockValue, Mode=OneWay, StringFormat=N0}"/>
                        </TextBlock>

                        <TextBlock Text="Low-Stock Items" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="{Binding LowStockItemCount}" Style="{StaticResource KpiValue}"/>

                        <TextBlock Text="Expiring Within 30 Days" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="{Binding ExpiringSoonCount}" Style="{StaticResource KpiValue}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── SALES card ──────────────────────────────────────────────────── -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource KpiCard}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Path Style="{StaticResource IconBase}" Data="{StaticResource IconCashGeometry}"
                              Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                              Fill="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Style="{StaticResource CardTitle}" Text="SALES"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource InterpretationBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource WhatThisMeansLabel}"/>
                            <TextBlock Text="{Binding SalesInterpretation}"
                                       Style="{StaticResource InterpretationText}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <TextBlock Text="Today's Revenue" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Style="{StaticResource KpiValue}">
                            <Run Text="₱"/>
                            <Run Text="{Binding TodayRevenue, Mode=OneWay, StringFormat=N0}"/>
                        </TextBlock>

                        <TextBlock Text="This Week's Revenue" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Style="{StaticResource KpiValue}">
                            <Run Text="₱"/>
                            <Run Text="{Binding WeekRevenue, Mode=OneWay, StringFormat=N0}"/>
                        </TextBlock>

                        <TextBlock Text="Transactions Today" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="{Binding TodayTransactionCount}" Style="{StaticResource KpiValue}"/>

                        <TextBlock Text="Top Product Today" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="{Binding TopSellingProduct}" Style="{StaticResource KpiValueSmall}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── ACCOUNTING card ────────────────────────────────────────────── -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource KpiCard}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Path Style="{StaticResource IconBase}" Data="{StaticResource IconChartLineGeometry}"
                              Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                              Fill="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Style="{StaticResource CardTitle}" Text="ACCOUNTING"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource InterpretationBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource WhatThisMeansLabel}"/>
                            <TextBlock Text="{Binding AccountingInterpretation}"
                                       Style="{StaticResource InterpretationText}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <TextBlock Text="Current Period Net Income" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Style="{StaticResource KpiValue}">
                            <Run Text="₱"/>
                            <Run Text="{Binding CurrentPeriodNetIncome, Mode=OneWay, StringFormat=N0}"/>
                        </TextBlock>

                        <TextBlock Text="Customer Credit Outstanding (AR)" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Style="{StaticResource KpiValue}">
                            <Run Text="₱"/>
                            <Run Text="{Binding TotalArOutstanding, Mode=OneWay, StringFormat=N0}"/>
                        </TextBlock>

                        <TextBlock Text="Accounts Payable Outstanding" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Style="{StaticResource KpiValue}">
                            <Run Text="₱"/>
                            <Run Text="{Binding TotalApOutstanding, Mode=OneWay, StringFormat=N0}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
