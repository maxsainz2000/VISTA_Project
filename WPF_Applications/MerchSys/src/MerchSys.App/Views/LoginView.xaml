<Window x:Class="Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:MerchSys.App.Helpers"
        mc:Ignorable="d"
        Title="VISTA — Login"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FocusManager.FocusedElement="{Binding ElementName=UsernameTextBox}">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="EyeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Border Style="{StaticResource CardStyle}" Padding="32,28">
            <StackPanel>

                <!-- ── Branding ──────────────────────────────────────── -->
                <TextBlock Text="VISTA"
                           Style="{StaticResource MetricValueLargeStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Villon Integrated Supply and Trade Application"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontFamily="{DynamicResource AppFontFamily}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,28"
                           TextWrapping="Wrap"/>

                <!-- ── Credentials panel ──────────────────────────────── -->
                <StackPanel>

                    <!-- Username -->
                    <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="UsernameTextBox"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             TabIndex="1"
                             Margin="0,0,0,14"/>

                    <!-- Password with eye toggle -->
                    <!-- HidePassword=True  → PasswordBox visible, TextBox hidden (normal) -->
                    <!-- HidePassword=False → TextBox visible, PasswordBox hidden (reveal)  -->
                    <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}"/>
                    <Grid Margin="0,0,0,14">
                        <PasswordBox helpers:PasswordBoxHelper.IsMonitoring="True"
                                     helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}"
                                     Visibility="{Binding HidePassword, Converter={StaticResource BoolToVis}}"
                                     TabIndex="2">
                            <PasswordBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding LoginCommand}"/>
                            </PasswordBox.InputBindings>
                        </PasswordBox>
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}"
                                 TabIndex="2">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding LoginCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Style="{StaticResource EyeButton}"
                                Command="{Binding ToggleShowPasswordCommand}"
                                IsTabStop="False"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                ToolTip="Show / hide password">
                            <Path Style="{StaticResource IconBase}" Data="{StaticResource IconEyeGeometry}"
                                  Width="18" Height="18" Fill="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Error message -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

                    <!-- Log In button (hidden when password-change panel is shown) -->
                    <Button Content="_LOG IN"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="38"
                            IsEnabled="{Binding IsNotLoggingIn}"
                            Visibility="{Binding HidePasswordChange, Converter={StaticResource BoolToVis}}"
                            TabIndex="3"
                            IsDefault="True"/>

                </StackPanel>

                <!-- ── First-login password change panel (DA6) ──────── -->
                <StackPanel Margin="0,20,0,0"
                            Visibility="{Binding ShowPasswordChange, Converter={StaticResource BoolToVis}}">

                    <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="Set a new password to continue"
                               Foreground="{DynamicResource WarningBrush}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <!-- New Password -->
                    <TextBlock Text="New Password" Style="{StaticResource FieldLabelStyle}"/>
                    <Grid Margin="0,0,0,14">
                        <PasswordBox helpers:PasswordBoxHelper.IsMonitoring="True"
                                     helpers:PasswordBoxHelper.BoundPassword="{Binding NewPassword, Mode=TwoWay}"
                                     Visibility="{Binding HideNewPassword, Converter={StaticResource BoolToVis}}"
                                     TabIndex="4"/>
                        <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ShowNewPassword, Converter={StaticResource BoolToVis}}"
                                 TabIndex="4"/>
                        <Button Style="{StaticResource EyeButton}"
                                Command="{Binding ToggleShowNewPasswordCommand}"
                                IsTabStop="False"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                ToolTip="Show / hide new password">
                            <Path Style="{StaticResource IconBase}" Data="{StaticResource IconEyeGeometry}"
                                  Width="18" Height="18" Fill="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Confirm New Password -->
                    <TextBlock Text="Confirm New Password" Style="{StaticResource FieldLabelStyle}"/>
                    <PasswordBox helpers:PasswordBoxHelper.IsMonitoring="True"
                                 helpers:PasswordBoxHelper.BoundPassword="{Binding ConfirmNewPassword, Mode=TwoWay}"
                                 Margin="0,0,0,20"
                                 TabIndex="5"/>

                    <Button Content="_SET PASSWORD AND CONTINUE"
                            Command="{Binding ChangePasswordCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="38"
                            IsEnabled="{Binding IsNotLoggingIn}"
                            TabIndex="6"
                            IsDefault="True"/>

                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>

