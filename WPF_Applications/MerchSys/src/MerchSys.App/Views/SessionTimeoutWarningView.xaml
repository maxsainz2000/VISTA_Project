<Window x:Class="Views.SessionTimeoutWarningView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Timeout"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>

        <Style x:Key="CountdownText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="64"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MessageText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Border Style="{StaticResource CardStyle}" Padding="28,24">
            <StackPanel>

                <TextBlock Text="Session Timeout"
                           Style="{StaticResource PageTitleStyle}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <TextBlock Text="{Binding CountdownDisplay}"
                           Style="{StaticResource CountdownText}"
                           Margin="0,0,0,16"/>

                <TextBlock Style="{StaticResource MessageText}"
                           Margin="0,0,0,24">
                    <Run Text="You will be signed out for inactivity in "/>
                    <Run Text="{Binding RemainingSeconds}"/>
                    <Run Text=" seconds."/>
                </TextBlock>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="_Stay signed in"
                            IsDefault="True"
                            TabIndex="1"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="36"
                            Command="{Binding StaySignedInCommand}"/>

                    <Button Grid.Column="2"
                            Content="_Sign out now"
                            IsCancel="True"
                            TabIndex="2"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="36"
                            Command="{Binding SignOutCommand}"/>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>
