<UserControl x:Class="Views.Login.CarabaoAvatar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsHitTestVisible="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/LoginScene.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Tanod the carabao, in a macOS-style circular badge.
         Pose states are VSM groups on AvatarRoot; the code-behind uses
         VisualStateManager.GoToElementState (GoToState silently no-ops on a UserControl).
         Idle loops (blink / breath / chew / zzz-float) are code-managed clocks so static
         mode runs zero animations. Code-driven transforms (gaze, caps-alert, bounce,
         blink, ear-flick) are SEPARATE transforms composed with the VSM-driven ones, so
         the two never fight over a property. -->
    <Viewbox Stretch="Uniform">
        <Grid x:Name="AvatarRoot" Width="96" Height="96">

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="PoseStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{StaticResource MotionDurationStd}">
                            <VisualTransition.GeneratedEasingFunction>
                                <StaticResource ResourceKey="MotionEasing"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>

                    <VisualState x:Name="Idle"/>
                    <VisualState x:Name="Watching"/>

                    <VisualState x:Name="Shy">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SalakotTr" Storyboard.TargetProperty="Y" To="22" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="SalakotRotate" Storyboard.TargetProperty="Angle" To="-4" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="LidLScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="LidRScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                        </Storyboard>
                    </VisualState>

                    <VisualState x:Name="Peeking">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SalakotTr" Storyboard.TargetProperty="Y" To="13" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="SalakotRotate" Storyboard.TargetProperty="Angle" To="7" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="LidLScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="LidRScale" Storyboard.TargetProperty="ScaleY" To="0.15" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="PupilPoseR" Storyboard.TargetProperty="Y" To="-1" Duration="0"/>
                        </Storyboard>
                    </VisualState>

                    <VisualState x:Name="Thinking">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PupilPoseL" Storyboard.TargetProperty="X" To="-2" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="PupilPoseL" Storyboard.TargetProperty="Y" To="-2" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="PupilPoseR" Storyboard.TargetProperty="X" To="-2" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="PupilPoseR" Storyboard.TargetProperty="Y" To="-2" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="BrowPoseTr" Storyboard.TargetProperty="Y" To="-1.5" Duration="0"/>
                        </Storyboard>
                    </VisualState>

                    <VisualState x:Name="Happy">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="EyesOpenGroup" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="HappyEyesGroup" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="MouthIdle" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="MouthHappy" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="SalakotTr" Storyboard.TargetProperty="Y" To="-3" Duration="0"/>
                        </Storyboard>
                    </VisualState>

                    <VisualState x:Name="Rejected">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="EarLRotate" Storyboard.TargetProperty="Angle" To="-48" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="EarRRotate" Storyboard.TargetProperty="Angle" To="48" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="LidLScale" Storyboard.TargetProperty="ScaleY" To="0.5" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="LidRScale" Storyboard.TargetProperty="ScaleY" To="0.5" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="MouthIdle" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="MouthSad" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="BrowLRotate" Storyboard.TargetProperty="Angle" To="14" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="BrowRRotate" Storyboard.TargetProperty="Angle" To="-14" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="HeadPoseRotate" Storyboard.TargetProperty="Angle" To="2" Duration="0"/>
                        </Storyboard>
                    </VisualState>

                    <VisualState x:Name="Sleeping">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="LidLScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="LidRScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ZzzGroup" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="HeadPoseRotate" Storyboard.TargetProperty="Angle" To="4" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="SalakotRotate" Storyboard.TargetProperty="Angle" To="-7" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Badge background -->
            <Ellipse Width="96" Height="96">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="{StaticResource AvatarBadgeTopColor}" Offset="0"/>
                        <GradientStop Color="{StaticResource AvatarBadgeBottomColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Clipped bust -->
            <Grid Width="88" Height="88">
                <Grid.Clip>
                    <EllipseGeometry Center="44,44" RadiusX="44" RadiusY="44"/>
                </Grid.Clip>
                <Viewbox RenderTransformOrigin="0.5,0.9">
                    <Viewbox.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BreathScale"/>
                            <TranslateTransform x:Name="BounceTr"/>
                        </TransformGroup>
                    </Viewbox.RenderTransform>
                    <Canvas Width="120" Height="120">
                        <Canvas x:Name="BustGroup" Width="120" Height="120" RenderTransformOrigin="0.5,0.72">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="HeadPoseRotate"/>
                                    <RotateTransform x:Name="GazeHeadRotate"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>

                            <!-- Ears (behind head) -->
                            <Ellipse Canvas.Left="14" Canvas.Top="46" Width="20" Height="11"
                                     Fill="{StaticResource AvatarHideShadowBrush}" RenderTransformOrigin="1,0.5">
                                <Ellipse.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="EarLRotate" Angle="-25"/>
                                        <RotateTransform x:Name="EarFlickL"/>
                                    </TransformGroup>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Canvas.Left="86" Canvas.Top="46" Width="20" Height="11"
                                     Fill="{StaticResource AvatarHideShadowBrush}" RenderTransformOrigin="0,0.5">
                                <Ellipse.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="EarRRotate" Angle="25"/>
                                        <RotateTransform x:Name="EarFlickR"/>
                                    </TransformGroup>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Horns -->
                            <Path Fill="{StaticResource AvatarHornBrush}"
                                  Data="M44,48 C26,46 13,38 11,24 C18,32 28,38 46,40 Z"/>
                            <Path Fill="{StaticResource AvatarHornBrush}"
                                  Data="M76,48 C94,46 107,38 109,24 C102,32 92,38 74,40 Z"/>

                            <!-- Head -->
                            <Ellipse Canvas.Left="24" Canvas.Top="38" Width="72" Height="62"
                                     Fill="{StaticResource AvatarHideBrush}"/>

                            <!-- Eyes -->
                            <Canvas x:Name="EyesOpenGroup">
                                <Ellipse Canvas.Left="38" Canvas.Top="56" Width="16" Height="16" Fill="{StaticResource AvatarEyeWhiteBrush}"/>
                                <Ellipse Canvas.Left="66" Canvas.Top="56" Width="16" Height="16" Fill="{StaticResource AvatarEyeWhiteBrush}"/>
                                <Ellipse Canvas.Left="42.5" Canvas.Top="60.5" Width="7" Height="7" Fill="{StaticResource AvatarPupilBrush}">
                                    <Ellipse.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="GazePupilL"/>
                                            <TranslateTransform x:Name="PupilPoseL"/>
                                        </TransformGroup>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Canvas.Left="70.5" Canvas.Top="60.5" Width="7" Height="7" Fill="{StaticResource AvatarPupilBrush}">
                                    <Ellipse.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="GazePupilR"/>
                                            <TranslateTransform x:Name="PupilPoseR"/>
                                        </TransformGroup>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Canvas.Left="37" Canvas.Top="55" Width="18" Height="18"
                                         Fill="{StaticResource AvatarLidBrush}" RenderTransformOrigin="0.5,0">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="LidLScale" ScaleY="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Canvas.Left="65" Canvas.Top="55" Width="18" Height="18"
                                         Fill="{StaticResource AvatarLidBrush}" RenderTransformOrigin="0.5,0">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="LidRScale" ScaleY="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Canvas>

                            <!-- Happy arc eyes -->
                            <Canvas x:Name="HappyEyesGroup" Opacity="0">
                                <Path Stroke="{StaticResource AvatarPupilBrush}" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M38,66 Q46,57 54,66"/>
                                <Path Stroke="{StaticResource AvatarPupilBrush}" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M66,66 Q74,57 82,66"/>
                            </Canvas>

                            <!-- Brows: pose translate (VSM) + alert translate (code) -->
                            <Canvas x:Name="BrowGroup">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="BrowPoseTr"/>
                                        <TranslateTransform x:Name="BrowAlertTr"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                                <Rectangle Canvas.Left="39" Canvas.Top="49" Width="14" Height="3" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{StaticResource AvatarDetailBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform x:Name="BrowLRotate"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Canvas.Left="67" Canvas.Top="49" Width="14" Height="3" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{StaticResource AvatarDetailBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform x:Name="BrowRRotate"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>

                            <!-- Muzzle (chew loop translates the group) -->
                            <Canvas x:Name="MuzzleGroup">
                                <Canvas.RenderTransform>
                                    <TranslateTransform x:Name="MuzzleTr"/>
                                </Canvas.RenderTransform>
                                <Ellipse Canvas.Left="40" Canvas.Top="76" Width="40" Height="26" Fill="{StaticResource AvatarMuzzleBrush}"/>
                                <Ellipse Canvas.Left="50" Canvas.Top="84" Width="5" Height="6" Fill="{StaticResource AvatarNostrilBrush}"/>
                                <Ellipse Canvas.Left="65" Canvas.Top="84" Width="5" Height="6" Fill="{StaticResource AvatarNostrilBrush}"/>
                                <Path x:Name="MouthIdle" Stroke="{StaticResource AvatarDetailBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M52,96 Q60,100 68,96"/>
                                <Path x:Name="MouthHappy" Opacity="0" Stroke="{StaticResource AvatarDetailBrush}" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M50,94 Q60,103 70,94"/>
                                <Path x:Name="MouthSad" Opacity="0" Stroke="{StaticResource AvatarDetailBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M52,99 Q60,94 68,99"/>
                            </Canvas>

                            <!-- Salakot: front-facing, so "shy" slides it DOWN over the eyes -->
                            <Canvas x:Name="SalakotGroup">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="SalakotRotate" CenterX="60" CenterY="40"/>
                                        <TranslateTransform x:Name="SalakotTr"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                                <Ellipse Canvas.Left="24" Canvas.Top="36" Width="72" Height="13" Fill="{StaticResource AvatarSalakotDarkBrush}"/>
                                <Path Fill="{StaticResource AvatarSalakotBrush}"
                                      Data="M28,42 C34,16 86,16 92,42 C72,34 48,34 28,42 Z"/>
                                <Ellipse Canvas.Left="56.5" Canvas.Top="11" Width="7" Height="7" Fill="{StaticResource AvatarSalakotBandBrush}"/>
                            </Canvas>
                        </Canvas>
                    </Canvas>
                </Viewbox>
            </Grid>

            <!-- Badge ring (theme-reactive) -->
            <Ellipse Width="96" Height="96" Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="3"/>

            <!-- Zzz (outside the clip so it floats above the hat) -->
            <Canvas x:Name="ZzzGroup" Width="96" Height="96" Opacity="0">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="ZzzFloatTr"/>
                </Canvas.RenderTransform>
                <TextBlock Canvas.Left="62" Canvas.Top="12" Text="z" FontFamily="{StaticResource AppFontFamily}"
                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AvatarZzzBrush}"/>
                <TextBlock Canvas.Left="72" Canvas.Top="5" Text="z" FontFamily="{StaticResource AppFontFamily}"
                           FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AvatarZzzBrush}"/>
                <TextBlock Canvas.Left="80" Canvas.Top="0" Text="z" FontFamily="{StaticResource AppFontFamily}"
                           FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource AvatarZzzBrush}"/>
            </Canvas>
        </Grid>
    </Viewbox>
</UserControl>
