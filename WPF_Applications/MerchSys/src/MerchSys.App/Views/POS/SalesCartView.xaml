<UserControl x:Class="Views.POS.SalesCartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MerchSys.POS.ViewModels;assembly=MerchSys.POS"
             xmlns:views="clr-namespace:MerchSys.App.Views.Shell"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1080"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Payment method button base style -->
        <Style x:Key="PayMethodButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Active payment method button -->
        <Style x:Key="PayMethodButtonActive" TargetType="Button" BasedOn="{StaticResource PayMethodButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <!-- Total row value -->
        <Style x:Key="TotalValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Grand total value -->
        <Style x:Key="GrandTotalValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
        </Style>

        <!-- Remove button inside DataGrid -->
        <Style x:Key="RemoveButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSubhead}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <!-- Left: Product Search -->
            <ColumnDefinition Width="260"/>
            <!-- Center: Cart -->
            <ColumnDefinition Width="*"/>
            <!-- Right: Payment + Receipt -->
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             LEFT PANEL — Product Search
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" Margin="0,0,8,0"
                CornerRadius="{DynamicResource RadiusMedium}" Effect="{DynamicResource CardShadow}">
            <DockPanel Margin="{DynamicResource SpacingM}">

                <!-- Header -->
                <TextBlock DockPanel.Dock="Top" Text="Product Search"
                           Style="{StaticResource SectionHeaderStyle}"/>

                <!-- Search box + button -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4"
                             BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                             VerticalContentAlignment="Center"
                             x:Name="ProductSearchBox"
                             TabIndex="1"/>
                    <Button Grid.Column="1" Content="Search"
                            Command="{Binding SearchProductCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="4,0,0,0" Padding="12,4" Cursor="Hand"
                            TabIndex="2"/>
                </Grid>

                <!-- Tip -->
                <TextBlock DockPanel.Dock="Top"
                           Text="Double-click a product to add it to the cart."
                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>

                <!-- Product list -->
                <ListBox x:Name="ProductList" TabIndex="3"
                         ItemsSource="{Binding ProductSearchResults}"
                         SelectedItem="{Binding SelectedProduct}"
                         BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6,4" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Product name -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding ProductName}"
                                               FontWeight="SemiBold" FontSize="{DynamicResource FontSizeBody}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                                    <!-- Price -->
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding UnitPrice, StringFormat={StaticResource FormatCurrency}}"
                                               FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" FontSize="{DynamicResource FontSizeBody}"/>

                                    <!-- SKU + Stock -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Sku}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text=" · " FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource SeparatorBrush}"/>
                                        <TextBlock FontSize="{DynamicResource FontSizeCaption}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AvailableStock}" Value="0">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="Stock: "/>
                                            <Run Text="{Binding AvailableStock}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             CENTER PANEL — Cart
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" Margin="0,0,8,0"
                CornerRadius="{DynamicResource RadiusMedium}" Effect="{DynamicResource CardShadow}">
            <DockPanel Margin="{DynamicResource SpacingM}">

                <!-- Header row -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Cart" Style="{StaticResource SectionHeaderStyle}"
                               VerticalAlignment="Center"/>
                    <Button Content="New Transaction"
                            Command="{Binding NewTransactionCommand}"
                            HorizontalAlignment="Right"
                            Padding="12,4"
                            Cursor="Hand"
                            TabIndex="4"/>
                </Grid>

                <!-- Totals (dock bottom) -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0"
                        Padding="0,8,0,0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition Height="8"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal" Style="{StaticResource CaptionLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding SubTotal, StringFormat={StaticResource FormatCurrency}}"
                                   Style="{StaticResource TotalValue}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Discount" Style="{StaticResource CaptionLabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding DiscountTotal, Converter={StaticResource SignedPesoConverter}}"
                                   Style="{StaticResource TotalValue}" Foreground="{DynamicResource DangerBrush}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="VAT (12%)" Style="{StaticResource CaptionLabelStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding VatAmount, StringFormat={StaticResource FormatCurrency}}"
                                   Style="{StaticResource TotalValue}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="GRAND TOTAL"
                                   FontSize="{DynamicResource FontSizeSubhead}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Text="{Binding GrandTotal, StringFormat={StaticResource FormatCurrency}}"
                                   Style="{StaticResource GrandTotalValue}"/>
                    </Grid>
                </Border>

                <!-- Status message -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSizeCaption}"
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}"/>

                <!-- Keyboard Shortcuts / Quick Actions Toolbar -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0"
                        Padding="0,6" Margin="0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <!-- Focus Qty cell of selected row -->
                            <Button Content="Set _Quantity (Ctrl+Q)"
                                    x:Name="SetQtyButton"
                                    Click="SetQtyButton_Click"
                                    Margin="0,0,8,0" Padding="8,4"
                                    TabIndex="20"/>
                            <!-- Focus Discount cell of selected row -->
                            <Button Content="Apply _Discount (Ctrl+D)"
                                    x:Name="ApplyDiscountButton"
                                    Click="ApplyDiscountButton_Click"
                                    Margin="0,0,8,0" Padding="8,4"
                                    TabIndex="21"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="_Hold"
                                    Command="{Binding HoldCartCommand}"
                                    Margin="0,0,8,0" Padding="8,4"
                                    TabIndex="22"/>
                            <Button Content="_Recall"
                                    Command="{Binding RecallCartCommand}"
                                    Padding="8,4"
                                    TabIndex="23">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasHeldCart}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cart DataGrid and Empty State -->
                <Grid>
                    <DataGrid x:Name="CartDataGrid"
                              ItemsSource="{Binding CartLines}"
                              SelectedItem="{Binding SelectedCartLine}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="1"
                              HeadersVisibility="Column"
                              TabIndex="5">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding ProductName, StringFormat='Cart item: \{0\}'}"/>
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding Quantity, StringFormat='Quantity: \{0\}'}"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <!-- Product -->
                            <DataGridTextColumn Header="Product" Width="*"
                                               Binding="{Binding ProductName}"
                                               IsReadOnly="True"/>

                            <!-- Qty (editable) -->
                            <DataGridTextColumn Header="Qty" Width="60"
                                                Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}"
                                                ElementStyle="{StaticResource NumericCellStyle}"
                                                HeaderStyle="{StaticResource RightAlignedHeaderStyle}"/>

                            <!-- Unit Price -->
                            <DataGridTextColumn Header="Unit Price" Width="90"
                                                Binding="{Binding UnitPrice, StringFormat={StaticResource FormatCurrency}}"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource NumericCellStyle}"
                                                HeaderStyle="{StaticResource RightAlignedHeaderStyle}"/>

                            <!-- Discount -->
                            <DataGridTextColumn Header="Discount" Width="80"
                                                Binding="{Binding DiscountAmount, UpdateSourceTrigger=LostFocus}"
                                                ElementStyle="{StaticResource NumericCellStyle}"
                                                HeaderStyle="{StaticResource RightAlignedHeaderStyle}"/>

                            <!-- Line Total -->
                            <DataGridTextColumn Header="Total" Width="90"
                                                Binding="{Binding LineTotal, StringFormat={StaticResource FormatCurrency}}"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource NumericCellStyle}"
                                                HeaderStyle="{StaticResource RightAlignedHeaderStyle}"/>

                            <!-- Remove -->
                            <DataGridTemplateColumn Header="" Width="36" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RemoveButton}"
                                                Command="{Binding DataContext.RemoveLineCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Remove from cart"
                                                AutomationProperties.Name="{Binding ProductName, StringFormat='Remove \{0\} from cart'}"
                                                AutomationProperties.HelpText="Removes this item from the active transaction.">
                                            <Path Style="{StaticResource IconBase}" Data="{StaticResource IconXMarkGeometry}"
                                                  Width="11" Height="11"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                    </DataGrid>

                    <views:EmptyStatePanel Title="Cart is empty"
                                           Description="Search and add products to start a sale."
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                        <views:EmptyStatePanel.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CartLines.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:EmptyStatePanel.Style>
                    </views:EmptyStatePanel>
                </Grid>

            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             RIGHT PANEL — Payment + Receipt
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                CornerRadius="{DynamicResource RadiusMedium}" Effect="{DynamicResource CardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="{DynamicResource SpacingM}">

                    <!-- Payment header -->
                    <TextBlock Text="Payment" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Payment method buttons -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Grid.Column="0"
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="Cash"
                                TabIndex="6"
                                AutomationProperties.Name="Select Cash payment method">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PayMethodButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCashSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Style="{StaticResource IconBase}" Data="{StaticResource IconCashGeometry}"
                                      Width="15" Height="15" Margin="0,0,6,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Cash" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="0" Grid.Column="1"
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="GCash"
                                TabIndex="7"
                                AutomationProperties.Name="Select GCash payment method">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PayMethodButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGCashSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Style="{StaticResource IconBase}" Data="{StaticResource IconPhoneGeometry}"
                                      Width="15" Height="15" Margin="0,0,6,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="GCash" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="0"
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="Bank"
                                TabIndex="8"
                                AutomationProperties.Name="Select Bank payment method">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PayMethodButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBankSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Style="{StaticResource IconBase}" Data="{StaticResource IconBankGeometry}"
                                      Width="15" Height="15" Margin="0,0,6,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Bank" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="1"
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="Credit"
                                TabIndex="9"
                                AutomationProperties.Name="Select Credit payment method">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PayMethodButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCreditSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Style="{StaticResource IconBase}" Data="{StaticResource IconClipboardGeometry}"
                                      Width="15" Height="15" Margin="0,0,6,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Credit" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Cash section -->
                    <StackPanel Visibility="{Binding IsCash, Converter={StaticResource BoolToVis}}">
                        <Label Content="Amount _Tendered (₱)"
                               Target="{Binding ElementName=AmountTenderedTextBox}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Padding="0" Margin="0,0,0,2"/>
                        <TextBox x:Name="AmountTenderedTextBox"
                                 Text="{Binding AmountTendered, UpdateSourceTrigger=PropertyChanged, StringFormat={StaticResource FormatQuantity}}"
                                 Padding="6,4" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                 HorizontalContentAlignment="Right" FontSize="{DynamicResource FontSizeSubhead}"
                                 TabIndex="10"/>

                        <TextBlock Text="Change" Style="{StaticResource CaptionLabelStyle}" Margin="0,8,0,2"/>
                        <TextBlock Text="{Binding ChangeAmount, StringFormat={StaticResource FormatCurrency}}"
                                   FontSize="{DynamicResource FontSizeSubhead}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>

                    <!-- Credit section -->
                    <StackPanel Visibility="{Binding IsCredit, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Customer" Style="{StaticResource CaptionLabelStyle}"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CreditCustomerSearch"
                                     Grid.Column="0"
                                     Text="{Binding CreditCustomerSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                     VerticalContentAlignment="Center"
                                     TabIndex="11"/>
                            <Button Grid.Column="1" Content="Find"
                                    Command="{Binding SearchCreditCustomerCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Margin="4,0,0,0" Padding="12,4" Cursor="Hand"
                                    TabIndex="12"/>
                        </Grid>

                        <ListBox ItemsSource="{Binding CreditCustomers}"
                                 SelectedItem="{Binding SelectedCreditCustomer}"
                                 MaxHeight="120"
                                 BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                 TabIndex="13">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4,2">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeBody}"/>
                                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="Balance: "/>
                                                <Run Text="{Binding CurrentBalance, Converter={StaticResource PesoConverter}}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Blocked indicator — NON-NEGOTIABLE: must be visible and Pay must be disabled -->
                        <Border Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusSmall}" Padding="8,6" Margin="0,6,0,0"
                                Visibility="{Binding IsCustomerBlocked, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding BlockedCustomerMessage}"
                                       Foreground="{DynamicResource DangerBrush}" FontWeight="Bold"
                                       TextWrapping="Wrap" FontSize="{DynamicResource FontSizeBody}"/>
                        </Border>
                    </StackPanel>

                    <!-- Separator -->
                    <Separator Margin="0,12"/>

                    <!-- PAY button -->
                    <Button Content="PAY"
                            Command="{Binding PayCommand}"
                            IsDefault="True"
                            Height="48" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="Bold"
                            Cursor="Hand"
                            TabIndex="14">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                        <Setter Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Busy indicator -->
                    <TextBlock Text="Processing…" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                    <!-- ═══ Receipt Preview ═══ -->
                    <Border Visibility="{Binding IsReceiptVisible, Converter={StaticResource BoolToVis}}"
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}"
                            Background="{DynamicResource SidebarBackgroundBrush}" Margin="0,12,0,0" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Official Receipt" FontWeight="Bold" FontSize="{DynamicResource FontSizeBody}"
                                       HorizontalAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Separator/>
                            <TextBlock Text="{Binding CurrentReceipt.BusinessName}"
                                       HorizontalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}" Margin="0,4,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding CurrentReceipt.BusinessAddress}"
                                       HorizontalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding CurrentReceipt.BusinessTIN, StringFormat='TIN: {0}'}"
                                       HorizontalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Separator Margin="0,6"/>
                            <Grid>
                                <TextBlock Text="Receipt No." FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CurrentReceipt.ReceiptNumber}"
                                           HorizontalAlignment="Right" FontWeight="Bold" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="Date" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CurrentReceipt.IssueDate, StringFormat={StaticResource FormatDateTime}}"
                                           HorizontalAlignment="Right" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Separator Margin="0,6"/>
                            <Grid>
                                <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding CurrentReceipt.TotalAmount, StringFormat={StaticResource FormatCurrency}}"
                                           HorizontalAlignment="Right" FontWeight="Bold"
                                           FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource SuccessBrush}"/>
                            </Grid>
                            <TextBlock Text="{Binding CurrentReceipt.VatAmount, Converter={StaticResource PesoConverter}, StringFormat='VAT: \{0\}'}"
                                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            <Separator Margin="0,6"/>
                            <TextBlock Text="Thank you!"
                                       HorizontalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <views:BusyOverlay Grid.ColumnSpan="3"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

        <views:ErrorStatePanel Grid.ColumnSpan="3"
                               Title="Search Failed"
                               Message="{Binding ErrorMessage}"
                               Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

    </Grid>
</UserControl>
