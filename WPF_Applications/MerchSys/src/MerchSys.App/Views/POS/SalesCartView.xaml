<UserControl x:Class="Views.POS.SalesCartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MerchSys.POS.ViewModels;assembly=MerchSys.POS"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1080"
             Background="#F5F6FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Payment method button base style -->
        <Style x:Key="PayMethodButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Active payment method button -->
        <Style x:Key="PayMethodButtonActive" TargetType="Button" BasedOn="{StaticResource PayMethodButton}">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2471A3"/>
        </Style>

        <!-- Section header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>

        <!-- Total row value -->
        <Style x:Key="TotalValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <!-- Grand total value -->
        <Style x:Key="GrandTotalValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="#27AE60"/>
        </Style>

        <!-- Remove button inside DataGrid -->
        <Style x:Key="RemoveButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E74C3C"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <!-- Left: Product Search -->
            <ColumnDefinition Width="260"/>
            <!-- Center: Cart -->
            <ColumnDefinition Width="*"/>
            <!-- Right: Payment + Receipt -->
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             LEFT PANEL — Product Search
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="White" Margin="0,0,6,0"
                BorderBrush="#DFE6E9" BorderThickness="1" CornerRadius="4">
            <DockPanel Margin="12">

                <!-- Header -->
                <TextBlock DockPanel.Dock="Top" Text="Product Search"
                           Style="{StaticResource SectionHeader}"/>

                <!-- Search box + button -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4"
                             BorderBrush="#BDC3C7" BorderThickness="1"
                             VerticalContentAlignment="Center"
                             x:Name="ProductSearchBox"/>
                    <Button Grid.Column="1" Content="Search"
                            Command="{Binding SearchProductCommand}"
                            Margin="4,0,0,0" Padding="8,4"
                            Background="#2980B9" Foreground="White"
                            BorderThickness="0" Cursor="Hand"/>
                </Grid>

                <!-- Tip -->
                <TextBlock DockPanel.Dock="Top"
                           Text="Double-click a product to add it to the cart."
                           FontSize="10" Foreground="#95A5A6" Margin="0,0,0,6"/>

                <!-- Product list -->
                <ListBox x:Name="ProductList"
                         ItemsSource="{Binding ProductSearchResults}"
                         SelectedItem="{Binding SelectedProduct}"
                         BorderBrush="#DFE6E9" BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6,4" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Product name -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding ProductName}"
                                               FontWeight="SemiBold" FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Price -->
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding UnitPrice, StringFormat='₱{0:N2}'}"
                                               FontWeight="Bold" Foreground="#27AE60" FontSize="12"/>

                                    <!-- SKU + Stock -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Sku}" FontSize="10" Foreground="#7F8C8D"/>
                                        <TextBlock Text=" · " FontSize="10" Foreground="#BDC3C7"/>
                                        <TextBlock FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#27AE60"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AvailableStock}" Value="0">
                                                            <Setter Property="Foreground" Value="#E74C3C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                            <Setter Property="Foreground" Value="#E67E22"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="Stock: "/>
                                            <Run Text="{Binding AvailableStock}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             CENTER PANEL — Cart
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="1" Background="White" Margin="0,0,6,0"
                BorderBrush="#DFE6E9" BorderThickness="1" CornerRadius="4">
            <DockPanel Margin="12">

                <!-- Header row -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Cart" Style="{StaticResource SectionHeader}"
                               VerticalAlignment="Center"/>
                    <Button Content="New Transaction"
                            Command="{Binding NewTransactionCommand}"
                            HorizontalAlignment="Right"
                            Padding="10,4" Background="#ECF0F1"
                            BorderThickness="1" BorderBrush="#BDC3C7"
                            Cursor="Hand"/>
                </Grid>

                <!-- Totals (dock bottom) -->
                <Border DockPanel.Dock="Bottom" BorderBrush="#DFE6E9" BorderThickness="0,1,0,0"
                        Padding="0,8,0,0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition Height="8"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding SubTotal, StringFormat='₱{0:N2}'}"
                                   Style="{StaticResource TotalValue}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Discount" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding DiscountTotal, StringFormat='− ₱{0:N2}'}"
                                   Style="{StaticResource TotalValue}" Foreground="#E74C3C"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="VAT (12%)" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding VatAmount, StringFormat='₱{0:N2}'}"
                                   Style="{StaticResource TotalValue}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="GRAND TOTAL"
                                   FontSize="14" FontWeight="Bold" Foreground="#2C3E50"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Text="{Binding GrandTotal, StringFormat='₱{0:N2}'}"
                                   Style="{StaticResource GrandTotalValue}"/>
                    </Grid>
                </Border>

                <!-- Status message -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding StatusMessage}"
                           Foreground="#E74C3C" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}"/>

                <!-- Cart DataGrid -->
                <DataGrid x:Name="CartDataGrid"
                          ItemsSource="{Binding CartLines}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#DFE6E9" BorderThickness="1"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFBFC"
                          HeadersVisibility="Column">

                    <DataGrid.Columns>
                        <!-- Product -->
                        <DataGridTextColumn Header="Product" Width="*"
                                           Binding="{Binding ProductName}"
                                           IsReadOnly="True"/>

                        <!-- Qty (editable) -->
                        <DataGridTextColumn Header="Qty" Width="60"
                                            Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}"/>

                        <!-- Unit Price -->
                        <DataGridTextColumn Header="Unit Price" Width="90"
                                            Binding="{Binding UnitPrice, StringFormat='₱{0:N2}'}"
                                            IsReadOnly="True"/>

                        <!-- Discount -->
                        <DataGridTextColumn Header="Discount" Width="80"
                                            Binding="{Binding DiscountAmount, UpdateSourceTrigger=LostFocus}"/>

                        <!-- Line Total -->
                        <DataGridTextColumn Header="Total" Width="90"
                                            Binding="{Binding LineTotal, StringFormat='₱{0:N2}'}"
                                            IsReadOnly="True"/>

                        <!-- Remove -->
                        <DataGridTemplateColumn Header="" Width="36" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕"
                                            Style="{StaticResource RemoveButton}"
                                            Command="{Binding DataContext.RemoveLineCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                </DataGrid>

            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             RIGHT PANEL — Payment + Receipt
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="2" Background="White"
                BorderBrush="#DFE6E9" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">

                    <!-- Payment header -->
                    <TextBlock Text="Payment" Style="{StaticResource SectionHeader}"/>

                    <!-- Payment method buttons -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Content="💵 Cash"
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="Cash">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PayMethodButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCashSelected}" Value="True">
                                            <Setter Property="Background" Value="#2980B9"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#2471A3"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Row="0" Grid.Column="1" Content="📱 GCash"
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="GCash">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PayMethodButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGCashSelected}" Value="True">
                                            <Setter Property="Background" Value="#2980B9"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#2471A3"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="0" Content="🏦 Bank"
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="Bank">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PayMethodButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBankSelected}" Value="True">
                                            <Setter Property="Background" Value="#2980B9"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#2471A3"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="1" Content="📋 Credit"
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="Credit">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PayMethodButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCreditSelected}" Value="True">
                                            <Setter Property="Background" Value="#8E44AD"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#7D3C98"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Cash section -->
                    <StackPanel Visibility="{Binding IsCash, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Amount Tendered (₱)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding AmountTendered, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}"
                                 Padding="6,4" BorderBrush="#BDC3C7" BorderThickness="1"
                                 HorizontalContentAlignment="Right" FontSize="14"/>

                        <TextBlock Text="Change" Style="{StaticResource FieldLabel}" Margin="0,8,0,2"/>
                        <TextBlock Text="{Binding ChangeAmount, StringFormat='₱{0:N2}'}"
                                   FontSize="16" FontWeight="Bold" Foreground="#27AE60"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>

                    <!-- Credit section -->
                    <StackPanel Visibility="{Binding IsCredit, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Customer" Style="{StaticResource FieldLabel}"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding CreditCustomerSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4" BorderBrush="#BDC3C7" BorderThickness="1"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Find"
                                    Command="{Binding SearchCreditCustomerCommand}"
                                    Margin="4,0,0,0" Padding="8,4"
                                    Background="#8E44AD" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <ListBox ItemsSource="{Binding CreditCustomers}"
                                 SelectedItem="{Binding SelectedCreditCustomer}"
                                 MaxHeight="120"
                                 BorderBrush="#DFE6E9" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4,2">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock FontSize="10" Foreground="#7F8C8D">
                                                <Run Text="Balance: ₱"/>
                                                <Run Text="{Binding CurrentBalance, StringFormat='N2'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Blocked indicator — NON-NEGOTIABLE: must be visible and Pay must be disabled -->
                        <Border Background="#FDEDEC" BorderBrush="#E74C3C" BorderThickness="1"
                                CornerRadius="3" Padding="8,6" Margin="0,6,0,0"
                                Visibility="{Binding IsCustomerBlocked, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding BlockedCustomerMessage}"
                                       Foreground="#E74C3C" FontWeight="Bold"
                                       TextWrapping="Wrap" FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <!-- Separator -->
                    <Separator Margin="0,12"/>

                    <!-- PAY button -->
                    <Button Content="PAY"
                            Command="{Binding PayCommand}"
                            Height="48" FontSize="16" FontWeight="Bold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#27AE60"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#BDC3C7"/>
                                        <Setter Property="Foreground" Value="#7F8C8D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Busy indicator -->
                    <TextBlock Text="Processing…" FontSize="11" Foreground="#7F8C8D"
                               HorizontalAlignment="Center" Margin="0,4,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                    <!-- ═══ Receipt Preview ═══ -->
                    <Border Visibility="{Binding IsReceiptVisible, Converter={StaticResource BoolToVis}}"
                            BorderBrush="#DFE6E9" BorderThickness="1" CornerRadius="4"
                            Background="#FDFEFE" Margin="0,12,0,0" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Official Receipt" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <Separator/>
                            <TextBlock Text="{Binding CurrentReceipt.BusinessName}"
                                       HorizontalAlignment="Center" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding CurrentReceipt.BusinessAddress}"
                                       HorizontalAlignment="Center" FontSize="10"
                                       Foreground="#7F8C8D" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding CurrentReceipt.BusinessTIN, StringFormat='TIN: {0}'}"
                                       HorizontalAlignment="Center" FontSize="10" Foreground="#7F8C8D"/>
                            <Separator Margin="0,6"/>
                            <Grid>
                                <TextBlock Text="Receipt No." FontSize="11" Foreground="#7F8C8D"/>
                                <TextBlock Text="{Binding CurrentReceipt.ReceiptNumber}"
                                           HorizontalAlignment="Right" FontWeight="Bold" FontSize="11"/>
                            </Grid>
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="Date" FontSize="11" Foreground="#7F8C8D"/>
                                <TextBlock Text="{Binding CurrentReceipt.IssueDate, StringFormat='MM/dd/yyyy HH:mm'}"
                                           HorizontalAlignment="Right" FontSize="11"/>
                            </Grid>
                            <Separator Margin="0,6"/>
                            <Grid>
                                <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="{Binding CurrentReceipt.TotalAmount, StringFormat='₱{0:N2}'}"
                                           HorizontalAlignment="Right" FontWeight="Bold"
                                           FontSize="13" Foreground="#27AE60"/>
                            </Grid>
                            <TextBlock Text="{Binding CurrentReceipt.VatAmount, StringFormat='VAT: ₱{0:N2}'}"
                                       FontSize="10" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                            <Separator Margin="0,6"/>
                            <TextBlock Text="Thank you!"
                                       HorizontalAlignment="Center" FontSize="11"
                                       Foreground="#7F8C8D" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</UserControl>
