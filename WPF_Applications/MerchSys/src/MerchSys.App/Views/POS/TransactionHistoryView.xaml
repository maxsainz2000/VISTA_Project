<UserControl x:Class="Views.POS.TransactionHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MerchSys.POS.ViewModels;assembly=MerchSys.POS"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="#F5F6FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="ReceiptLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <Style x:Key="ReceiptValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2471A3"/>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#219A52"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#C0392B"/>
        </Style>

        <Style x:Key="NeutralButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
        </Style>

        <!-- DataGrid base style for read-only display grids -->
        <Style x:Key="ReadOnlyGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#ECF0F1"/>
            <Setter Property="BorderBrush" Value="#DDE1E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="RowHeight" Value="28"/>
        </Style>

        <!-- DataGrid column header style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F3F7"/>
            <Setter Property="Foreground" Value="#5D6D7E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#DDE1E7"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT                                                            -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Row 0: Filter bar ─────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#DDE1E7"
                    BorderThickness="0,0,0,1"
                    Padding="16,12">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Date From -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                        <TextBlock Text="From:" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="DateFromPicker"
                                    SelectedDate="{Binding DateFrom, Mode=TwoWay}"
                                    Width="120" Height="30" FontSize="12"/>
                    </StackPanel>

                    <!-- Date To -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                        <TextBlock Text="To:" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="DateToPicker"
                                    SelectedDate="{Binding DateTo, Mode=TwoWay}"
                                    Width="120" Height="30" FontSize="12"/>
                    </StackPanel>

                    <!-- TX Number -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                        <TextBlock Text="TX #:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxNumberBox"
                                 Text="{Binding TxNumberFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Width="130" Height="30" Padding="8,0"
                                 FontSize="12" VerticalContentAlignment="Center"
                                 BorderBrush="#BDC3C7" BorderThickness="1"/>
                    </StackPanel>

                    <!-- Payment Method -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                        <TextBlock Text="Payment:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding PaymentMethodFilters}"
                                  SelectedItem="{Binding SelectedPaymentMethodFilter}"
                                  Width="110" Height="30" FontSize="12"/>
                    </StackPanel>

                    <!-- Search button -->
                    <Button Content="Search"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchCommand}"
                            Margin="0,0,6,4"/>

                    <!-- Clear button -->
                    <Button Content="Clear Filters"
                            Style="{StaticResource NeutralButton}"
                            Command="{Binding ClearFiltersCommand}"
                            Margin="0,0,0,4"/>

                    <!-- Busy indicator -->
                    <ProgressBar IsIndeterminate="True"
                                 Width="80" Height="4"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </WrapPanel>
            </Border>

            <!-- ── Row 1: Split view ──────────────────────────────────────────────── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="390" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Transaction DataGrid ──────────────────────────────────── -->
                <Border Grid.Column="0"
                        Margin="12,12,0,12"
                        BorderBrush="#DDE1E7"
                        BorderThickness="1"
                        Background="White">
                    <DataGrid x:Name="TransactionGrid"
                              Style="{StaticResource ReadOnlyGrid}"
                              ItemsSource="{Binding Transactions}"
                              BorderThickness="0">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                        <Setter Property="Background" Value="#FFF5F5"/>
                                        <Setter Property="Foreground" Value="#C0392B"/>
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EBF5FB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TX Number"
                                                Binding="{Binding TransactionNumber}"
                                                Width="110"/>
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding TransactionDate, StringFormat='{}{0:MM/dd/yy HH:mm}'}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Customer"
                                                Binding="{Binding CustomerName}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Payment"
                                                Binding="{Binding PaymentMethod}"
                                                Width="80"/>
                            <DataGridTextColumn Header="Total"
                                                Binding="{Binding TotalAmount, StringFormat='₱{0:N2}'}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Items"
                                                Binding="{Binding ItemCount}"
                                                Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Returns"
                                                Binding="{Binding HasReturnsText}"
                                                Width="65">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding StatusText}"
                                                Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- GridSplitter -->
                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Stretch"
                              Background="#E8ECF0"
                              ShowsPreview="True"/>

                <!-- Right: Detail panel ─────────────────────────────────────────── -->
                <Grid Grid.Column="2" Margin="0,12,12,12">

                    <!-- Empty state -->
                    <TextBlock VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="#BDC3C7"
                               FontSize="13"
                               TextAlignment="Center"
                               Text="Select a transaction&#x0a;to view details">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDetailVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Detail content -->
                    <Grid Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Detail scroll area -->
                        <Border Grid.Row="0"
                                BorderBrush="#DDE1E7"
                                BorderThickness="1"
                                Background="White">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                                <StackPanel>

                                    <!-- Transaction header -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#2C3E50"
                                                   Text="{Binding SelectedTransaction.TransactionNumber}"/>
                                        <Border Margin="8,2,0,0" Padding="6,1" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#EAFAF1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedTransaction.IsVoided}" Value="True">
                                                            <Setter Property="Background" Value="#FDEDEC"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                                       Text="{Binding SelectedTransaction.StatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#27AE60"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedTransaction.IsVoided}" Value="True">
                                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- ── Line Items section ──────────────────────── -->
                                    <TextBlock Text="LINE ITEMS" Style="{StaticResource SectionHeader}"/>
                                    <DataGrid Style="{StaticResource ReadOnlyGrid}"
                                              ItemsSource="{Binding DetailLines}"
                                              Height="140"
                                              SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Product"
                                                                Binding="{Binding ProductName}"
                                                                Width="*"/>
                                            <DataGridTextColumn Header="Qty"
                                                                Binding="{Binding Quantity}"
                                                                Width="40">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Price"
                                                                Binding="{Binding UnitPrice, StringFormat='₱{0:N2}'}"
                                                                Width="70">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Padding" Value="0,0,4,0"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Total"
                                                                Binding="{Binding LineTotal, StringFormat='₱{0:N2}'}"
                                                                Width="70">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Padding" Value="0,0,4,0"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- ── Receipt Info section ────────────────────── -->
                                    <TextBlock Text="OFFICIAL RECEIPT" Style="{StaticResource SectionHeader}"/>
                                    <Border Padding="10,8" Background="#F9FAFB"
                                            BorderBrush="#DDE1E7" BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Receipt No.:" Style="{StaticResource ReceiptLabel}" Width="90"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReceiptNumber}" Style="{StaticResource ReceiptValue}"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Issue Date:" Style="{StaticResource ReceiptLabel}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReceiptDate}" Style="{StaticResource ReceiptValue}"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Business:" Style="{StaticResource ReceiptLabel}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReceiptBusinessName}" Style="{StaticResource ReceiptValue}" TextWrapping="Wrap"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="TIN:" Style="{StaticResource ReceiptLabel}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ReceiptTin}" Style="{StaticResource ReceiptValue}"/>
                                        </Grid>
                                    </Border>

                                    <!-- No receipt fallback -->
                                    <TextBlock Text="No receipt on file for this transaction."
                                               Foreground="#BDC3C7" FontSize="11" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasReceipt}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- ── Returns section ────────────────────────── -->
                                    <TextBlock Text="RETURNS" Style="{StaticResource SectionHeader}"/>
                                    <DataGrid Style="{StaticResource ReadOnlyGrid}"
                                              ItemsSource="{Binding DetailReturns}"
                                              Height="120"
                                              SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Date"
                                                                Binding="{Binding ReturnDate, StringFormat='{}{0:MM/dd/yy}'}"
                                                                Width="65"/>
                                            <DataGridTextColumn Header="Product"
                                                                Binding="{Binding ProductName}"
                                                                Width="*"/>
                                            <DataGridTextColumn Header="Qty"
                                                                Binding="{Binding QuantityReturned}"
                                                                Width="38">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Refund"
                                                                Binding="{Binding RefundAmount, StringFormat='₱{0:N2}'}"
                                                                Width="70">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Padding" Value="0,0,4,0"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Restocked"
                                                                Binding="{Binding RestockedText}"
                                                                Width="68">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Text="No returns for this transaction."
                                               Foreground="#BDC3C7" FontSize="11" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DetailReturns.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Action buttons -->
                        <Border Grid.Row="1" Padding="0,8,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="View Receipt"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ViewReceiptCommand}"
                                        Margin="0,0,6,0"/>
                                <Button Content="Process Return"
                                        Style="{StaticResource SuccessButton}"
                                        Command="{Binding OpenReturnDialogCommand}"
                                        IsEnabled="{Binding CanEdit}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ── Row 2: Status bar ──────────────────────────────────────────────── -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#DDE1E7"
                    BorderThickness="0,1,0,0"
                    Padding="16,8">
                <TextBlock FontSize="12" VerticalAlignment="Center"
                           Text="{Binding StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#27AE60"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusSuccess}" Value="False">
                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- RETURN DIALOG OVERLAY                                                   -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <Grid Background="#AA000000"
              Visibility="{Binding IsReturnDialogVisible, Converter={StaticResource BoolToVis}}">

            <Border Background="White"
                    Width="460"
                    CornerRadius="6"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.25" ShadowDepth="4" Direction="270"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Dialog header -->
                    <TextBlock Text="Process Return"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#2C3E50" Margin="0,0,0,4"/>
                    <TextBlock FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,16"
                               Text="{Binding SelectedTransaction.TransactionNumber,
                                              StringFormat='Transaction: {0}'}"/>

                    <Separator Margin="0,0,0,16" Background="#ECF0F1"/>

                    <!-- Product selection -->
                    <TextBlock Text="Product to Return" Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ReturnableLines}"
                              SelectedItem="{Binding SelectedReturnLine}"
                              DisplayMemberPath="DisplayText"
                              Height="32" FontSize="12"
                              Margin="0,0,0,14"/>

                    <!-- Quantity -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Return Quantity" Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="ReturnQtyBox"
                                     Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32" Padding="10,0"
                                     FontSize="12" VerticalContentAlignment="Center"
                                     BorderBrush="#BDC3C7" BorderThickness="1"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Maximum" Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,4"/>
                            <Border Height="32" Background="#F9FAFB"
                                    BorderBrush="#DDE1E7" BorderThickness="1"
                                    Padding="10,0">
                                <TextBlock Text="{Binding ReturnMaxQty}"
                                           VerticalAlignment="Center"
                                           FontSize="12" Foreground="#2C3E50"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Reason -->
                    <TextBlock Margin="0,0,0,4" FontSize="11" Foreground="#7F8C8D">
                        <Run Text="Reason"/>
                        <Run Text=" *" Foreground="#E74C3C" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBox Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}"
                             Height="64"
                             Padding="10,8"
                             FontSize="12"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             BorderBrush="#BDC3C7" BorderThickness="1"
                             Margin="0,0,0,14"/>

                    <!-- Restock checkbox -->
                    <CheckBox IsChecked="{Binding ShouldRestock}"
                              Content="Restock items back to inventory"
                              FontSize="12" Foreground="#2C3E50"
                              Margin="0,0,0,20"/>

                    <Separator Margin="0,0,0,16" Background="#ECF0F1"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{StaticResource NeutralButton}"
                                Command="{Binding CancelReturnCommand}"
                                Width="90" Margin="0,0,10,0"/>
                        <Button Content="Confirm Return"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding ProcessReturnCommand}"
                                Width="130"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
