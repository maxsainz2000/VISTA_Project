<UserControl x:Class="Views.POS.VatSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="800"
             Background="#F5F6FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE6E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#636E72"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#DFE6E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDC3C7"/>
                    <Setter Property="Foreground" Value="#7F8C8D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReloadButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#7F8C8D"/>
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C0392B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="14">

        <!-- ═══════════════════════════════════════════════════════════
             TOOLBAR
             ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="White" BorderBrush="#DFE6E9" BorderThickness="1"
                CornerRadius="4" Padding="14,8" Margin="0,0,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VAT Settings" FontSize="14" FontWeight="Bold"
                               Foreground="#2C3E50" VerticalAlignment="Center"/>
                    <TextBlock Text=" — BIR Registration &amp; Tax Rates" FontSize="12"
                               Foreground="#7F8C8D" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Saving…" FontSize="10" Foreground="#7F8C8D"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Reload" Command="{Binding ReloadCommand}"
                            Style="{StaticResource ReloadButton}" Margin="0,0,6,0"/>
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            Style="{StaticResource ActionButton}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             VALIDATION ERRORS
             ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="#FDEDEC" BorderBrush="#E74C3C" BorderThickness="1"
                CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ValidationErrors.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ItemsControl ItemsSource="{Binding ValidationErrors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource ErrorText}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             REGISTRATION STATUS
             ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="Registration Status" FontSize="13" FontWeight="Bold"
                           Foreground="#2C3E50" Margin="0,0,0,12"/>

                <CheckBox IsChecked="{Binding IsVatRegistered, Mode=TwoWay}"
                          FontSize="12" Foreground="#2C3E50" Cursor="Hand">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Business is VAT-registered with BIR"/>
                        <LineBreak/>
                        <Run Text="(Applies when annual gross sales exceed ₱3M)" FontSize="10" Foreground="#7F8C8D"/>
                    </TextBlock>
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             TAX RATES  (two-column grid)
             ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="Tax Rates" FontSize="13" FontWeight="Bold"
                           Foreground="#2C3E50" Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TIN (visible only when VAT-registered) -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="TIN (BIR)"
                               Style="{StaticResource FieldLabel}"
                               Visibility="{Binding IsVatRegistered, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding Tin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInput}"
                             Visibility="{Binding IsVatRegistered, Converter={StaticResource BoolToVis}}"
                             MaxLength="20"/>

                    <!-- VAT Rate (visible only when VAT-registered) -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="VAT Rate (%)"
                               Style="{StaticResource FieldLabel}"
                               Visibility="{Binding IsVatRegistered, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding VatRatePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInput}"
                             Visibility="{Binding IsVatRegistered, Converter={StaticResource BoolToVis}}"
                             MaxLength="6"/>

                    <!-- Percentage Tax Rate (visible only when NOT VAT-registered) -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Percentage Tax Rate (%)"
                               Style="{StaticResource FieldLabel}"
                               Visibility="{Binding IsNotVatRegistered, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding PercentageTaxRatePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInput}"
                             Visibility="{Binding IsNotVatRegistered, Converter={StaticResource BoolToVis}}"
                             MaxLength="6"/>

                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             BUSINESS INFORMATION  (two-column grid)
             ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="Business Information" FontSize="13" FontWeight="Bold"
                           Foreground="#2C3E50" Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Registered Business Name"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding RegisteredBusinessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInput}"
                             MaxLength="200"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Registered Address"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding RegisteredAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInput}"
                             AcceptsReturn="True" MinHeight="60" MaxHeight="100"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             MaxLength="500"/>

                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             STATUS MESSAGE
             ═══════════════════════════════════════════════════════════ -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding StatusMessage}"
                   FontSize="11" Foreground="#636E72"
                   Margin="2,0,0,0" TextWrapping="Wrap"/>

    </DockPanel>

</UserControl>
