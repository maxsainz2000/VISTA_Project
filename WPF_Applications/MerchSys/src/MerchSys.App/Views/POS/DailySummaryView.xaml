<UserControl x:Class="Views.POS.DailySummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MerchSys.POS.ViewModels;assembly=MerchSys.POS"
             xmlns:views="clr-namespace:MerchSys.App.Views.Shell"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Mode toggle button — inactive state -->
        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
        </Style>

        <Style x:Key="ReadOnlyGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
            <Setter Property="RowHeight" Value="28"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- Row 0 — Period selector header                                          -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel>

                <!-- Line 1: Mode buttons + period header + Prev/Next + Refresh -->
                <DockPanel Margin="0,0,0,8">

                    <!-- Mode toggle buttons (left) -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,20,0">

                        <Button Command="{Binding SetDailyModeCommand}" Content="Daily"
                                Margin="0,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDailyMode}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding SetWeeklyModeCommand}" Content="Weekly"
                                Margin="4,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWeeklyMode}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding SetMonthlyModeCommand}" Content="Monthly"
                                Margin="4,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonthlyMode}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Refresh + BusyBar (right) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                     Width="70" Height="4"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Refresh"
                                Command="{Binding LoadCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>

                    <!-- Prev / Period Header / Next (center) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="◄"
                                Command="{Binding PrevPeriodCommand}"
                                Style="{StaticResource NavButton}"
                                Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding PeriodHeader}"
                                   FontSize="{DynamicResource FontSizeSubhead}" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   MinWidth="220" TextAlignment="Center"/>
                        <Button Content="►"
                                Command="{Binding NextPeriodCommand}"
                                Style="{StaticResource NavButton}"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Line 2: Period-specific input controls -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Daily: date picker -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDailyMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Date:" Style="{StaticResource CaptionLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                    Width="130" Height="28" FontSize="12"/>
                    </StackPanel>

                    <!-- Weekly: any-date picker + week range label -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWeeklyMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Any date in week:" Style="{StaticResource CaptionLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding WeekDate, Mode=TwoWay}"
                                    Width="130" Height="28" FontSize="12"
                                    Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding WeekRangeDisplay}"
                                   FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" FontStyle="Italic"/>
                    </StackPanel>

                    <!-- Monthly: month and year combo boxes -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonthlyMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Month:" Style="{StaticResource CaptionLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding AvailableMonths}"
                                  SelectedIndex="{Binding SelectedMonthIndex, Mode=TwoWay}"
                                  Width="110" Height="28" FontSize="12"
                                  Margin="0,0,10,0"/>
                        <TextBlock Text="Year:" Style="{StaticResource CaptionLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding AvailableYears}"
                                  SelectedItem="{Binding SelectedYear, Mode=TwoWay}"
                                  Width="72" Height="28" FontSize="12"/>
                    </StackPanel>

                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- Row 1 — Content                                                         -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,12,12,12">

                <!-- ── KPI Summary Cards ──────────────────────────────────────── -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">

                    <!-- Total Sales -->
                    <Border Width="210" Margin="0,0,12,0" Style="{StaticResource PrimaryMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="TOTAL SALES" Style="{StaticResource CaptionLabelStyle}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalSalesDisplay}"
                                           Style="{StaticResource PrimaryMetricValueStyle}" Foreground="{DynamicResource SuccessBrush}"
                                           VerticalAlignment="Center"/>
                                <views:DeltaIndicator Percent="{Binding SalesDeltaPercent}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TX Count -->
                    <Border Width="165" Margin="0,0,12,0" Style="{StaticResource SecondaryMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="TRANSACTIONS" Style="{StaticResource CaptionLabelStyle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding TransactionCount}"
                                       Style="{StaticResource SecondaryMetricValueStyle}" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Avg TX Value -->
                    <Border Width="210" Margin="0,0,12,0" Style="{StaticResource SecondaryMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="AVG TRANSACTION" Style="{StaticResource CaptionLabelStyle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding AvgTransactionDisplay}"
                                       Style="{StaticResource SecondaryMetricValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Returns -->
                    <Border Width="230" Style="{StaticResource SecondaryMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="RETURNS" Style="{StaticResource CaptionLabelStyle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding ReturnsDisplay}"
                                       Style="{StaticResource SecondaryMetricValueStyle}" Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>
                    </Border>

                </WrapPanel>

                <!-- ── Payment Breakdown + Top Products ───────────────────────── -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Payment Method Breakdown -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}" Padding="14,12"
                            Effect="{DynamicResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="PAYMENT METHOD BREAKDOWN" Style="{StaticResource SectionHeaderStyle}"/>
                            <DataGrid Style="{StaticResource ReadOnlyGrid}"
                                      ItemsSource="{Binding PaymentBreakdown}"
                                      BorderThickness="0"
                                      MinHeight="100">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Method"
                                                        Binding="{Binding PaymentMethod}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Count"
                                                        Binding="{Binding Count}"
                                                        Width="55">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Total"
                                                        Binding="{Binding Total, StringFormat='₱{0:N2}'}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="0,0,8,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="%"
                                                        Binding="{Binding Percentage, StringFormat='{}{0:N1}%'}"
                                                        Width="55">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="0,0,8,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="No transactions in this period."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PaymentBreakdown.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Right: Top 5 Products -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}" Padding="14,12"
                            Effect="{DynamicResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="TOP 5 SELLING PRODUCTS" Style="{StaticResource SectionHeaderStyle}"/>
                            <DataGrid Style="{StaticResource ReadOnlyGrid}"
                                      ItemsSource="{Binding TopProducts}"
                                      BorderThickness="0"
                                      MinHeight="100">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Product"
                                                        Binding="{Binding ProductName}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Qty Sold"
                                                        Binding="{Binding QuantitySold}"
                                                        Width="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Revenue"
                                                        Binding="{Binding TotalRevenue, StringFormat='₱{0:N2}'}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="0,0,8,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="No sales data in this period."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopProducts.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Daily Trend Chart (weekly / monthly only) ──────────────── -->
                <Border Visibility="{Binding IsTrendVisible, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSmall}" Padding="14,12"
                        Effect="{DynamicResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="DAILY SALES TREND" Style="{StaticResource SectionHeaderStyle}"/>

                        <TextBlock Text="No data to display."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TrendBars.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Height="140">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TrendBars.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl ItemsSource="{Binding TrendBars}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel MinWidth="20" Margin="1,0"
                                                    ToolTip="{Binding TooltipText}"
                                                    VerticalAlignment="Stretch">
                                            <!-- Bar area: fixed 110px, bar anchored to bottom -->
                                            <Grid Height="110">
                                                <Rectangle VerticalAlignment="Bottom"
                                                           HorizontalAlignment="Center"
                                                           Width="16"
                                                           Height="{Binding BarHeight}"
                                                           Fill="{DynamicResource AccentBrush}"
                                                           RadiusX="2" RadiusY="2"/>
                                            </Grid>
                                            <!-- Label below bar -->
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="8"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Margin="0,2,0,0"
                                                       MaxWidth="30"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- Row 2 — Status bar                                                      -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <TextBlock FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center"
                       Text="{Binding StatusMessage}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusSuccess}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <views:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

    </Grid>
</UserControl>
