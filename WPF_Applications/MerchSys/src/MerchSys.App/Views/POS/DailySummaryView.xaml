<UserControl x:Class="Views.POS.DailySummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MerchSys.POS.ViewModels;assembly=MerchSys.POS"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             Background="#F5F6FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Mode toggle button — inactive state -->
        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#5D6D7E"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2471A3"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#5D6D7E"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ReadOnlyGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#ECF0F1"/>
            <Setter Property="BorderBrush" Value="#DDE1E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="RowHeight" Value="28"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F3F7"/>
            <Setter Property="Foreground" Value="#5D6D7E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#DDE1E7"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- Row 0 — Period selector header                                          -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DDE1E7"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel>

                <!-- Line 1: Mode buttons + period header + Prev/Next + Refresh -->
                <DockPanel Margin="0,0,0,8">

                    <!-- Mode toggle buttons (left) -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,20,0">

                        <Button Command="{Binding SetDailyModeCommand}" Content="Daily"
                                Margin="0,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDailyMode}" Value="True">
                                            <Setter Property="Background" Value="#2980B9"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#2471A3"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding SetWeeklyModeCommand}" Content="Weekly"
                                Margin="4,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWeeklyMode}" Value="True">
                                            <Setter Property="Background" Value="#2980B9"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#2471A3"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding SetMonthlyModeCommand}" Content="Monthly"
                                Margin="4,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonthlyMode}" Value="True">
                                            <Setter Property="Background" Value="#2980B9"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#2471A3"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Refresh + BusyBar (right) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                     Width="70" Height="4"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Refresh"
                                Command="{Binding LoadCommand}"
                                Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>

                    <!-- Prev / Period Header / Next (center) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="◄"
                                Command="{Binding PrevPeriodCommand}"
                                Style="{StaticResource NavButton}"
                                Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding PeriodHeader}"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Center"
                                   MinWidth="220" TextAlignment="Center"/>
                        <Button Content="►"
                                Command="{Binding NextPeriodCommand}"
                                Style="{StaticResource NavButton}"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Line 2: Period-specific input controls -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Daily: date picker -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDailyMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Date:" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                    Width="130" Height="28" FontSize="12"/>
                    </StackPanel>

                    <!-- Weekly: any-date picker + week range label -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWeeklyMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Any date in week:" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding WeekDate, Mode=TwoWay}"
                                    Width="130" Height="28" FontSize="12"
                                    Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding WeekRangeDisplay}"
                                   FontSize="12" Foreground="#2C3E50"
                                   VerticalAlignment="Center" FontStyle="Italic"/>
                    </StackPanel>

                    <!-- Monthly: month and year combo boxes -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonthlyMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Month:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableMonths}"
                                  SelectedIndex="{Binding SelectedMonthIndex, Mode=TwoWay}"
                                  Width="110" Height="28" FontSize="12"
                                  Margin="0,0,10,0"/>
                        <TextBlock Text="Year:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableYears}"
                                  SelectedItem="{Binding SelectedYear, Mode=TwoWay}"
                                  Width="72" Height="28" FontSize="12"/>
                    </StackPanel>

                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- Row 1 — Content                                                         -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,12,12,12">

                <!-- ── KPI Summary Cards ──────────────────────────────────────── -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">

                    <!-- Total Sales -->
                    <Border Width="210" Margin="0,0,12,0"
                            Background="White" BorderBrush="#DDE1E7" BorderThickness="1"
                            CornerRadius="4" Padding="16,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" Opacity="0.06" ShadowDepth="2" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="TOTAL SALES" FontSize="10" FontWeight="Bold"
                                       Foreground="#7F8C8D" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding TotalSalesDisplay}"
                                       FontSize="22" FontWeight="Bold" Foreground="#27AE60"/>
                        </StackPanel>
                    </Border>

                    <!-- TX Count -->
                    <Border Width="165" Margin="0,0,12,0"
                            Background="White" BorderBrush="#DDE1E7" BorderThickness="1"
                            CornerRadius="4" Padding="16,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" Opacity="0.06" ShadowDepth="2" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="TRANSACTIONS" FontSize="10" FontWeight="Bold"
                                       Foreground="#7F8C8D" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding TransactionCount}"
                                       FontSize="22" FontWeight="Bold" Foreground="#2980B9"/>
                        </StackPanel>
                    </Border>

                    <!-- Avg TX Value -->
                    <Border Width="210" Margin="0,0,12,0"
                            Background="White" BorderBrush="#DDE1E7" BorderThickness="1"
                            CornerRadius="4" Padding="16,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" Opacity="0.06" ShadowDepth="2" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="AVG TRANSACTION" FontSize="10" FontWeight="Bold"
                                       Foreground="#7F8C8D" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding AvgTransactionDisplay}"
                                       FontSize="22" FontWeight="Bold" Foreground="#8E44AD"/>
                        </StackPanel>
                    </Border>

                    <!-- Returns -->
                    <Border Width="230"
                            Background="White" BorderBrush="#DDE1E7" BorderThickness="1"
                            CornerRadius="4" Padding="16,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" Opacity="0.06" ShadowDepth="2" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="RETURNS" FontSize="10" FontWeight="Bold"
                                       Foreground="#7F8C8D" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding ReturnsDisplay}"
                                       FontSize="22" FontWeight="Bold" Foreground="#E67E22"/>
                        </StackPanel>
                    </Border>

                </WrapPanel>

                <!-- ── Payment Breakdown + Top Products ───────────────────────── -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Payment Method Breakdown -->
                    <Border Grid.Column="0"
                            Background="White" BorderBrush="#DDE1E7" BorderThickness="1"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="PAYMENT METHOD BREAKDOWN" Style="{StaticResource SectionHeader}"/>
                            <DataGrid Style="{StaticResource ReadOnlyGrid}"
                                      ItemsSource="{Binding PaymentBreakdown}"
                                      BorderThickness="0"
                                      MinHeight="100">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Method"
                                                        Binding="{Binding PaymentMethod}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Count"
                                                        Binding="{Binding Count}"
                                                        Width="55">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Total"
                                                        Binding="{Binding Total, StringFormat='₱{0:N2}'}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="0,0,8,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="%"
                                                        Binding="{Binding Percentage, StringFormat='{}{0:N1}%'}"
                                                        Width="55">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="0,0,8,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="No transactions in this period."
                                       Foreground="#BDC3C7" FontSize="11" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PaymentBreakdown.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Right: Top 5 Products -->
                    <Border Grid.Column="2"
                            Background="White" BorderBrush="#DDE1E7" BorderThickness="1"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="TOP 5 SELLING PRODUCTS" Style="{StaticResource SectionHeader}"/>
                            <DataGrid Style="{StaticResource ReadOnlyGrid}"
                                      ItemsSource="{Binding TopProducts}"
                                      BorderThickness="0"
                                      MinHeight="100">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Product"
                                                        Binding="{Binding ProductName}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Qty Sold"
                                                        Binding="{Binding QuantitySold}"
                                                        Width="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Revenue"
                                                        Binding="{Binding TotalRevenue, StringFormat='₱{0:N2}'}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="0,0,8,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="No sales data in this period."
                                       Foreground="#BDC3C7" FontSize="11" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopProducts.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Daily Trend Chart (weekly / monthly only) ──────────────── -->
                <Border Visibility="{Binding IsTrendVisible, Converter={StaticResource BoolToVis}}"
                        Background="White" BorderBrush="#DDE1E7" BorderThickness="1"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="DAILY SALES TREND" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="No data to display."
                                   Foreground="#BDC3C7" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TrendBars.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Height="140">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TrendBars.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl ItemsSource="{Binding TrendBars}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel MinWidth="20" Margin="1,0"
                                                    ToolTip="{Binding TooltipText}"
                                                    VerticalAlignment="Stretch">
                                            <!-- Bar area: fixed 110px, bar anchored to bottom -->
                                            <Grid Height="110">
                                                <Rectangle VerticalAlignment="Bottom"
                                                           HorizontalAlignment="Center"
                                                           Width="16"
                                                           Height="{Binding BarHeight}"
                                                           Fill="#2980B9"
                                                           RadiusX="2" RadiusY="2"/>
                                            </Grid>
                                            <!-- Label below bar -->
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="8"
                                                       Foreground="#7F8C8D"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Margin="0,2,0,0"
                                                       MaxWidth="30"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- Row 2 — Status bar                                                      -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DDE1E7"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <TextBlock FontSize="12" VerticalAlignment="Center"
                       Text="{Binding StatusMessage}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#27AE60"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusSuccess}" Value="False">
                                <Setter Property="Foreground" Value="#E74C3C"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

    </Grid>
</UserControl>
