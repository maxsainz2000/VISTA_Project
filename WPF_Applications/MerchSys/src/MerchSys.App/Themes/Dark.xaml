<!-- 
    VISTA Design Tokens — Dark Palette
    Note: The UX-00 token contract is authoritative and keys must stay in parity with Light.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Card Shadow Color (Plain Color, required by CardShadow effect) -->
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Structural Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SurfaceBrush"          Color="#2C2C2E"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#232325"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2C2C2E"/>

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush"      Color="#F5F5F7"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"    Color="#98989D"/>
    <SolidColorBrush x:Key="TextOnAccentBrush"     Color="#FFFFFF"/>

    <!-- Accent Brushes -->
    <SolidColorBrush x:Key="AccentBrush"           Color="#0A84FF"/>
    <SolidColorBrush x:Key="AccentHoverBrush"      Color="#3D9BFF"/>

    <!-- Separators & Borders -->
    <SolidColorBrush x:Key="SeparatorBrush"        Color="#38383A"/>

    <!-- Interaction overlay — subtle light ink for hover states (theme-specific) -->
    <SolidColorBrush x:Key="HoverBackgroundBrush"  Color="#FFFFFF" Opacity="0.08"/>

    <!-- Selection/Navigation Brushes (28% alpha on Accent Color #0A84FF) -->
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#470A84FF"/>
    <SolidColorBrush x:Key="SelectionForegroundBrush" Color="#F5F5F7"/>

    <!-- Semantic Status Brushes -->
    <SolidColorBrush x:Key="DangerBrush"           Color="#FF453A"/>
    <SolidColorBrush x:Key="WarningBrush"          Color="#FFB340"/>
    <SolidColorBrush x:Key="SuccessBrush"          Color="#30D158"/>

    <!-- Skeleton Loaders (UX-26) -->
    <SolidColorBrush x:Key="SkeletonBaseBrush"           Color="#2A2A2C"/>
    <Color x:Key="SkeletonShimmerHighlightColor">#3A3A3C</Color>

    <!-- Login scene scrim (UX-48) — dims the panorama slightly so the dark card holds contrast -->
    <SolidColorBrush x:Key="LoginSceneScrimBrush"        Color="#000000" Opacity="0.12"/>

</ResourceDictionary>
