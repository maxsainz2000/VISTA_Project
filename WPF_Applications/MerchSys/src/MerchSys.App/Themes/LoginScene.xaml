<!--
    VISTA Login Scene Palette (UX-50 — painterly raster hero)
    Static fills for the login backdrop + the tindera avatar ("Aling Vi").
    Theme-independent (identical in Light and Dark; the Dark theme applies LoginSceneScrimBrush).
    Merged ONLY by Views/Login/DynamicSceneCanvas.xaml, Views/Login/TinderaAvatar.xaml and
    Views/LoginView.xaml - never into App resources.

    NOTE: the UX-48/49 procedural-scene mood palette (Scene{Dusk|Evening|LateNight}{Element}Color)
    and the vector-scene brushes (sky/star/moon/bulb/cloud/town/facade/awning/pavement/tricycle/
    cat/plant/sheen/sign, etc.) were removed in UX-50 when the hand-drawn scene was replaced by the
    raster hero. What remains: the hero glow + time-of-day grade, the sleep-dim overlay, and the
    avatar palette.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- UX-50 painterly hero — warm glow registered to the storefront's lit window/bulbs.
         Flicker / entrance fade-in / success pulse animate the Ellipse opacity, not the brush. -->
    <RadialGradientBrush x:Key="LoginHeroGlowBrush">
        <GradientStop Color="#7AFFC882" Offset="0.0"/>
        <GradientStop Color="#3CFFB257" Offset="0.55"/>
        <GradientStop Color="#00FFB257" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- UX-50 time-of-day grade — deep indigo; the Rectangle's opacity animates per mood
         (Dusk 0 / Evening / LateNight) to darken+cool the whole hero. The warm glows sit ABOVE
         this overlay (in HeroLayer) so the storefront stays lit and pops in the darker moods. -->
    <LinearGradientBrush x:Key="LoginHeroGradeBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#05070F" Offset="0.0"/>
        <GradientStop Color="#0B1024" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Sleep dim overlay (DimOverlay opacity 0 → 0.10 while the avatar sleeps) -->
    <SolidColorBrush x:Key="SceneDimBrush" Color="#000000"/>

    <!-- ── Tindera avatar ("Aling Vi") + badge chrome ──────────────────────── -->
    <Color x:Key="AvatarBadgeRingTopColor">#FFC868</Color>
    <Color x:Key="AvatarBadgeRingBottomColor">#C9697E</Color>
    <Color x:Key="AvatarBadgeFillTopColor">#5C4A66</Color>
    <Color x:Key="AvatarBadgeFillBottomColor">#382F48</Color>

    <SolidColorBrush x:Key="AvatarBadgeInnerRingBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AvatarSkinBrush" Color="#C68E6A"/>
    <SolidColorBrush x:Key="AvatarSkinShadowBrush" Color="#A6714C"/>
    <SolidColorBrush x:Key="AvatarBlushBrush" Color="#E89578"/>
    <SolidColorBrush x:Key="AvatarHairBrush" Color="#2A2030"/>
    <SolidColorBrush x:Key="AvatarHairShineBrush" Color="#4E3E58"/>
    <SolidColorBrush x:Key="AvatarSampaguitaBrush" Color="#F4EFE6"/>
    <SolidColorBrush x:Key="AvatarEarringBrush" Color="#E8B84A"/>
    <SolidColorBrush x:Key="AvatarBlouseBrush" Color="#F2E6D0"/>
    <SolidColorBrush x:Key="AvatarApronBrush" Color="#3E6B4F"/>
    <SolidColorBrush x:Key="AvatarApronGridBrush" Color="#5C8A6A"/>
    <SolidColorBrush x:Key="AvatarPanueloBrush" Color="#C96F5A"/>
    <SolidColorBrush x:Key="AvatarPanueloCheckBrush" Color="#E8A07E"/>
    <SolidColorBrush x:Key="AvatarEyeWhiteBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AvatarIrisBrush" Color="#38271C"/>
    <SolidColorBrush x:Key="AvatarCatchlightBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AvatarBrowBrush" Color="#42301F"/>
    <SolidColorBrush x:Key="AvatarLidBrush" Color="#C68E6A"/>
    <SolidColorBrush x:Key="AvatarMouthBrush" Color="#8A4A48"/>
    <SolidColorBrush x:Key="AvatarMouthFillBrush" Color="#743A40"/>
    <SolidColorBrush x:Key="AvatarZzzBrush" Color="#8A93A0"/>

</ResourceDictionary>
