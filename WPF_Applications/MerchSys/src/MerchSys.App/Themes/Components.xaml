<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:MerchSys.App.Helpers">

    <!-- ========================================== -->
    <!-- BUTTONS                                    -->
    <!-- ========================================== -->

    <!-- PrimaryButtonStyle: alias for AccentButtonStyle -->
    <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AccentButtonStyle}"/>

    <!-- SuccessButtonStyle (Green) -->
    <Style x:Key="SuccessButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>

    <!-- DangerButtonStyle (Red) -->
    <Style x:Key="DangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>

    <!-- WarningButtonStyle (Orange) -->
    <Style x:Key="WarningButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
    </Style>

    <!-- SecondaryButtonStyle (Outline Neutral) -->
    <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- SubtleButtonStyle (Transparent) -->
    <Style x:Key="SubtleButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- CleanButtonStyle: invisible wrapper for making cards / containers clickable.
         Removes all chrome (background, border, padding, margin) so the child
         content renders exactly as designed. Hand cursor signals interactivity. -->
    <Style x:Key="CleanButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!-- SEGMENTED TOGGLE                          -->
    <!-- ========================================== -->

    <!-- SegmentToggleStyle (Pill in a row) -->
    <Style x:Key="SegmentToggleStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Border Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                SnapsToDevicePixels="True"/>
                        <Border Name="HoverOverlay"
                                Background="{DynamicResource HoverBackgroundBrush}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Opacity="0"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True"/>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                           <Setter TargetName="HoverOverlay" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================== -->
    <!-- CARDS & CONTAINERS                         -->
    <!-- ========================================== -->

    <!-- CardStyle -->
    <Style x:Key="CardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
        <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
    </Style>

    <!-- AlertCardStyle (card + left rule) -->
    <Style x:Key="AlertCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <!-- PrimaryMetricCardStyle -->
    <Style x:Key="PrimaryMetricCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource CardStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Padding" Value="{DynamicResource SpacingXL}"/>
    </Style>

    <!-- SecondaryMetricCardStyle -->
    <Style x:Key="SecondaryMetricCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="{DynamicResource SpacingL}"/>
    </Style>

    <!-- TertiaryMetricStyle -->
    <Style x:Key="TertiaryMetricStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
    </Style>

    <!-- ========================================== -->
    <!-- FILTER BAR                                 -->
    <!-- ========================================== -->

    <!-- FilterBarStyle: A toolbar surface whose children wrap on narrow windows. -->
    <Style x:Key="FilterBarStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <!-- FilterBarItemStyle: A WrapPanel item style for consistent inter-control spacing inside the bar. -->
    <Style x:Key="FilterBarItemStyle" TargetType="{x:Type FrameworkElement}">
        <Setter Property="Margin" Value="0,0,12,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ========================================== -->
    <!-- TYPOGRAPHY / LABELS                        -->
    <!-- ========================================== -->

    <!-- SectionHeaderStyle -->
    <Style x:Key="SectionHeaderStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- PageTitleStyle -->
    <Style x:Key="PageTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- SubtitleStyle -->
    <Style x:Key="SubtitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSubhead}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- CaptionLabelStyle -->
    <Style x:Key="CaptionLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- FieldLabelStyle -->
    <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- MetricValueStyle -->
    <Style x:Key="MetricValueStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSubhead}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- MetricValueLargeStyle -->
    <Style x:Key="MetricValueLargeStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLargeTitle}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- PrimaryMetricValueStyle -->
    <Style x:Key="PrimaryMetricValueStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MetricValueLargeStyle}"/>

    <!-- SecondaryMetricValueStyle -->
    <Style x:Key="SecondaryMetricValueStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- MetricCaptionStyle -->
    <Style x:Key="MetricCaptionStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CaptionLabelStyle}"/>

    <!-- ========================================== -->
    <!-- DATAGRID HELPERS                           -->
    <!-- ========================================== -->

    <!-- SemanticRowStyle (base style for DataGridRow) -->
    <Style x:Key="SemanticRowStyle" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}"/>

    <!-- NumericCellStyle (right-aligned cell) -->
    <Style x:Key="NumericCellStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0,0,8,0"/>
    </Style>

    <!-- ========================================== -->
    <!-- VALIDATION ERROR TEMPLATE                  -->
    <!-- ========================================== -->

    <!-- ValidationErrorTemplate -->
    <ControlTemplate x:Key="ValidationErrorTemplate">
        <DockPanel>
            <Border BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1.5" CornerRadius="{DynamicResource RadiusSmall}" SnapsToDevicePixels="True">
                <AdornedElementPlaceholder x:Name="controlWithError"/>
            </Border>
        </DockPanel>
    </ControlTemplate>

    <!-- Implicit TextBox validation styling -->
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ValidationErrorTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Implicit ComboBox validation styling -->
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ValidationErrorTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- FieldRowStyle for HeaderedContentControl (Label + Input + Inline Error) -->
    <Style x:Key="FieldRowStyle" TargetType="{x:Type HeaderedContentControl}">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type HeaderedContentControl}">
                    <StackPanel>
                        <!-- Label and required marker row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Label Content="{TemplateBinding Header}"
                                   Target="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Padding="0"
                                   VerticalAlignment="Center"
                                   IsTabStop="False"/>
                            <TextBlock Text=" *"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       x:Name="RequiredAsterisk"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Input Slot (The TextBox, ComboBox, etc.) -->
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>

                        <!-- Fixed-height error panel (18px) to prevent layout jumping -->
                        <Grid Height="18" Margin="0,2,0,0">
                            <TextBlock x:Name="InlineErrorText"
                                       Text="{Binding Content.(Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       VerticalAlignment="Top"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!-- Show asterisk if IsRequired is True -->
                        <Trigger Property="helpers:FormHelper.IsRequired" Value="True">
                            <Setter TargetName="RequiredAsterisk" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- Show error message if child has validation errors -->
                        <DataTrigger Binding="{Binding Content.(Validation.HasError), RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <Setter TargetName="InlineErrorText" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
