{
  "ConnectionStrings": {
    "MerchSysCentral": "Server=localhost;Port=3306;Database=merchsys_central;User Id=root;Password=;ConnectionTimeout=5;DefaultCommandTimeout=10;"
  },
  "Connection": {
    "HealthCheckIntervalSeconds": 15,
    "RetryBackoffSeconds": [
      2,
      4,
      8,
      16,
      32
    ],
    "MaxRetries": 5
  },
  "Client": {
    "WorkstationName": "Dev-Laptop"
  },
  "Session": {
    "IdleTimeoutMinutes": 20,
    "WarningLeadSeconds": 60
  },
  "Bir": {
    "RetentionYears": 10,
    "HashAlgorithm": "SHA-256-v1",
    "ArchivePolicy": {
      "GraceDays": 90
    }
  },
  "Receipts": {
    "Archival": {
      "Enabled": true,
      "IntervalHours": 24,
      "BatchSize": 500
    }
  },
  "POS": {
    "Receipt": {
      "Renderer": "Pdf",
      "Pdf": {
        "OutputDirectory": "%LOCALAPPDATA%\\MerchSys\\Receipts",
        "FileNamePattern": "OR-{ReceiptNumber}-{YYYYMMDD}.pdf",
        "FontFamily": "Consolas",
        "FontSizePt": 9
      }
    }
  },
  "Accounting": {
    "TamperReport": {
      "Export": {
        "DefaultDirectory": "%LOCALAPPDATA%\\MerchSys\\TamperReports",
        "CsvFileNamePattern": "TamperReport-{YYYYMMDD-HHmm}.csv",
        "PdfFileNamePattern": "TamperReport-{YYYYMMDD-HHmm}.pdf",
        "PdfFontFamily": "Consolas",
        "PdfFontSizePt": 9
      }
    }
  }
}