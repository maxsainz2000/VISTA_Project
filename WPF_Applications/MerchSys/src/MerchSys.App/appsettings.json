{
  "Sync": {
    "CentralServerHost": "192.168.1.10",
    "CentralServerPort": 3306,
    "ProbeIntervalSeconds": 30,
    "ProbeTimeoutMs": 2000,
    "MaxAttempts": 5,
    "BatchSize": 100
  },
  "Bir": {
    "RetentionYears": 10,
    "HashAlgorithm": "SHA-256-v1",
    "ArchivePolicy": {
      "GraceDays": 90
    }
  },
  "Receipts": {
    "Archival": {
      "Enabled": true,
      "IntervalHours": 24,
      "BatchSize": 500
    }
  }
}
