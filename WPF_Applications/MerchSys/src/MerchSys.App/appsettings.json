{
  "Session": {
    "IdleTimeoutMinutes": 20,
    "WarningLeadSeconds": 60
  },
  "Sync": {
    "CentralServerHost": "192.168.1.10",
    "CentralServerPort": 3306,
    "ProbeIntervalSeconds": 30,
    "ProbeTimeoutMs": 2000,
    "MaxAttempts": 5,
    "BatchSize": 100
  },
  "Bir": {
    "RetentionYears": 10,
    "HashAlgorithm": "SHA-256-v1",
    "ArchivePolicy": {
      "GraceDays": 90
    }
  },
  "Receipts": {
    "Archival": {
      "Enabled": true,
      "IntervalHours": 24,
      "BatchSize": 500
    }
  },
  "POS": {
    "Receipt": {
      "Renderer": "Console",
      "Pdf": {
        "OutputDirectory": "%LOCALAPPDATA%\\MerchSys\\Receipts",
        "FileNamePattern": "OR-{ReceiptNumber}-{YYYYMMDD}.pdf",
        "FontFamily": "Consolas",
        "FontSizePt": 9
      }
    }
  },
  "Accounting": {
    "TamperReport": {
      "Export": {
        "DefaultDirectory": "%LOCALAPPDATA%\\MerchSys\\TamperReports",
        "CsvFileNamePattern": "TamperReport-{YYYYMMDD-HHmm}.csv",
        "PdfFileNamePattern": "TamperReport-{YYYYMMDD-HHmm}.pdf",
        "PdfFontFamily": "Consolas",
        "PdfFontSizePt": 9
      }
    }
  }
}
