<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================== -->
    <!-- ICON GEOMETRY LIBRARY (UX-07)                                  -->
    <!--                                                                -->
    <!-- Hand-drawn monoline vector glyphs on a shared 24x24 viewbox.   -->
    <!-- Filled paths (no stroke); consumed by a Path whose Fill        -->
    <!-- resolves to a brush TOKEN via DynamicResource, so every icon   -->
    <!-- recolors live on the light/dark toggle. No icon-font, no       -->
    <!-- NuGet dependency. Original path data — not copied.             -->
    <!--                                                                -->
    <!-- Fill-rule prefixes: F0 = EvenOdd (carves holes), F1 = Nonzero  -->
    <!-- (unions overlapping subpaths). Single-subpath glyphs omit it.  -->
    <!-- ============================================================== -->

    <!-- Refresh — circular arrow with a gap + arrowhead (Nonzero union) -->
    <Geometry x:Key="IconRefreshGeometry">F1 M12,4 A8,8 0 1 0 19.25,8.62 L16.53,9.89 A5,5 0 1 1 12,7 Z M8,4 L12,1.5 L12,6.5 Z</Geometry>

    <!-- Bolt — lightning, generate/run -->
    <Geometry x:Key="IconBoltGeometry">M13,2 L4,14 L11,14 L9,22 L20,9 L13,9 Z</Geometry>

    <!-- Check — accept / OK status -->
    <Geometry x:Key="IconCheckGeometry">M9.6,18.4 L3.2,12 L5.6,9.6 L9.6,13.6 L18.4,4.8 L20.8,7.2 Z</Geometry>

    <!-- X-mark — dismiss / remove / close -->
    <Geometry x:Key="IconXMarkGeometry">M6.4,4.8 L12,10.4 L17.6,4.8 L19.2,6.4 L13.6,12 L19.2,17.6 L17.6,19.2 L12,13.6 L6.4,19.2 L4.8,17.6 L10.4,12 L4.8,6.4 Z</Geometry>

    <!-- Star — priority / seasonal flag -->
    <Geometry x:Key="IconStarGeometry">M12,3 L14.12,9.09 L20.56,9.22 L15.42,13.11 L17.29,19.28 L12,15.6 L6.71,19.28 L8.58,13.11 L3.44,9.22 L9.88,9.09 Z</Geometry>

    <!-- Warning — triangle with cut-out exclamation (EvenOdd holes) -->
    <Geometry x:Key="IconWarningGeometry">F0 M12,3 L22,20 L2,20 Z M11,9 L13,9 L12.7,15 L11.3,15 Z M11,16.8 L13,16.8 L13,18.8 L11,18.8 Z</Geometry>

    <!-- Filled circle — blocked status dot -->
    <Geometry x:Key="IconCircleFillGeometry">M5,12 A7,7 0 1 1 19,12 A7,7 0 1 1 5,12 Z</Geometry>

    <!-- Lightbulb — insight callout -->
    <Geometry x:Key="IconLightbulbGeometry">F0 M12,2.5 A6.5,6.5 0 0 0 8,14 L8,16 L16,16 L16,14 A6.5,6.5 0 0 0 12,2.5 Z M9,17.4 L15,17.4 L15,18.9 L9,18.9 Z M10.2,20.2 L13.8,20.2 L12.9,21.7 L11.1,21.7 Z</Geometry>

    <!-- Clipboard — form / report header -->
    <Geometry x:Key="IconClipboardGeometry">M6,5 L18,5 L18,21 L6,21 Z M9.5,2.5 L14.5,2.5 L14.5,5 L9.5,5 Z</Geometry>

    <!-- Box / package — Purchasing tile (EvenOdd seams) -->
    <Geometry x:Key="IconBoxGeometry">F0 M4,5 L20,5 L20,20 L4,20 Z M11.3,5 L12.7,5 L12.7,20 L11.3,20 Z M4,11.3 L20,11.3 L20,12.7 L4,12.7 Z</Geometry>

    <!-- Bar chart — Inventory tile -->
    <Geometry x:Key="IconChartBarGeometry">M3,20 L21,20 L21,21.5 L3,21.5 Z M4,18.5 L8,18.5 L8,11 L4,11 Z M10,18.5 L14,18.5 L14,5 L10,5 Z M16,18.5 L20,18.5 L20,14 L16,14 Z</Geometry>

    <!-- Cash — banknote with hollow centre (EvenOdd hole), Sales/Cash -->
    <Geometry x:Key="IconCashGeometry">F0 M3,7 L21,7 L21,17 L3,17 Z M9,12 A3,3 0 1 1 15,12 A3,3 0 1 1 9,12 Z</Geometry>

    <!-- Line chart — Accounting tile (L-axis + up-trend line) -->
    <Geometry x:Key="IconChartLineGeometry">M4,3 L5.5,3 L5.5,18.5 L21,18.5 L21,20 L4,20 Z M6,14.8 L10,10.8 L14,12.8 L19.3,5.7 L20.7,6.9 L14,15 L10,13 L6.7,16.1 Z</Geometry>

    <!-- Phone — GCash pay method (EvenOdd speaker + home holes) -->
    <Geometry x:Key="IconPhoneGeometry">F0 M7,2 L17,2 A1.5,1.5 0 0 1 18.5,3.5 L18.5,20.5 A1.5,1.5 0 0 1 17,22 L7,22 A1.5,1.5 0 0 1 5.5,20.5 L5.5,3.5 A1.5,1.5 0 0 1 7,2 Z M10,4 L14,4 L14,5 L10,5 Z M10.5,19 L13.5,19 L13.5,20 L10.5,20 Z</Geometry>

    <!-- Bank — Bank pay method (roof + columns + base) -->
    <Geometry x:Key="IconBankGeometry">M12,3 L21,8 L21,9.5 L3,9.5 L3,8 Z M5,10.5 L7,10.5 L7,18 L5,18 Z M9,10.5 L11,10.5 L11,18 L9,18 Z M13,10.5 L15,10.5 L15,18 L13,18 Z M17,10.5 L19,10.5 L19,18 L17,18 Z M3,19 L21,19 L21,21 L3,21 Z</Geometry>

    <!-- Eye — password reveal (EvenOdd: almond ring + filled pupil) -->
    <Geometry x:Key="IconEyeGeometry">F0 M2,12 C5,6 19,6 22,12 C19,18 5,18 2,12 Z M4.5,12 C7,8 17,8 19.5,12 C17,16 7,16 4.5,12 Z M12,9 A3,3 0 1 1 11.99,9 Z</Geometry>

    <!-- Eye-off — struck-through eye. LoginView swaps to this via a DataTrigger
         when the password is revealed (two-state eye / eye-off reveal button). -->
    <Geometry x:Key="IconEyeOffGeometry">F0 M2,12 C5,6 19,6 22,12 C19,18 5,18 2,12 Z M4.5,12 C7,8 17,8 19.5,12 C17,16 7,16 4.5,12 Z M12,9 A3,3 0 1 1 11.99,9 Z M4,3.5 L5.5,2 L21,17.5 L19.5,19 Z</Geometry>

    <!-- Open folder — empty-state art (Nonzero union of back + front flap) -->
    <Geometry x:Key="IconFolderOpenGeometry">F1 M2,6 A2,2 0 0 1 4,4 L9,4 L11,6.5 L20,6.5 A2,2 0 0 1 22,8.5 L22,10 L2,10 Z M2,11 L22,11 L19.5,19.5 A1.5,1.5 0 0 1 18,20.5 L3.5,20.5 A1.5,1.5 0 0 1 2,19 Z</Geometry>



    <!-- Arrow up — period-over-period positive direction indicator -->
    <Geometry x:Key="IconArrowUpGeometry">M12,3 L21,12 L16,12 L16,21 L8,21 L8,12 L3,12 Z</Geometry>

    <!-- Arrow down — period-over-period negative direction indicator -->
    <Geometry x:Key="IconArrowDownGeometry">M12,21 L3,12 L8,12 L8,3 L16,3 L16,12 L21,12 Z</Geometry>

    <!-- ============================================================== -->
    <!-- BASE PRESENTATION STYLE                                        -->
    <!--                                                                -->
    <!-- A Path that scales its geometry uniformly into a 16x16 box and -->
    <!-- fills to TextPrimary by default. Consumers override Fill with  -->
    <!-- a semantic token (Warning/Danger/Success/Accent) or bind it to -->
    <!-- the host button's Foreground for inline action-button icons.   -->
    <!-- ============================================================== -->
    <Style x:Key="IconBase" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

</ResourceDictionary>
