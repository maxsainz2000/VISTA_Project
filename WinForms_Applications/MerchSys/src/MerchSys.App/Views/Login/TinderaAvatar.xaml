<UserControl x:Class="Views.Login.TinderaAvatar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsHitTestVisible="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/LoginScene.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Aling Vi the tindera (UX-49), in a macOS-style circular badge. Same architecture as
         the UX-48 carabao it replaces: pose states are VSM groups on AvatarRoot driven through
         VisualStateManager.GoToElementState (GoToState silently no-ops on a UserControl);
         idle loops (blink / breath / head-bob / zzz-float) are code-managed clocks so static
         mode runs zero animations. Code-driven transforms (gaze, caps-alert, bounce, blink)
         are SEPARATE transforms composed with the VSM-driven ones, so the two systems never
         fight over a property. Hands are VSM-only (defect D8 guard: flat illustration, big
         wide-set eyes WITH catchlights, zero skin shading). -->
    <Viewbox Stretch="Uniform">
        <Grid x:Name="AvatarRoot" Width="96" Height="96">

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="PoseStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{StaticResource MotionDurationStd}">
                            <VisualTransition.GeneratedEasingFunction>
                                <StaticResource ResourceKey="MotionEasing"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>

                    <VisualState x:Name="Idle"/>

                    <VisualState x:Name="Watching">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HeadPoseRotate" Storyboard.TargetProperty="Angle" To="1.5" Duration="0"/>
                        </Storyboard>
                    </VisualState>

                    <VisualState x:Name="Shy">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HandLTr" Storyboard.TargetProperty="Y" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="HandRTr" Storyboard.TargetProperty="Y" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="LidLScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="LidRScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="HeadPoseRotate" Storyboard.TargetProperty="Angle" To="2" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="MouthIdle" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0"/>
                        </Storyboard>
                    </VisualState>

                    <VisualState x:Name="Peeking">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HandLTr" Storyboard.TargetProperty="Y" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="HandRTr" Storyboard.TargetProperty="Y" To="13" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="HandRTr" Storyboard.TargetProperty="X" To="3" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="HandRRotate" Storyboard.TargetProperty="Angle" To="16" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="LidLScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="LidRScale" Storyboard.TargetProperty="ScaleY" To="0.15" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="PupilPoseR" Storyboard.TargetProperty="Y" To="-1" Duration="0"/>
                        </Storyboard>
                    </VisualState>

                    <VisualState x:Name="Thinking">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PupilPoseL" Storyboard.TargetProperty="X" To="-2" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="PupilPoseL" Storyboard.TargetProperty="Y" To="-2" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="PupilPoseR" Storyboard.TargetProperty="X" To="-2" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="PupilPoseR" Storyboard.TargetProperty="Y" To="-2" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="BrowPoseTr" Storyboard.TargetProperty="Y" To="-1.5" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="MouthIdle" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="MouthDash" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                        </Storyboard>
                    </VisualState>

                    <VisualState x:Name="Happy">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="EyesOpenGroup" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="HappyEyesGroup" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="MouthIdle" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="MouthHappy" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="HandLTr" Storyboard.TargetProperty="X" To="-10" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="HandLTr" Storyboard.TargetProperty="Y" To="-12" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="HandLRotate" Storyboard.TargetProperty="Angle" To="-20" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="HandRTr" Storyboard.TargetProperty="X" To="10" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="HandRTr" Storyboard.TargetProperty="Y" To="-12" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="HandRRotate" Storyboard.TargetProperty="Angle" To="20" Duration="0"/>
                        </Storyboard>
                    </VisualState>

                    <VisualState x:Name="Rejected">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="BrowLRotate" Storyboard.TargetProperty="Angle" To="12" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="BrowRRotate" Storyboard.TargetProperty="Angle" To="-12" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="LidLScale" Storyboard.TargetProperty="ScaleY" To="0.45" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="LidRScale" Storyboard.TargetProperty="ScaleY" To="0.45" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="MouthIdle" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="MouthSad" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="HeadPoseRotate" Storyboard.TargetProperty="Angle" To="2.5" Duration="0"/>
                        </Storyboard>
                    </VisualState>

                    <VisualState x:Name="Sleeping">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="LidLScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="LidRScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ZzzGroup" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="HeadPoseRotate" Storyboard.TargetProperty="Angle" To="4" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Badge: warm dusk ring + interior -->
            <Ellipse Width="96" Height="96">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="{StaticResource AvatarBadgeRingTopColor}" Offset="0"/>
                        <GradientStop Color="{StaticResource AvatarBadgeRingBottomColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="90" Height="90">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="{StaticResource AvatarBadgeFillTopColor}" Offset="0"/>
                        <GradientStop Color="{StaticResource AvatarBadgeFillBottomColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Clipped bust -->
            <Grid Width="86" Height="86">
                <Grid.Clip>
                    <EllipseGeometry Center="43,43" RadiusX="43" RadiusY="43"/>
                </Grid.Clip>
                <Viewbox RenderTransformOrigin="0.5,0.9">
                    <Viewbox.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BreathScale"/>
                            <TranslateTransform x:Name="BounceTr"/>
                        </TransformGroup>
                    </Viewbox.RenderTransform>
                    <Canvas Width="120" Height="120">
                        <Canvas x:Name="BustGroup" Width="120" Height="120" RenderTransformOrigin="0.5,0.72">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="HeadPoseRotate"/>
                                    <RotateTransform x:Name="GazeHeadRotate"/>
                                    <RotateTransform x:Name="HeadBobRotate"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>

                            <!-- Blouse, apron, panuelo -->
                            <Path Fill="{StaticResource AvatarBlouseBrush}"
                                  Data="M14,120 C16,90 34,82 60,82 C86,82 104,90 106,120 Z"/>
                            <Rectangle Canvas.Left="42" Canvas.Top="90" Width="36" Height="30" RadiusX="4" RadiusY="4"
                                       Fill="{StaticResource AvatarApronBrush}"/>
                            <Path Stroke="{StaticResource AvatarApronBrush}" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M44,90 L36,83 M76,90 L84,83"/>
                            <Path Stroke="{StaticResource AvatarApronGridBrush}" StrokeThickness="1.2" Opacity="0.8"
                                  Data="M54,90 V120 M66,90 V120 M42,104 H78"/>
                            <Path Fill="{StaticResource AvatarPanueloBrush}"
                                  Data="M14,96 Q22,78 40,80 L36,104 Q24,106 14,96 Z"/>
                            <Path Stroke="{StaticResource AvatarPanueloCheckBrush}" StrokeThickness="1" Opacity="0.8"
                                  Data="M20,86 L32,98 M18,94 L28,102"/>

                            <!-- Neck, bun (behind head), head, ears -->
                            <Rectangle Canvas.Left="52" Canvas.Top="68" Width="16" Height="18"
                                       Fill="{StaticResource AvatarSkinBrush}"/>
                            <Ellipse Canvas.Left="82" Canvas.Top="32" Width="22" Height="22"
                                     Fill="{StaticResource AvatarHairBrush}"/>
                            <Ellipse Canvas.Left="31" Canvas.Top="46" Width="9" Height="13"
                                     Fill="{StaticResource AvatarSkinBrush}"/>
                            <Ellipse Canvas.Left="80" Canvas.Top="46" Width="9" Height="13"
                                     Fill="{StaticResource AvatarSkinBrush}"/>
                            <Ellipse Canvas.Left="36" Canvas.Top="25" Width="48" Height="54"
                                     Fill="{StaticResource AvatarSkinBrush}"/>
                            <Ellipse Canvas.Left="33" Canvas.Top="58" Width="8" Height="9"
                                     Stroke="{StaticResource AvatarEarringBrush}" StrokeThickness="1.8"/>
                            <Ellipse Canvas.Left="82" Canvas.Top="58" Width="8" Height="9"
                                     Stroke="{StaticResource AvatarEarringBrush}" StrokeThickness="1.8"/>

                            <!-- Eyes (whites + iris with catchlight + skin-tone lids) -->
                            <Canvas x:Name="EyesOpenGroup">
                                <Ellipse Canvas.Left="44" Canvas.Top="46" Width="13" Height="14" Fill="{StaticResource AvatarEyeWhiteBrush}"/>
                                <Ellipse Canvas.Left="63" Canvas.Top="46" Width="13" Height="14" Fill="{StaticResource AvatarEyeWhiteBrush}"/>
                                <Canvas>
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="GazePupilL"/>
                                            <TranslateTransform x:Name="PupilPoseL"/>
                                        </TransformGroup>
                                    </Canvas.RenderTransform>
                                    <Ellipse Canvas.Left="47" Canvas.Top="49.5" Width="7.5" Height="7.5" Fill="{StaticResource AvatarIrisBrush}"/>
                                    <Ellipse Canvas.Left="48.6" Canvas.Top="50.6" Width="2.2" Height="2.2" Fill="{StaticResource AvatarCatchlightBrush}"/>
                                </Canvas>
                                <Canvas>
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="GazePupilR"/>
                                            <TranslateTransform x:Name="PupilPoseR"/>
                                        </TransformGroup>
                                    </Canvas.RenderTransform>
                                    <Ellipse Canvas.Left="66" Canvas.Top="49.5" Width="7.5" Height="7.5" Fill="{StaticResource AvatarIrisBrush}"/>
                                    <Ellipse Canvas.Left="67.6" Canvas.Top="50.6" Width="2.2" Height="2.2" Fill="{StaticResource AvatarCatchlightBrush}"/>
                                </Canvas>
                                <Ellipse Canvas.Left="43" Canvas.Top="45" Width="15" Height="16"
                                         Fill="{StaticResource AvatarLidBrush}" RenderTransformOrigin="0.5,0">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="LidLScale" ScaleY="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Canvas.Left="62" Canvas.Top="45" Width="15" Height="16"
                                         Fill="{StaticResource AvatarLidBrush}" RenderTransformOrigin="0.5,0">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="LidRScale" ScaleY="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Canvas>

                            <!-- Happy arc eyes -->
                            <Canvas x:Name="HappyEyesGroup" Opacity="0">
                                <Path Stroke="{StaticResource AvatarBrowBrush}" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M44,55 Q50.5,47 57,55"/>
                                <Path Stroke="{StaticResource AvatarBrowBrush}" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M63,55 Q69.5,47 76,55"/>
                            </Canvas>

                            <!-- Brows: pose translate (VSM) + alert translate (code) -->
                            <Canvas x:Name="BrowGroup">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="BrowPoseTr"/>
                                        <TranslateTransform x:Name="BrowAlertTr"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                                <Rectangle Canvas.Left="44" Canvas.Top="44" Width="13" Height="3" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{StaticResource AvatarBrowBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform x:Name="BrowLRotate"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Canvas.Left="63" Canvas.Top="44" Width="13" Height="3" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{StaticResource AvatarBrowBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform x:Name="BrowRRotate"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>

                            <!-- Nose, blush, mouths -->
                            <Path Stroke="{StaticResource AvatarSkinShadowBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M59,58 Q61,61 59.5,63"/>
                            <Ellipse Canvas.Left="40" Canvas.Top="57" Width="9" Height="5"
                                     Fill="{StaticResource AvatarBlushBrush}" Opacity="0.35"/>
                            <Ellipse Canvas.Left="71" Canvas.Top="57" Width="9" Height="5"
                                     Fill="{StaticResource AvatarBlushBrush}" Opacity="0.35"/>
                            <Path x:Name="MouthIdle" Stroke="{StaticResource AvatarMouthBrush}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M53,69 Q60,73.5 67,69"/>
                            <Path x:Name="MouthHappy" Opacity="0" Fill="{StaticResource AvatarMouthFillBrush}"
                                  Data="M51,68 Q60,79 69,68 Q60,72 51,68 Z"/>
                            <Path x:Name="MouthSad" Opacity="0" Stroke="{StaticResource AvatarMouthBrush}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M53.5,72.5 Q60,68 66.5,72.5"/>
                            <Path x:Name="MouthDash" Opacity="0" Stroke="{StaticResource AvatarMouthBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M56,70.5 L64,70.5"/>

                            <!-- Front hair, shine, sampaguita at the bun -->
                            <Path Fill="{StaticResource AvatarHairBrush}"
                                  Data="M36,46 C34,24 44,14 60,14 C76,14 86,24 84,46 C82,32 74,25 64,25 C54,25 46,31 42,42 C40,44 38,45 36,46 Z"/>
                            <Path Stroke="{StaticResource AvatarHairShineBrush}" StrokeThickness="2.4" Opacity="0.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M46,22 Q58,16 70,20"/>
                            <Ellipse Canvas.Left="95" Canvas.Top="34" Width="4" Height="4" Fill="{StaticResource AvatarSampaguitaBrush}"/>
                            <Ellipse Canvas.Left="99" Canvas.Top="40" Width="4" Height="4" Fill="{StaticResource AvatarSampaguitaBrush}"/>
                            <Ellipse Canvas.Left="94" Canvas.Top="45" Width="4" Height="4" Fill="{StaticResource AvatarSampaguitaBrush}"/>

                            <!-- Hands (VSM-only; parked below the badge clip at Y=78) -->
                            <Canvas x:Name="HandLGroup">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="HandLRotate" CenterX="50.5" CenterY="54"/>
                                        <TranslateTransform x:Name="HandLTr" Y="78"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                                <Path Fill="{StaticResource AvatarSkinBrush}"
                                      Data="M42,52 Q42,44 50.5,44 Q59,44 59,52 L59,57 Q59,64 50.5,64 Q42,64 42,57 Z"/>
                                <Ellipse Canvas.Left="55.5" Canvas.Top="52" Width="6" Height="11"
                                         Fill="{StaticResource AvatarSkinBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="15"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Path Stroke="{StaticResource AvatarSkinShadowBrush}" StrokeThickness="1.2" Opacity="0.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M47,45.5 V52 M52,45.5 V52"/>
                            </Canvas>
                            <Canvas x:Name="HandRGroup">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="HandRRotate" CenterX="69.5" CenterY="54"/>
                                        <TranslateTransform x:Name="HandRTr" Y="78"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                                <Path Fill="{StaticResource AvatarSkinBrush}"
                                      Data="M61,52 Q61,44 69.5,44 Q78,44 78,52 L78,57 Q78,64 69.5,64 Q61,64 61,57 Z"/>
                                <Ellipse Canvas.Left="58.5" Canvas.Top="52" Width="6" Height="11"
                                         Fill="{StaticResource AvatarSkinBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-15"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Path Stroke="{StaticResource AvatarSkinShadowBrush}" StrokeThickness="1.2" Opacity="0.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M66,45.5 V52 M71,45.5 V52"/>
                            </Canvas>
                        </Canvas>
                    </Canvas>
                </Viewbox>
            </Grid>

            <!-- Inner light ring + theme-reactive outer ring -->
            <Ellipse Width="90" Height="90" Stroke="{StaticResource AvatarBadgeInnerRingBrush}"
                     StrokeThickness="2" Opacity="0.85"/>
            <Ellipse Width="96" Height="96" Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="3"/>

            <!-- Zzz (outside the clip so it floats above the badge) -->
            <Canvas x:Name="ZzzGroup" Width="96" Height="96" Opacity="0">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="ZzzFloatTr"/>
                </Canvas.RenderTransform>
                <TextBlock Canvas.Left="62" Canvas.Top="12" Text="z" FontFamily="{StaticResource AppFontFamily}"
                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AvatarZzzBrush}"/>
                <TextBlock Canvas.Left="72" Canvas.Top="5" Text="z" FontFamily="{StaticResource AppFontFamily}"
                           FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AvatarZzzBrush}"/>
                <TextBlock Canvas.Left="80" Canvas.Top="0" Text="z" FontFamily="{StaticResource AppFontFamily}"
                           FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource AvatarZzzBrush}"/>
            </Canvas>
        </Grid>
    </Viewbox>
</UserControl>
