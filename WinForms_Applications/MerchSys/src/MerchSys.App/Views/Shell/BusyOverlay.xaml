<UserControl x:Class="Views.Shell.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <!-- If IsBusy is true, show the overlay -->
                <DataTrigger Binding="{Binding IsBusy, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- But if IsBusy is true and LastLoadedAt is null, hide it (first load shows skeleton) -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsBusy, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding LastLoadedAt, RelativeSource={RelativeSource Self}}" Value="{x:Null}"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Spinner: Rotating Arc Path -->
            <Grid Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,16">
                <!-- Track -->
                <Ellipse Stroke="{DynamicResource SeparatorBrush}" StrokeThickness="4" Width="40" Height="40"/>
                <!-- Spinning arc -->
                <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="4" Width="40" Height="40"
                      Data="M 20,0 A 20,20 0 0 1 40,20" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="SpinnerTransform" Angle="0"/>
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SpinnerTransform"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:1"
                                                     RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
            </Grid>
            <!-- Loading Text -->
            <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextOnAccentBrush}" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
