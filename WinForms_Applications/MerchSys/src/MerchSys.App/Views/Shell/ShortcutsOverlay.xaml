<UserControl x:Class="Views.Shell.ShortcutsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="KeyChipBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="KeyChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ShortcutDescriptionText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <!-- Backdrop overlay covering the entire window -->
    <Grid Background="{DynamicResource OverlayBrush}" MouseDown="Background_MouseDown">

        <!-- Centered shortcuts panel -->
        <Border Width="680" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusLarge}"
                Effect="{StaticResource CardShadow}"
                MouseDown="OverlayPanel_MouseDown">

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header area -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Keyboard Shortcuts"
                                   FontSize="{DynamicResource FontSizeTitle}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Quick references to navigate and interact with VISTA."
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Close button -->
                    <Button Grid.Column="1"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource SubtleButtonStyle}" 
                            Width="32" Height="32"
                            VerticalAlignment="Top"
                            Focusable="False">
                        <Path Style="{StaticResource IconBase}"
                              Data="{StaticResource IconXMarkGeometry}"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Width="14" Height="14"/>
                    </Button>
                </Grid>

                <!-- Divider -->
                <Border Grid.Row="1" Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,0,0,20"/>

                <!-- Content Area: Two-column grid -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 0: Global Navigation -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Global Navigation" 
                                   FontSize="{DynamicResource FontSizeSubhead}" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource AccentBrush}" 
                                   Margin="0,0,0,16"/>

                        <!-- Ctrl+K -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="Ctrl" Style="{StaticResource KeyChipText}"/>
                                </Border>
                                <TextBlock Text="+" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0"/>
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="K" Style="{StaticResource KeyChipText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Open Command Palette" Style="{StaticResource ShortcutDescriptionText}"/>
                        </Grid>

                        <!-- Ctrl+1 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="Ctrl" Style="{StaticResource KeyChipText}"/>
                                </Border>
                                <TextBlock Text="+" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0"/>
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="1" Style="{StaticResource KeyChipText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Switch to Purchasing" Style="{StaticResource ShortcutDescriptionText}"/>
                        </Grid>

                        <!-- Ctrl+2 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="Ctrl" Style="{StaticResource KeyChipText}"/>
                                </Border>
                                <TextBlock Text="+" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0"/>
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="2" Style="{StaticResource KeyChipText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Switch to Inventory" Style="{StaticResource ShortcutDescriptionText}"/>
                        </Grid>

                        <!-- Ctrl+3 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="Ctrl" Style="{StaticResource KeyChipText}"/>
                                </Border>
                                <TextBlock Text="+" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0"/>
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="3" Style="{StaticResource KeyChipText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Switch to Point of Sale" Style="{StaticResource ShortcutDescriptionText}"/>
                        </Grid>

                        <!-- Ctrl+4 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="Ctrl" Style="{StaticResource KeyChipText}"/>
                                </Border>
                                <TextBlock Text="+" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0"/>
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="4" Style="{StaticResource KeyChipText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Switch to Accounting" Style="{StaticResource ShortcutDescriptionText}"/>
                        </Grid>

                        <!-- Ctrl+D0 (Gated Developer Tools) -->
                        <Grid Margin="0,0,0,12" Visibility="{Binding IsDeveloper, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="Ctrl" Style="{StaticResource KeyChipText}"/>
                                </Border>
                                <TextBlock Text="+" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0"/>
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="0" Style="{StaticResource KeyChipText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Switch to Developer Tools" Style="{StaticResource ShortcutDescriptionText}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Column 2: Dialog / Forms & Overlay Controls -->
                    <StackPanel Grid.Column="2">
                        <!-- Category: Forms & Dialogs -->
                        <TextBlock Text="Dialogs &amp; Forms" 
                                   FontSize="{DynamicResource FontSizeSubhead}" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource AccentBrush}" 
                                   Margin="0,0,0,16"/>

                        <!-- Enter -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="Enter" Style="{StaticResource KeyChipText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Confirm / Submit Dialog" Style="{StaticResource ShortcutDescriptionText}"/>
                        </Grid>

                        <!-- Esc -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="Esc" Style="{StaticResource KeyChipText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Close Overlay / Cancel Dialog" Style="{StaticResource ShortcutDescriptionText}"/>
                        </Grid>

                        <!-- Alt + Letter -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="Alt" Style="{StaticResource KeyChipText}"/>
                                </Border>
                                <TextBlock Text="+" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0"/>
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="Letter" Style="{StaticResource KeyChipText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Trigger Mnemonic Access Key" Style="{StaticResource ShortcutDescriptionText}"/>
                        </Grid>

                        <!-- Category: Confirmation Dialogs -->
                        <TextBlock Text="Confirmation Dialogs" 
                                   FontSize="{DynamicResource FontSizeSubhead}" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource AccentBrush}" 
                                   Margin="0,0,0,16"/>

                        <!-- Enter -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="Enter" Style="{StaticResource KeyChipText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Confirm action (when enabled)" Style="{StaticResource ShortcutDescriptionText}"/>
                        </Grid>

                        <!-- Esc -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="Esc" Style="{StaticResource KeyChipText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Cancel and close dialog" Style="{StaticResource ShortcutDescriptionText}"/>
                        </Grid>

                        <!-- Type Match -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="Type Match" Style="{StaticResource KeyChipText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Requires exact text match to enable confirmation for dangerous actions" Style="{StaticResource ShortcutDescriptionText}"/>
                        </Grid>

                        <!-- Category: Overlay Controls -->
                        <TextBlock Text="Cheat Sheet Controls" 
                                   FontSize="{DynamicResource FontSizeSubhead}" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource AccentBrush}" 
                                   Margin="0,0,0,16"/>

                        <!-- ? or Ctrl+/ -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="?" Style="{StaticResource KeyChipText}"/>
                                </Border>
                                <TextBlock Text=" or " Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="1,0"/>
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="Ctrl" Style="{StaticResource KeyChipText}"/>
                                </Border>
                                <TextBlock Text="+" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="1,0"/>
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="/" Style="{StaticResource KeyChipText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Toggle Cheat Sheet" Style="{StaticResource ShortcutDescriptionText}"/>
                        </Grid>

                        <!-- Esc -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyChipBorder}">
                                    <TextBlock Text="Esc" Style="{StaticResource KeyChipText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Dismiss Cheat Sheet" Style="{StaticResource ShortcutDescriptionText}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
