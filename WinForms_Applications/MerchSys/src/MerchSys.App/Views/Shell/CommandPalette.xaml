<UserControl x:Class="Views.Shell.CommandPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MerchSys.App.Views.Shell"
             xmlns:helpers="clr-namespace:MerchSys.App.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <CollectionViewSource x:Key="GroupedResults" Source="{Binding Results}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Section"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <!-- Backdrop overlay covering the entire window -->
    <Grid Background="{DynamicResource OverlayBrush}" MouseDown="Background_MouseDown">
        
        <!-- Centered search panel -->
        <Border Width="600" Height="420" VerticalAlignment="Top" Margin="0,100,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusLarge}"
                Effect="{StaticResource CardShadow}"
                MouseDown="SearchPanel_MouseDown"
                helpers:AccessibilityHelper.IsFocusTrap="True">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Search Box input area -->
                <Grid Grid.Row="0" Margin="12,12,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Path Grid.Column="0"
                          Style="{StaticResource IconBase}"
                          Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                          Fill="{DynamicResource TextSecondaryBrush}"
                          Width="18" Height="18"
                          Margin="4,0,12,0"
                          VerticalAlignment="Center"/>
                    
                    <TextBox Grid.Column="1"
                             x:Name="SearchTextBox"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="16"
                             CaretBrush="{DynamicResource AccentBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalAlignment="Center"
                             Padding="0"/>
                </Grid>

                <!-- Divider -->
                <Border Grid.Row="1" Background="{DynamicResource SeparatorBrush}"/>

                <!-- 2. Results ListBox area -->
                <Grid Grid.Row="2">
                    <!-- ListBox containing grouped items -->
                    <ListBox x:Name="ResultsListBox"
                             ItemsSource="{Binding Source={StaticResource GroupedResults}}"
                             SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                             SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Margin="4,4,4,4">
                        
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   FontWeight="Bold"
                                                   Margin="8,8,8,4"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Accent/selection-reactive icon path -->
                                    <Path Grid.Column="0"
                                          Style="{StaticResource IconBase}"
                                          Data="{Binding IconData}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          Width="14" Height="14"
                                          Margin="2,0,10,0"
                                          VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Opacity="0.8"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Busy overlay (only overlays results list) -->
                    <views:BusyOverlay Message="Searching catalog..."
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                       Background="Transparent"/>

                    <!-- Empty state panel -->
                    <views:EmptyStatePanel Title="No Results Found"
                                           Description="Try searching for a different screen name or product SKU."
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- 3. Bottom bar: search hints -->
                <Border Grid.Row="3" 
                        Background="{DynamicResource SidebarBackgroundBrush}"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,14,14"
                        Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="↑↓" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text=" to navigate" Margin="4,0,16,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}"/>
                            
                            <TextBlock Text="↵" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text=" to select" Margin="4,0,16,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}"/>
                            
                            <TextBlock Text="esc" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text=" to close" Margin="4,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeCaption}"/>
                        </StackPanel>
                        
                        <TextBlock Grid.Column="1"
                                   Text="VISTA Search"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Opacity="0.6"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
